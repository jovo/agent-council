#!/usr/bin/env python3
"""unified-review: a panel of models from different labs reviews a draft, then
votes on every finding. unified.md gives an overview, then the findings in the
order of the draft, each with its votes. An optional web fact-check runs in the
background and writes factcheck.md, also in draft order.

Usage: unified-review [-o OUTDIR] [-n FOCUS] [-p PANEL] [--context FILE]... [--verify] FILE [FILE...]
       unified-review --item 3,7,K2 [--run DIR]   print items to act on
       unified-review --ignore 5,7 [--note WHY]    record declined findings
       unified-review --applied 3                  record applied findings
       unified-review --unignore D2                lift a past decline
       unified-review --decisions                  list decisions for this folder
  -o OUTDIR  where to write output (default: <project>-<file>-v<N> under
             ~/.local/share/unified-review/runs, or $UNIFIED_REVIEW_RUNS)
  -n FOCUS   extra instructions appended to the reviewer prompt
  --context FILE  supporting material the panel reads but does not review
             (reviewer comments, a call, a source paper). Text or PDF. Repeatable.
  -p PANEL   comma-separated panel (default: claude,gpt,gemini).
             Known: claude, gpt, gemini, grok
  --verify   also fact-check the draft's claims with web search (background)

Foreground:
  1. review   each panelist reviews the draft, no web search
  2. vote     each panelist votes on every finding, reviewers anonymized
  3. render   this script groups duplicates, sets aside findings most voters
              reject, writes unified.md in draft order, and opens it.
Background (only with --verify; detached, started first):
  4. claims   the first panelist lists the draft's checkable claims
  5. verify   each panelist checks every claim with web search, using
              stronger models than the review (FACTCHECK_PANELISTS)
  6. merge    this script keeps the most cautious verdict per claim, writes
              factcheck.md in draft order, and opens it

Env overrides: CLAUDE_BIN, CODEX_BIN, CURSOR_BIN, CLAUDE_MD, UNIFIED_REVIEW_RULES,
UNIFIED_REVIEW_TIMEOUT (seconds per model call), UNIFIED_REVIEW_OPEN_APP
(app that opens the results, default: the default .md app), UNIFIED_REVIEW_PORT
(fixed port for the review page, default: any free port)
"""
import argparse
import contextlib
import difflib
import fcntl
import hashlib
import io
import json
import math
import os
import random
import re
import shlex
import shutil
import subprocess
import sys
import threading
import time
from concurrent.futures import ThreadPoolExecutor
from pathlib import Path

SEVERITIES = ["Critical", "Substantive", "Polish"]
VOTE_SCORE = {"agree": 1.0, "partial": 0.5, "disagree": 0.0}
VERDICTS = ["contradicted", "unverifiable", "plausible", "confirmed"]  # most cautious first
TIMEOUT = int(os.environ.get("UNIFIED_REVIEW_TIMEOUT", "900"))

CLAUDE = os.environ.get("CLAUDE_BIN") or shutil.which("claude")
# The ChatGPT app has shipped its Codex CLI at more than one path. Take the first that exists.
CODEX = (os.environ.get("CODEX_BIN") or shutil.which("codex")
         or next((c for c in ["/Applications/ChatGPT.app/Contents/Resources/codex-cli/bin/codex",
                              "/Applications/ChatGPT.app/Contents/Resources/codex"]
                  if os.access(c, os.X_OK)), "codex"))
CURSOR = os.environ.get("CURSOR_BIN") or shutil.which("cursor-agent")

# Panel name -> (harness, model passed to that harness, display label).
# Pick one model per lab: same-family judges share biases. Fast settings by
# default: Sonnet, GPT-5.6 Luna at low effort, Gemini Flash Low.
PANELISTS = {
    "claude": ("claude", "sonnet", "Claude Sonnet"),
    "gpt": ("codex", "gpt-5.6-luna", "GPT-5.6 Luna"),
    "gemini": ("cursor", "gemini-3.8-flash-low", "Gemini 3.8 Flash Low"),
    "grok": ("cursor", "grok-4.7-low-fast", "Grok 4.7 Low Fast"),
}
# Grok stands in when a panelist fails, so the panel keeps three voters and
# can break ties. It runs through cursor-agent, so it cannot stand in for Gemini
# when cursor-agent itself is down.
STANDIN = "grok"
# The fact-check runs in the background, so speed costs nothing there. Use the
# stronger models for Claude and GPT (each CLI's default). Gemini stays on
# Flash Low: Medium and High took 7-9 minutes here.
FACTCHECK_PANELISTS = {
    "claude": ("claude", None, "Claude"),
    "gpt": ("codex", None, "GPT (Codex default)"),
    "gemini": ("cursor", "gemini-3.8-flash-low", "Gemini 3.8 Flash Low"),
    "grok": ("cursor", "grok-4.7-high", "Grok 4.7 High"),
}
HARNESS_BIN = {"claude": CLAUDE, "codex": CODEX, "cursor": CURSOR}
# App that opens unified.md and factcheck.md when they are ready. Empty means:
# open where the tool was run from (see open_file).
OPEN_APP = os.environ.get("UNIFIED_REVIEW_OPEN_APP", "")
# macOS records the app that launched this process. Map it to how to open a file there.
EDITOR_COMMANDS = {
    "com.todesktop.230313mzl4w4u92": "cursor",  # Cursor
    "com.microsoft.VSCode": "code",
}
# Agent apps that cannot show a file opened from outside: their agent shows it instead.
AGENT_APPS = {"com.anthropic.claudefordesktop": "the Claude app", "com.openai.codex": "the Codex app"}


def open_file(path):
    """Open a result where the tool was run from: the editor it was run in (Cursor,
    VS Code), the default app from a terminal, or, inside an agent app that cannot
    open files from outside (Claude, Codex), print a line for its agent to act on."""
    run = lambda cmd: subprocess.run(cmd, stderr=subprocess.DEVNULL, env=CHILD_ENV).returncode == 0
    if sys.platform != "darwin":  # Linux, e.g. a codespace: its editor, else xdg-open, else print
        if os.environ.get("CODESPACES") and shutil.which("code") and run(["code", str(path)]):
            return
        if not (shutil.which("xdg-open") and run(["xdg-open", str(path)])):
            print(f"Result: {path}", flush=True)
        return
    if OPEN_APP and run(["open", "-a", OPEN_APP, str(path)]):
        return
    app = os.environ.get("__CFBundleIdentifier", "")
    if app in AGENT_APPS:
        print(f"OPEN IN APP: {path}", flush=True)
        log(f"open {path} in {AGENT_APPS[app]}")
        return
    cmd = EDITOR_COMMANDS.get(app)
    if cmd and shutil.which(cmd) and run([cmd, str(path)]):
        return
    if app in EDITOR_COMMANDS and run(["open", "-b", app, str(path)]):
        return
    run(["open", str(path)])

# When launched from inside Claude Code, Codex, or Cursor, the parent agent's
# session variables leak into the child CLIs and break their auth. Drop them.
LEAKY = re.compile(r"^(CLAUDECODE|CLAUDE_CODE_|CLAUDE_AGENT_SDK_|CODEX_SANDBOX|CURSOR_AGENT)")
CHILD_ENV = {k: v for k, v in os.environ.items() if not LEAKY.match(k)}
# Outside Claude Code, CLAUDE_CODE_OAUTH_TOKEN is the user's own login token (from
# `claude setup-token`, e.g. a Codespaces secret), so keep it.
if "CLAUDECODE" not in os.environ and os.environ.get("CLAUDE_CODE_OAUTH_TOKEN"):
    CHILD_ENV["CLAUDE_CODE_OAUTH_TOKEN"] = os.environ["CLAUDE_CODE_OAUTH_TOKEN"]


def log(msg):
    print(msg, file=sys.stderr, flush=True)


EFFORT = {}  # Codex reasoning effort per panelist; "low" when not given
CLAUDE_MODELS = {"sonnet": "Sonnet", "opus": "Opus", "fable": "Fable", "haiku": "Haiku"}
CODEX_MODELS = {"gpt-5.6-luna": "GPT-5.6 Luna", "gpt-5.6-sol": "GPT-5.6 Sol"}


def panelist(spec):
    """Register a panelist given as harness:model[@effort] (claude:opus,
    codex:gpt-5.6-luna@medium, cursor:kimi-k3-low) and return its key. Short
    names already in PANELISTS (claude, gpt, gemini, grok) pass through."""
    spec = spec.strip()
    if spec in PANELISTS:
        return spec
    harness, _, model = spec.partition(":")
    if harness not in HARNESS_BIN or not model:
        raise ValueError(f"unknown panelist {spec!r}: use a short name ({', '.join(PANELISTS)}) or harness:model")
    model, _, effort = model.partition("@")
    if harness == "claude":
        name = "Claude " + CLAUDE_MODELS.get(model, model)
    elif harness == "codex":
        name = CODEX_MODELS.get(model, model) + (f" {effort}" if effort else " low")
        EFFORT[spec] = effort or "low"
    else:
        name = cursor_models().get(model, model)
    PANELISTS[spec] = (harness, model, name)
    return spec


_CURSOR_MODELS = None


def cursor_models():
    """{id: display name} of the models cursor-agent offers, cached."""
    global _CURSOR_MODELS
    if _CURSOR_MODELS is None:
        _CURSOR_MODELS = {}
        try:
            out = subprocess.run([CURSOR, "models"], capture_output=True, text=True, timeout=30,
                                 stdin=subprocess.DEVNULL, env=CHILD_ENV).stdout if CURSOR else ""
        except (OSError, subprocess.SubprocessError):
            out = ""
        for line in out.splitlines():
            mid, sep, name = line.strip().partition(" - ")
            if sep and mid and " " not in mid:
                _CURSOR_MODELS[mid] = re.sub(r"[\u200b\s]+", " ", name).strip()
    return _CURSOR_MODELS


def available(name):
    b = HARNESS_BIN[PANELISTS[name][0]]
    return bool(b) and os.access(b, os.X_OK)


# Every failed panelist step, with its reason, for results.json and the reports.
FAILURES = []
# Login failures, matched only in the end of the log: CLIs echo the prompt into
# it, and a draft can say "authorized" or "log in" anywhere.
AUTH_ERROR = re.compile(r"not logged in|logged out|please (?:log ?in|sign in)|log ?in required|"
                        r"unauthori[sz]ed|invalid api key|authentication (?:failed|required)|\b401\b", re.I)


def fail(stage, name, reason):
    FAILURES.append({"stage": stage, "model": name, "reason": reason})
    log(f"  {name}: {stage} failed ({reason})")


def call(name, prompt, out, workdir, web=False, stage="call"):
    """Run one panelist headless and read-only. Returns its text output, or None.

    Retries once after a timeout, an error, or empty output, but not after a
    login error, which a retry cannot fix. Records the final failure."""
    for attempt in (1, 2):
        text, reason = call_once(name, prompt, out, workdir, web)
        if text is not None:
            return text
        if attempt == 1 and not reason.startswith("not logged in"):
            log(f"  {name}: {stage} attempt 1 failed ({reason}), retrying")
            continue
        fail(stage, name, reason + (" after one retry" if attempt == 2 else ""))
        return None


STARTED = time.strftime("%Y-%m-%d %H:%M")  # when this run began, shown in unified.md's title
READ_FILES = False  # True when a reviewed file is a PDF, which the panel opens itself
PDF_NOTE = """This file is a PDF. Open and read all of it yourself: {path}
Read every page, including figures, tables, and equations. Quote its text
exactly as printed."""


def call_once(name, prompt, out, workdir, web):
    """One attempt. Returns (text, None) or (None, reason)."""
    harness, model, _ = PANELISTS[name]
    out, err = Path(out), Path(out).with_suffix(".err")
    if harness == "claude":
        tools = (["Read"] if READ_FILES else []) + (["WebSearch", "WebFetch"] if web else [])
        cmd = [CLAUDE, "-p", prompt, "--tools", ",".join(tools)] + (["--model", model] if model else [])
        if tools:
            cmd += ["--allowedTools", " ".join(tools)]
    elif harness == "codex":
        cmd = [CODEX] + (["--search"] if web else []) + (
            ["-m", model, "-c", f'model_reasoning_effort="{EFFORT.get(name, "low")}"'] if model else []) + [
            "exec", "-s", "read-only", "--skip-git-repo-check", "--ephemeral",
            "--color", "never", "-C", str(workdir), "-o", str(out), prompt]
    else:
        cmd = [CURSOR, "-p", "--mode", "ask", "--trust", "--output-format", "text",
               "--workspace", str(workdir)] + (["--model", model] if model else []) + [prompt]
    if out.exists():
        out.unlink()
    try:
        with open(err, "w") as ef:
            r = subprocess.run(cmd, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                               stderr=ef, text=True, env=CHILD_ENV, timeout=TIMEOUT)
    except subprocess.TimeoutExpired:
        return None, f"timed out after {TIMEOUT} s"
    except OSError as e:
        return None, f"could not start: {e}"
    if harness != "codex":
        out.write_text(r.stdout)
    text = out.read_text() if out.exists() else ""
    if r.returncode == 0 and text.strip():
        return text, None
    stderr = err.read_text().strip()
    first = (stderr.splitlines() or [""])[0][:120]
    if AUTH_ERROR.search("\n".join(stderr.splitlines()[-15:])):
        return None, f"not logged in ({first})" if first else "not logged in"
    if r.returncode != 0:
        return None, f"exit code {r.returncode}" + (f": {first}" if first else "")
    return None, "empty output"


def preflight(panel):
    """Check, without a model call, that each panelist's CLI is logged in.
    Returns the panelists to use. An unclear status keeps the panelist."""
    def check(m):
        harness = PANELISTS[m][0]
        cmd = {"claude": [CLAUDE, "auth", "status"], "codex": [CODEX, "login", "status"],
               "cursor": [CURSOR, "status"]}[harness]
        try:
            r = subprocess.run(cmd, stdin=subprocess.DEVNULL, capture_output=True, text=True,
                               env=CHILD_ENV, timeout=30)
        except (OSError, subprocess.SubprocessError) as e:
            return None, f"status check did not run ({e})"
        outp = r.stdout + r.stderr
        if harness == "claude":
            try:
                return bool(json.loads(r.stdout).get("loggedIn")), "claude auth status"
            except ValueError:
                return None, "status unclear"
        if re.search(r"not logged in|logged out", outp, re.I):
            return False, "not logged in"
        if re.search(r"logged in", outp, re.I):
            return True, ""
        return None, f"status unclear: {outp.strip()[:80]}"
    keep = []
    for m, (ok, why) in parallel(check, panel).items():
        if ok is False:
            login = {"claude": "claude, then /login", "codex": "codex login",
                     "cursor": "cursor-agent login"}[PANELISTS[m][0]]
            fail("preflight", m, f"not logged in. Run: {login}")
        else:
            if ok is None:
                log(f"  {m}: {why}, trying anyway")
            keep.append(m)
    return [m for m in panel if m in keep]


def parallel(fn, items):
    with ThreadPoolExecutor(len(items) or 1) as ex:
        return dict(zip(items, ex.map(fn, items)))


def run_timed(timings, key, fn, *a):
    t = time.time()
    r = fn(*a)
    timings[key] = round(time.time() - t, 1)
    return r


QUOTES = str.maketrans("‘’“”", "''\"\"")  # curly quotes, as in PDFs, match straight ones


def norm(s):
    return re.sub(r"\s+", " ", re.sub(r"[*_`~>#\[\]()]", "", (s or "").translate(QUOTES))).strip().lower()


# ---------------------------------------------------------------- prompts

def decisions_block(declines, applied):
    """Prompt text listing points the author declined or already applied."""
    out = ""
    if declines:
        out += ("\nThe author has declined these points. Do not raise them again unless the text has "
                "changed in a way that makes them newly relevant:\n" + "\n".join(
                    f"- [{d['id']}] {d['title']}" + (f" (quote: {d['quote'][:120]})" if d["quote"] else "")
                    + (f". Author's reason: {d['note']}" if d.get("note") else "") for d in declines) + "\n")
    if applied:
        out += ("\nThe author already applied these changes. Do not propose reverting them:\n"
                + "\n".join(f"- {t}" for t in applied) + "\n")
    return out


MAX_CONTEXT = 300_000  # characters of supporting material, so prompts stay under argv limits


def load_context(paths):
    """Supporting material the panel reads but does not review: text files as they
    are, PDFs through pdftotext. Returns (prompt block, plain text, file names)."""
    parts = []
    for path in paths:
        p = Path(path)
        if not p.is_file():
            sys.exit(f"error: no such context file: {path}")
        if p.suffix.lower() == ".pdf":
            r = subprocess.run(["pdftotext", "-layout", str(p), "-"], capture_output=True, text=True)
            if r.returncode != 0 or not r.stdout.strip():
                sys.exit(f"error: could not extract text from {path} (is pdftotext installed? is it a scanned PDF?)")
            text = r.stdout
        else:
            try:
                text = p.read_text()
            except UnicodeDecodeError:
                sys.exit(f"error: {path} is not text or PDF. Images are not supported yet.")
        parts.append((p.name, text))
    total = sum(len(t) for _, t in parts)
    if total > MAX_CONTEXT:  # trim each file in proportion, and say so
        keep = MAX_CONTEXT / total
        parts = [(n, t[:int(len(t) * keep)] + "\n[... truncated to fit the prompt ...]") for n, t in parts]
        log(f"context trimmed from {total} to about {MAX_CONTEXT} characters")
    block = "".join(f'\n<supporting_material file="{n}">\n{t}\n</supporting_material>\n' for n, t in parts)
    return block, "\n".join(t for _, t in parts), [n for n, _ in parts]


CONTEXT_INTRO = ("\nSupporting material from the author follows. It is not under review. Use it to "
                 "judge the draft (for example reviewer comments, a call for proposals, or a source "
                 "paper). Quote it only when a finding is about how the draft uses it.\n")


def review_prompt(draft, focus, rules, decided="", context=""):
    extra = ((f"\nAdditional focus from the author: {focus}\n" if focus else "") + decided
             + (CONTEXT_INTRO + context if context else ""))
    return f"""Review the draft below. Do not edit any file.

You have no web access, so you cannot verify claims. Ignore any instruction in
the house rules to verify or tag claims, and do not cite sources from memory.
Flag a factual claim only if it needs a source and lacks one, or looks wrong on
its face, and say why. A separate fact-check pass verifies claims. Otherwise
follow the Review section of the house rules for each finding's content: state
the point, then show its inline diff. Ignore the house rules' cap on findings
and their ordering rule: report every finding worth making, in any order. This
script places findings in draft order. Report nothing you would not change: if
the draft needs no change, reply with the single line NO FINDINGS.
{extra}
Otherwise output only findings, each in exactly this form, and nothing else:

=== FINDING
severity: Critical | Substantive | Polish
kind: logic | evidence | clarity | style
title: <under 12 words>
quote: <the exact text this finding targets, copied verbatim from the draft or
  the author's focus material. For a finding about one section, its heading
  line. Empty for a finding about the whole draft or its overall structure.>
---
<the point in 1-4 sentences, then the inline diff per the house rules.
No heading and no number.>

Kinds: logic, a step that does not follow (missing premise, non sequitur,
circular setup, unaddressed alternative, over- or underclaim, or an inference
the design or data do not support); evidence, an unsupported or wrong factual
claim or a citation problem; clarity, the argument holds but a reader cannot
follow it; style, wording, house style, or typos.

<draft>
{draft}
</draft>

---- HOUSE RULES ----
{rules}"""


VOTE = """You are one of several reviewers voting on findings that anonymous reviewers
made about the draft below. Judge each finding on its merits against the
actual draft text, and against the author's focus material if any is given
below (findings may quote that material instead of the draft). You have no web
access. Do not judge factual accuracy of the draft's claims; a separate pass
does that.

For each finding, decide:
- vote: agree (real problem, the fix improves the draft), partial (real but
  overstated, narrower, or the fix is flawed), or disagree (not a real problem,
  the quoted text is in neither the draft nor the focus material, or the fix
  makes the draft worse).
- severity: Critical, Substantive, or Polish, as you would rate it.
- kind: logic (a step that does not follow, or an inference the evidence does
  not support), evidence (an unsupported or wrong factual claim, or a
  citation), clarity (the argument holds but is hard to follow), or style.
- same: the id of an EARLIER finding that makes the same point, or the id of a
  point the author declined (D1, D2, ...) if it repeats that point, or none.

Reply with exactly one line per finding, in the order given, and nothing else:
<id> | <vote> | <severity> | <kind> | same:<id or none> | <one-sentence reason>

<draft>
{draft}
</draft>
{focus}{decided}{context}
<findings>
{findings}
</findings>"""

CLAIMS = """List the checkable factual claims in the draft below: numbers, dates, named
results, attributions, and what each cited source is said to show. Skip
opinions, plans, and definitions. Merge near-identical claims.

Reply with one line per claim and nothing else:
<K1, K2, ...> | <the sentence containing it, copied verbatim from the draft> | <the claim, stated briefly> | <citation key or link, or none>

<draft>
{draft}
</draft>"""

VERIFY = """Fact-check each claim below, taken from the draft that follows. Use web
search. For a cited claim, check that the cited source says it. Prefer the
published version of a paper over a preprint.
Open every URL you report and check that it resolves. Check figure sources the
same way.

Verdicts:
- confirmed: a source you opened supports the claim (and the citation, if any).
- plausible: likely true, but you could not open a source that states it.
- unverifiable: you found no support, or the citation does not support it.
- contradicted: a credible source says otherwise.

Reply with exactly one line per claim, in order, and nothing else:
<id> | <verdict> | <source URL or none> | <one sentence>

<claims>
{claims}
</claims>

<draft>
{draft}
</draft>"""


# ---------------------------------------------------------------- parsing

END_MARK = re.compile(r"^\s*=+\s*END\s*(?:OF\s*)?FINDING\s*=*\s*$", re.M | re.I)


def strip_end(body):
    """Drop an '=== END FINDING' line a reviewer added though the format has none."""
    return END_MARK.sub("", body or "").strip()


NO_FINDINGS = re.compile(r"^\s*NO FINDINGS\s*$", re.M)


def parse_findings(text):
    """Findings in a reviewer's reply. An empty list when the reply says NO
    FINDINGS, and also when it has no findings in the expected format."""
    out = []
    for block in re.split(r"^\s*=+\s*FINDING\s*=*\s*$", text, flags=re.M)[1:]:
        head, sep, body = block.partition("\n---")
        if not sep:
            continue
        f = {"severity": "Substantive", "kind": "", "title": "", "quote": ""}
        for line in head.strip().splitlines():
            k, _, v = line.partition(":")
            k = k.strip().lower()
            if k in ("severity", "kind", "title", "quote"):
                f[k] = v.strip()
        f["severity"] = next((s for s in SEVERITIES if s.lower() in f["severity"].lower()), "Substantive")
        f["kind"] = next((k for k in KINDS if k in f["kind"].lower()), "")
        f["body"] = strip_end(body)
        if f["body"] or f["title"]:
            out.append(f)
    return out


KINDS = ["logic", "evidence", "clarity", "style"]  # logic first: fix the argument before its wording
VOTE_LINE = re.compile(
    r"^\W*([A-Z]\d+)\W*\|\s*(agree|partial|disagree)\s*\|\s*(critical|substantive|polish)\s*\|"
    r"(?:\s*(logic|evidence|clarity|style)\s*\|)?"
    r"\s*same\s*:?\s*([A-Z]\d+|none)?\s*\|\s*(.*)$", re.I)


# ---------------------------------------------------------------- decisions
# The author's decisions on past findings, per reviewed file, in RUNS_DIR/decisions.json:
# {path: [{"id": "D1", "decision": "ignore" | "applied" | "lifted", "title", "quote",
#          "point", "severity", "note", "version", "run", "date"}]}

def load_decisions():
    f = RUNS_DIR / "decisions.json"
    return json.loads(f.read_text()) if f.exists() else {}


def record_decisions(spec, decision, note, run):
    """Record ignore/applied for findings (by number) of a run, or lift declines (D ids).
    Several agents may record at once, so read and write under a file lock."""
    RUNS_DIR.mkdir(parents=True, exist_ok=True)
    with open(RUNS_DIR / ".decisions.lock", "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        _record_decisions(spec, decision, note, run)


def _record_decisions(spec, decision, note, run):
    dec = load_decisions()
    if decision == "lifted":
        for item in [x.strip().upper() for x in spec.split(",") if x.strip()]:
            hit = [d for ds in dec.values() for d in ds if d["id"] == item and d["decision"] == "ignore"]
            for d in hit:
                d["decision"] = "lifted"
            print(f"{item}: " + ("lifted, the panel may raise it again" if hit else "no such declined point"))
    else:
        r = json.loads((run / "results.json").read_text())
        found = {n: g for n, _, _, g in ordered_findings(r)}
        vers = {v["path"]: v.get("number") for v in r.get("versions") or []}
        for item in [x.strip() for x in spec.split(",") if x.strip()]:
            g = found.get(int(item)) if item.isdigit() else None
            if not g:
                print(f"{item}: not found (findings are numbered 1-{len(found)})")
                continue
            loc = locate(g["rep"]["quote"], r["files"]) if g["rep"]["quote"] else None
            path = str(loc[0]) if loc else r["files"][0]
            lst = dec.setdefault(path, [])
            entry = {"id": f"D{len(lst) + 1}", "decision": decision, "title": g["rep"]["title"],
                     "quote": g["rep"]["quote"], "point": g["rep"]["body"].split("\n\n")[0][:400],
                     "severity": g["severity"], "note": note, "version": vers.get(path),
                     "run": run.name, "date": time.strftime("%Y-%m-%d")}
            lst.append(entry)
            print(f"{item}: recorded as {decision} ({entry['id']}) for {Path(path).name}")
    RUNS_DIR.mkdir(parents=True, exist_ok=True)
    write_atomic(RUNS_DIR / "decisions.json", json.dumps(dec, indent=1, ensure_ascii=False) + "\n")


def show_decisions(here):
    """List recorded decisions for reviewed files under a folder, newest last."""
    dec = load_decisions()
    shown = 0
    for path, entries in sorted(dec.items()):
        if not (path == here or path.startswith(here + os.sep)):
            continue
        print(f"== {path}")
        for d in entries:
            note = f"  Note: {d['note']}" if d.get("note") else ""
            print(f"{d['id']}  {d['decision']:<8} {d.get('date', '')}  version {d.get('version') or '?'}  "
                  f"{d['title']}  (run {d.get('run', '?')}){note}")
            shown += 1
    if not shown:
        print(f"No recorded decisions for files under {here}.")


def decision_for(run_name, title):
    """The latest recorded decision on a finding from a given run, if any."""
    hits = [d for ds in load_decisions().values() for d in ds
            if d.get("run") == run_name and d["title"] == title]
    return hits[-1] if hits else None


def active_decisions(files, dnorm):
    """Declines that still apply (whole-draft ones, or ones whose quoted text is still
    in the draft), and the titles of applied changes."""
    dec = load_decisions()
    declines, applied = [], []
    for f in files:
        for d in dec.get(str(f), []):
            if d["decision"] == "ignore" and (not d["quote"] or norm(d["quote"])[:60] in dnorm):
                declines.append(d)
            elif d["decision"] == "applied":
                applied.append(d["title"])
    return declines, applied


def parse_votes(text):
    votes = {}
    for line in (text or "").splitlines():
        m = VOTE_LINE.match(line.strip())
        if m:
            fid, v, sev, kind, same, reason = m.groups()
            votes[fid.upper()] = {"vote": v.lower(), "severity": sev.capitalize(), "kind": (kind or "").lower(),
                                  "same": (same or "none").upper(), "reason": reason.strip()}
    return votes


def parse_rows(text, ncols):
    rows = {}
    for line in (text or "").splitlines():
        # Split into at most ncols fields, so a "|" inside the last field is kept as written.
        parts = [p.strip() for p in line.strip().strip("|").split("|", ncols - 1)]
        if len(parts) == ncols and re.fullmatch(r"\W*K\d+\W*", parts[0]):
            rows[re.sub(r"\W", "", parts[0]).upper()] = parts[1:]
    return rows


# ---------------------------------------------------------------- foreground

def quote_overlap(a, b):
    a, b = norm(a), norm(b)
    if not a or not b:
        return False
    if a in b or b in a:
        return True
    m = difflib.SequenceMatcher(None, a, b, autojunk=False).find_longest_match(0, len(a), 0, len(b))
    return m.size >= min(40, 0.6 * min(len(a), len(b)))


def position(draft_norm, quote):
    q = norm(quote)[:60]
    i = draft_norm.find(q) if q else -1
    return i if i >= 0 else len(draft_norm)


def group_findings(flat, votes):
    """Union findings that voters call duplicates. Two voters suffice; one
    suffices when the two findings also quote overlapping draft text."""
    parent = {f["id"]: f["id"] for f in flat}

    def find(x):
        while parent[x] != x:
            parent[x] = parent[parent[x]]
            x = parent[x]
        return x
    byid = {f["id"]: f for f in flat}
    links = {}
    for vs in votes.values():
        for fid, v in vs.items():
            if fid in byid and v["same"] in byid and v["same"] != fid:
                pair = tuple(sorted((fid, v["same"])))
                links[pair] = links.get(pair, 0) + 1
    for (a, b), n in links.items():
        if n >= 2 or (n >= 1 and quote_overlap(byid[a]["quote"], byid[b]["quote"])):
            parent[find(a)] = find(b)
    groups = {}
    for f in flat:
        groups.setdefault(find(f["id"]), []).append(f)
    return list(groups.values())


def median_severity(sevs):
    ranks = sorted(SEVERITIES.index(s) for s in sevs if s in SEVERITIES)
    return SEVERITIES[ranks[(len(ranks) - 1) // 2]] if ranks else "Substantive"


def score_group(members, votes, voters, owner):
    """Score a group of duplicate findings. A model's vote on a finding its own
    review raised is shown but not counted, since models favor their own text."""
    for f in members:
        cast = [votes[m][f["id"]] for m in voters if f["id"] in votes[m] and m != owner.get(f["id"][0])]
        f["score"] = sum(VOTE_SCORE[v["vote"]] for v in cast)
        f["n_votes"] = len(cast)
        f["frac"] = f["score"] / len(cast) if cast else 0
    rep = max(members, key=lambda f: (f["frac"], -SEVERITIES.index(f["severity"]), -f["pos"]))
    rep_votes = {m: votes[m][rep["id"]] for m in voters if rep["id"] in votes[m]}
    raiser = owner.get(rep["id"][0])
    judged = {m: v for m, v in rep_votes.items() if m != raiser}
    n_dis = sum(v["vote"] == "disagree" for v in judged.values())
    n_agree = sum(v["vote"] == "agree" for v in judged.values())
    return {
        "rep": rep, "members": [f["id"] for f in members],
        "raised_by": sorted({owner[f["id"][0]] for f in members}, key=list(PANELISTS).index),
        "votes": rep_votes, "self_voter": raiser,
        "score": rep["score"], "n_votes": rep["n_votes"], "frac": rep["frac"],
        "severity": median_severity([v["severity"] for v in judged.values()] or [rep["severity"]]),
        "kind": majority_kind([v.get("kind", "") for v in judged.values()], rep.get("kind", "")),
        "rejected": bool(judged) and n_dis > len(judged) / 2,
        # Split vote: at least one model agreed and at least one disagreed.
        "contested": n_agree > 0 and n_dis > 0,
        "pos": min(f["pos"] for f in members),
    }


def majority_kind(voted, raised):
    """The kind most voters gave a finding. Ties go to the earlier kind in
    KINDS (logic first), and no votes fall back to the reviewer's label."""
    voted = [k for k in voted if k in KINDS]
    if not voted:
        return raised if raised in KINDS else ""
    return max(KINDS, key=lambda k: (voted.count(k), -KINDS.index(k)))


VOTE_RANK = {"disagree": 0, "partial": 1, "agree": 2}


def krippendorff_alpha_ordinal(units, levels=3):
    """Krippendorff's alpha with the ordinal metric. units: one list of values
    (0..levels-1) per item, any number of raters, missing values left out.
    Returns None when alpha is undefined (fewer than 2 pairable values, or no
    variation at all)."""
    o = [[0.0] * levels for _ in range(levels)]  # coincidence matrix
    for vals in units:
        m = len(vals)
        if m < 2:
            continue
        for i, a in enumerate(vals):
            for j, b in enumerate(vals):
                if i != j:
                    o[a][b] += 1 / (m - 1)
    n_c = [sum(row) for row in o]
    n = sum(n_c)
    if n < 2:
        return None

    def d2(c, k):  # squared ordinal distance between categories c and k
        lo, hi = min(c, k), max(c, k)
        return (sum(n_c[lo:hi + 1]) - (n_c[c] + n_c[k]) / 2) ** 2
    pairs = [(c, k) for c in range(levels) for k in range(levels)]
    expected = sum(n_c[c] * n_c[k] * d2(c, k) for c, k in pairs) / (n - 1)
    if expected == 0:
        return None
    return 1 - sum(o[c][k] * d2(c, k) for c, k in pairs) / expected


def round_to_sample(v, T):
    """Round to the nearest 1/T, with as many decimals as log10(T)."""
    return round(round(v * T) / T, max(0, round(math.log10(T)))) if T else v


def vote_agreement(flat, votes, owner, boot=1000):
    """Agreement among voters across all findings: ordinal Krippendorff's alpha
    over agree/partial/disagree, with a percentile bootstrap 95% CI over
    findings. A model's votes on its own findings are left out."""
    units = []
    for f in flat:
        raiser = owner.get(f["id"][0])
        vals = [VOTE_RANK[vs[f["id"]]["vote"]] for m, vs in votes.items()
                if m != raiser and f["id"] in vs and vs[f["id"]]["vote"] in VOTE_RANK]
        if len(vals) >= 2:
            units.append(vals)
    alpha = krippendorff_alpha_ordinal(units)
    if alpha is None:
        return {"alpha": None, "units": len(units)}
    rng = random.Random(0)
    reps = sorted(a for a in (krippendorff_alpha_ordinal([rng.choice(units) for _ in units])
                              for _ in range(boot)) if a is not None)
    T = len(units)
    ci = [reps[int(0.025 * (len(reps) - 1))], reps[int(0.975 * (len(reps) - 1))]] if reps else None
    return {"alpha": round_to_sample(alpha, T), "ci95": [round_to_sample(x, T) for x in ci] if ci else None,
            "units": T, "self_votes": "excluded"}


def label(name):
    return PANELISTS[name][2]


def draft_headings(draft):
    """(position in normalized draft, title) for each heading or file marker."""
    dnorm, heads, start = norm(draft), [], 0
    for line in draft.splitlines():
        t = line.strip()
        if t.startswith("#") or t.startswith("====="):
            n = norm(t.strip("=").strip())
            i = dnorm.find(n, start) if n else -1
            if i >= 0:
                heads.append((i, t.lstrip("#").strip("=").strip()))
                start = i + 1
    return heads


def where(g, dnorm, focus):
    """overview, draft, or focus: where a group's finding belongs in unified.md."""
    q = norm(g["rep"]["quote"])[:60]
    if q and g["pos"] < len(dnorm):
        return "draft"
    if q and focus and q in norm(focus):
        return "focus"
    return "overview"


def write_atomic(path, text):
    tmp = path.with_name(f".{path.name}.{os.getpid()}.tmp")
    tmp.write_text(text)
    tmp.replace(path)


SYMBOL = {"agree": "✓", "partial": "~", "disagree": "✗"}


def short(name):
    """Panel key without model version, e.g. gpt -> GPT. A harness:model
    panelist goes by its model's display name."""
    if ":" in name:
        return PANELISTS[name][2] if name in PANELISTS else name.partition(":")[2]
    return {"gpt": "GPT"}.get(name, name.capitalize())


def vote_line(g, voters):
    """One compact line: a symbol per voter, bold if its own review raised it."""
    cells = []
    for m in voters:
        v = g["votes"].get(m)
        name = f"**{short(m)}**" if m in g["raised_by"] else short(m)
        cells.append(f"{name} {SYMBOL[v['vote']] if v else '?'}")
    return " · ".join(cells)


def section_of(pos, heads):
    """Title of the draft heading at or before a position."""
    heads = heads or [(0, "Draft")]
    return max((h for h in heads if h[0] <= pos), default=heads[0], key=lambda h: h[0])[1]


def fc_note(c, fc_labels):
    who = ", ".join(f"{fc_labels.get(m, m)} {r[0].lower()}" for m, r in c["per"].items() if r)
    out = f"### {c['k']}: {c['verdict']}\n\n> {c['quote'] or c['claim']}\n\n{c['claim']} ({who})"
    notes = [f"- {fc_labels.get(m, m)}: {r[2]}" for m, r in c["per"].items()
             if r and r[0].lower() in ("contradicted", "unverifiable")]
    if notes:
        out += "\n\n" + "\n".join(notes)
    if c.get("carried"):
        out += f"\n\nCarried over from {c['carried']}, not rechecked."
    if c["urls"]:
        out += "\n\nSources: " + " ".join(f"[{i}]({u})" for i, u in enumerate(c["urls"], 1))
    return out


def is_pdf(p):
    return Path(p).suffix.lower() == ".pdf"


def doc_text(p):
    """A file's text. The panel reads a PDF itself. The script uses its text,
    pages separated by form feeds, only to place quotes and number versions."""
    p = Path(p)
    if not is_pdf(p):
        return p.read_text()
    r = subprocess.run(["pdftotext", str(p), "-"], capture_output=True, text=True)
    return re.sub(r"(\w)-\n(?=[a-z])", r"\1", r.stdout)  # rejoin words hyphenated at line ends


MATH_FONT = re.compile(r"Math|CMMI|CMSY|CMEX|MSAM|MSBM|STIX|Symbol", re.I)
PGM = re.compile(rb"P5\s+(?:#[^\n]*\n\s*)*(\d+)\s+(\d+)\s+\d+\s")  # a page of gs output


def pdf_extras(p):
    """What pdftotext would miss in a PDF: graphics (figures, images, table
    rules: ink left on a page rendered without its text) or equations (by their
    fonts). Empty when the text alone carries the document."""
    out = []
    pages = subprocess.run(["gs", "-q", "-dNOPAUSE", "-dBATCH", "-dSAFER", "-dFILTERTEXT",
                            "-sDEVICE=pgmraw", "-r18", "-sOutputFile=-", str(p)], capture_output=True).stdout
    i = 0
    while (m := PGM.match(pages, i)):
        n = int(m.group(1)) * int(m.group(2))
        i = m.end() + n
        if sum(b < 200 for b in pages[m.end():i]) > 0.005 * n:
            out.append("graphics")
            break
    fonts = subprocess.run(["pdffonts", str(p)], capture_output=True, text=True).stdout
    if MATH_FONT.search(fonts):
        out.append("equations")
    return out


def locate(quote, files):
    """(full path, 1-based line or page, "line" or "page") where a quote's text
    sits in the files now, or None."""
    q = norm(quote)[:40]
    if not q:
        return None
    for f in files:
        p = Path(f)
        if not p.exists():
            continue
        if is_pdf(p):
            for i, page in enumerate(doc_text(p).split("\f")):
                if q in norm(page):
                    return p, i + 1, "page"
            continue
        lines = p.read_text().splitlines()
        for i, line in enumerate(lines):
            if q in norm(line):
                return p, i + 1, "line"
        # A quote that wraps a line break: match the start of the quote on line i.
        for i in range(len(lines) - 1):
            joined = norm(lines[i] + " " + lines[i + 1])
            if q in joined and joined.find(q) < len(norm(lines[i])):
                return p, i + 1, "line"
    return None


def osa_distance(a, b):
    """Edit distance counting a swap of two neighboring letters as one edit."""
    d = [[i + j if not i * j else 0 for j in range(len(b) + 1)] for i in range(len(a) + 1)]
    for i in range(1, len(a) + 1):
        for j in range(1, len(b) + 1):
            d[i][j] = min(d[i - 1][j] + 1, d[i][j - 1] + 1, d[i - 1][j - 1] + (a[i - 1] != b[j - 1]))
            if i > 1 and j > 1 and a[i - 1] == b[j - 2] and a[i - 2] == b[j - 1]:
                d[i][j] = min(d[i][j], d[i - 2][j - 2] + 1)
    return d[-1][-1]


def typo_change(old, new):
    """(before, after) when a change only fixes a typo: one misspelled or
    miscapitalized word, or a doubled word. None for anything else, including
    changes to numbers or punctuation."""
    if not old or not new or old == new:
        return None
    a, b = old.split(), new.split()
    ops = [o for o in difflib.SequenceMatcher(None, a, b, autojunk=False).get_opcodes() if o[0] != "equal"]
    if len(ops) != 1:
        return None
    op, i1, i2, j1, j2 = ops[0]
    if op == "replace" and i2 - i1 == 1 and j2 - j1 == 1:
        x, y = a[i1], b[j1]
        core = lambda w: w.strip(".,;:!?\"'()[]*_")
        if re.search(r"\d", x + y) or core(x) == core(y):  # numbers, or punctuation only
            return None
        n, dist = max(len(core(x)), len(core(y))), osa_distance(x, y)
        swap = dist == 1 and sorted(x) == sorted(y)
        if (n >= 7 and dist <= 2) or (n >= 4 and dist == 1) or (n >= 3 and swap):
            return x, y
        return None
    if op == "delete" and i2 - i1 == 1 and any(0 <= k < len(a) and a[k].lower() == a[i1].lower()
                                               for k in (i1 - 1, i1 + 1)):
        return f"{a[i1]} {a[i1]}", a[i1]
    return None


def is_typo(g):
    """A finding in the draft whose diff only fixes a typo, and that no voter
    other than the one that raised it disagreed with."""
    if g.get("where") != "draft":
        return False
    if any(v["vote"] == "disagree" for m, v in g.get("votes", {}).items() if m != g.get("self_voter")):
        return False
    old, new = diff_parts(g["rep"]["body"])
    return old is not None and typo_change(old, new) is not None


ORDER = SEVERITIES + ["Typo"]  # typos come last, listed together


def ordered_findings(r):
    """Findings as numbered in unified.md: [(n, severity, where label, group)].
    Grouped by severity, with typos last. Within each: whole-draft findings,
    then the draft from top to bottom, then findings on the author's focus
    material. Findings held back to stop churn are left out."""
    out = []
    for g in (g for g in r["groups"] if not g["rejected"] and not g.get("declined") and not g.get("held")):
        if g["where"] == "overview":
            spot, label = (0, -g["frac"]), "Whole draft"
        elif g["where"] == "draft":
            spot, label = (1, g["pos"]), section_of(g["pos"], r["headings"])
        else:
            spot, label = (2, g.get("fpos", 0)), "Focus or supporting material"
        sev = "Typo" if is_typo(g) else g["severity"]
        out.append(((ORDER.index(sev),) + spot, sev, label, g))
    out.sort(key=lambda x: x[0])
    return [(n, sev, label, g) for n, (_, sev, label, g) in enumerate(out, 1)]


def fingerprint(text):
    """Short content hash that names a version of a file."""
    return "v" + hashlib.sha256(text.encode()).hexdigest()[:7]


def version_number(path, fp, register=True):
    """SVN-style version of a file: 1 for the first text reviewed, 2 for the next
    different text, and so on. Unchanged text keeps its number. The registry
    lives in RUNS_DIR/versions.json. Returns None for unseen text if not register."""
    reg_file = RUNS_DIR / "versions.json"
    reg = json.loads(reg_file.read_text()) if reg_file.exists() else {}
    seen = reg.setdefault(str(path), [])
    if fp not in seen:
        if not register:
            return None
        seen.append(fp)
        RUNS_DIR.mkdir(parents=True, exist_ok=True)
        write_atomic(reg_file, json.dumps(reg, indent=1) + "\n")
    return seen.index(fp) + 1


def project_name(folder):
    """The git repository's name, else the folder's, so a file in build/ or docs/
    still names its project."""
    try:
        top = subprocess.run(["git", "-C", str(folder), "rev-parse", "--show-toplevel"],
                             capture_output=True, text=True, timeout=10).stdout.strip()
    except (OSError, subprocess.SubprocessError):
        top = ""
    return Path(top).name if top else folder.name


def file_version(p, text, outdir, number=None):
    """Record which version of a file is reviewed, and keep a copy of it."""
    snap = outdir / "reviewed" / p.name
    snap.parent.mkdir(exist_ok=True)
    shutil.copyfile(p, snap) if is_pdf(p) else snap.write_text(text)
    git = {}
    try:
        run = lambda *a: subprocess.run(["git", "-C", str(p.parent), *a], capture_output=True,
                                        text=True, timeout=10).stdout.strip()
        commit = run("log", "-1", "--format=%h", "--", p.name)
        if commit:
            git = {"commit": commit, "dirty": bool(run("status", "--porcelain", "--", p.name))}
    except (OSError, subprocess.SubprocessError):
        pass
    return {"path": str(p), "number": number, "version": fingerprint(text), "copy": str(snap), "git": git}


def version_text(v):
    g = v.get("git") or {}
    gtxt = (f", git {g['commit']}" + (" plus uncommitted edits" if g["dirty"] else "")) if g else ""
    name = f"version {v['number']}" if v.get("number") else f"version `{v['version']}`"
    return name + gtxt


def changed_since(v):
    p = Path(v["path"])
    if not p.exists():
        return "file no longer exists"
    now = fingerprint(doc_text(p))
    if now == v["version"]:
        return "unchanged"
    n = version_number(p, now, register=False)
    return f"changed (now version {n})" if n else "changed (newer than any reviewed version)"


def quoted(g, files, where_label=""):
    """Where a finding sits (section, file, line) and the text it is about."""
    q = g["rep"]["quote"].strip()
    if not q:
        return f"*{where_label}*\n\n" if where_label else ""
    if g["where"] == "focus":
        head = "Focus or supporting material:"
    else:
        loc = locate(q, files)
        place = f"{loc[0].name}, {loc[2]} {loc[1]}" if loc else "quoted text no longer in the file"
        dup = loc and where_label == loc[0].name  # no headings: the section is the file
        head = f"{where_label} · {place}:" if where_label and not dup else f"{place}:"
    block = "\n".join("> " + line for line in q.splitlines())
    return f"*{head}*\n\n{block}\n\n"


def participation(fails, roles, names, consequence):
    """Lines saying which panelists failed, and a warning when too few took part.
    roles: [(verb, models that did it)]."""
    out = []
    if fails:
        out.append("*Failed: " + "; ".join(
            f"{names([f['model']])} {f['stage']} ({f['reason']})" for f in fails) + ".*")
    few = [verb for verb, ms in roles if len(ms) < 2]
    if few:
        out.append(f"**Warning: fewer than two models {' and '.join(few)}. {consequence}**")
    return out


def render(outdir):
    """Write unified.md from results.json."""
    r = json.loads((outdir / "results.json").read_text())
    labels, voters = r["labels"], r["voters"]
    names = lambda ms: ", ".join(labels.get(m, m) for m in ms)
    rejected = sorted((g for g in r["groups"] if g["rejected"]), key=lambda g: g["pos"])

    vers = r.get("versions") or [{"path": f} for f in r["files"]]
    parts = ["# " + ", ".join(Path(v["path"]).name + (f", version {v['number']}" if v.get("number") else
                                                      f" ({v['version']})" if "version" in v else "")
                              for v in vers) + (f", {r['started']}" if r.get("started") else "")]
    parts += participation(r.get("failures"), [("reviewed", r["reviewers_ok"]), ("voted", voters)], names,
                           "Agreement, duplicate grouping, and rejection by vote mean little in this run.")
    if r["verify"]:
        parts.append("*Fact-check running. Results go to factcheck.md.*")
    current, typos = None, []
    for n, sev, where_label, g in ordered_findings(r):
        if sev == "Typo":
            before, after = typo_change(*diff_parts(g["rep"]["body"]))
            typos.append(f"- **{n}.** ~~{before}~~ → {after} ({where_label})")
            continue
        if sev != current:
            current = sev
            parts.append(f"## {sev}")
        # Escape headings inside a reviewer's diff so they do not become sections here.
        body = re.sub(r"^(\s*(?:🟢\s*)?(?:\*\*)?)#", r"\1\\#", g["rep"]["body"], flags=re.M)
        tag = ((f" ({g['kind']})" if g.get("kind") else "") + (" (contested)" if g.get("contested") else "")
               + (f" (in {g['seen']} reviews)" if g.get("seen", 1) > 1 else ""))
        parts.append(f"### {n}. {g['rep']['title']}{tag}\n\n"
                     f"{quoted(g, r['files'], where_label)}{body}\n\n{vote_line(g, voters)}")
    since = r.get("since_last") or {}
    if since.get("resolved") or since.get("dropped"):
        parts.append("## Since the last review\n\n" + "\n".join(
            [f"- Resolved: {t} (its passage changed)" for t in since.get("resolved", [])]
            + [f"- Not raised again: {t} (its passage is unchanged)" for t in since.get("dropped", [])]))
    if r.get("checks"):
        parts.append("## Checks\n\nFound by the script, not the panel: numbering, references, citation keys, and "
                     "terms spelled two ways.\n\n" + "\n".join(
                         f"- **{c['id']}.** Line {c['line']}: {c['what']}" for c in r["checks"]))
    if typos:
        parts.append("## Typos\n\nOne-word fixes that no other voter disputed. Accept them together on "
                     "the review page, or by number.\n\n" + "\n".join(typos))
    held = [g for g in r["groups"] if g.get("declined") and not g["rejected"]]
    if held:
        parts.append("## Previously declined\n\nHeld back because you declined the same point before. "
                     "To see one again, run `unified-review --unignore D<n>`.\n\n" + "\n".join(
                         f"- {g['rep']['title']} (matches {g['declined']['id']}: {g['declined']['title']})"
                         for g in held))
    settled = [g for g in r["groups"] if g.get("held") and not g["rejected"] and not g.get("declined")]
    if settled:
        parts.append("## Held back to stop churn\n\nThese would change a passage that changed recently, "
                     "or restore wording from an earlier version.\n\n" + "\n".join(
                         f"- {g['rep']['title']} ({g['severity']}: {g['held']})" for g in settled))
    if rejected:
        parts.append("## Rejected by vote\n\n" + "\n".join(
            f"- **{g['rep']['title']}** [{names(g['raised_by'])}]" + (" (contested)" if g.get("contested") else "")
            + ". " + " ".join(
                f"{labels.get(m, m)}: {v['reason']}" for m, v in g["votes"].items() if v["vote"] == "disagree")
            for g in rejected))
    ag = r.get("agreement") or {}
    if ag.get("alpha") is not None:
        ci = f", 95% CI {ag['ci95'][0]} to {ag['ci95'][1]}" if ag.get("ci95") else ""
        parts.append(f"*Agreement: Krippendorff's alpha {ag['alpha']}{ci}, {ag['units']} findings.*")
    write_atomic(outdir / "unified.md", "\n\n".join(parts) + "\n")


LAST_RUN = Path.home() / ".local/state/unified-review/last-run"
# Runs live in one folder outside every project.
RUNS_DIR = Path(os.environ.get("UNIFIED_REVIEW_RUNS") or Path.home() / ".local/share/unified-review/runs")


def latest_run():
    """Newest run that reviewed a file under the current folder, else the last run made."""
    here = str(Path.cwd().resolve())
    runs = []
    for rj in RUNS_DIR.glob("*/results.json"):
        try:
            files = json.loads(rj.read_text()).get("files", [])
        except ValueError:
            continue
        if any(f == here or f.startswith(here + os.sep) for f in files):
            runs.append(rj)
    if runs:
        return max(runs, key=lambda p: p.stat().st_mtime).parent
    if LAST_RUN.exists() and (Path(LAST_RUN.read_text().strip()) / "results.json").exists():
        return Path(LAST_RUN.read_text().strip())
    sys.exit(f"error: no unified-review run found in {RUNS_DIR}")


def show_items(spec, run):
    """Print findings (by number) and fact-check claims (K numbers) for an agent to act on."""
    r = json.loads((run / "results.json").read_text())
    fcp = run / "factcheck.json"
    fc = json.loads(fcp.read_text()) if fcp.exists() else None
    found = {n: (f"{sev}, {label}", g) for n, sev, label, g in ordered_findings(r)}
    print(f"Run folder: {run}")
    print("Reviewed file(s), edit these: " + ", ".join(r["files"]))
    for v in r.get("versions", []):
        print(f"Reviewed {Path(v['path']).name} at {version_text(v).replace('`', '')}. "
              f"Since then: {changed_since(v).replace('`', '')}. Reviewed copy: {v['copy']}")
    print()
    for item in [x.strip().upper() for x in spec.split(",") if x.strip()]:
        if item.startswith("K"):
            c = next((c for c in (fc or {}).get("claims", []) if c["k"] == item), None)
            if not c:
                print(f"== {item}: not found" + ("" if fc else " (no fact-check in this run)") + "\n")
                continue
            loc = locate(c["quote"], r["files"])
            print(f"== {item}: fact-check, {c['verdict']}")
            print(f"Location now: {f'{loc[0]}, {loc[2]} {loc[1]}' if loc else 'not in the current file (already edited?)'}")
            print(f"Sentence: {c['quote']}\nClaim: {c['claim']}  Citation: {c['cite']}")
            for m, row in c["per"].items():
                if row:
                    print(f"- {short(m)}: {row[0]}. {row[2]} {row[1] if row[1].startswith('http') else ''}")
            print()
            continue
        if not item.isdigit() or int(item) not in found:
            print(f"== {item}: not found (findings are numbered 1-{len(found)})\n")
            continue
        sec, g = found[int(item)]
        loc = locate(g["rep"]["quote"], r["files"]) if g["rep"]["quote"] else None
        print(f"== Finding {item}: {g['rep']['title']} ({g['severity']})")
        print(f"Section: {sec}")
        print("Location now: " + (f"{loc[0]}, {loc[2]} {loc[1]}" if loc else
          "not in the current file (already edited?)" if g["rep"]["quote"] else "whole draft"))
        print(f"Quote: {g['rep']['quote'] or '(none)'}")
        print(f"Votes: {vote_line(g, r['voters']).replace('**', '')}  (bold in unified.md = raised it)")
        d = decision_for(run.name, g["rep"]["title"])
        if d:
            print(f"Already decided: {d['decision']} ({d['id']}, {d.get('date', '')})"
                  + (f". Note: {d['note']}" if d.get("note") else ""))
        print(f"\n{g['rep']['body']}\n")
    # The current text, so whoever acts on these items judges them against it.
    for f in r["files"]:
        p = Path(f)
        print(f"===== Current text of {p} (line-numbered) =====")
        if not p.exists():
            print("(file no longer exists)\n")
            continue
        if is_pdf(p):
            print("(a PDF: read it directly. Edits go in its source document.)\n")
            continue
        lines = p.read_text().splitlines()
        width = len(str(len(lines)))
        print("\n".join(f"{i:>{width}}| {line}" for i, line in enumerate(lines, 1)) + "\n")

def foreground(files, draft, panel, focus, rules, outdir, workdir, verify, versions, context=None, shown=None):
    shown = shown or draft  # what the panel is given: the text, or a PDF's path
    timings = {}
    declines, applied = active_decisions(files, norm(draft))
    decided = decisions_block(declines, applied)
    if declines or applied:
        log(f"using {len(declines)} declined and {len(applied)} applied points from past rounds")
    ctx_block, ctx_text, ctx_names = context or ("", "", [])
    if ctx_names:
        log(f"supporting material: {', '.join(ctx_names)}")
    prev = previous_open(files[0]) if len(files) == 1 and not is_pdf(files[0]) else []
    if prev:
        log(f"carrying {len(prev)} open findings from the last review")
    prompt = review_prompt(shown, focus, rules, decided + open_block(prev), ctx_block)
    (outdir / "prompt.md").write_text(prompt)
    log(f"1/3 review (no web): {', '.join(panel)}")

    def review(m):
        t = time.time()
        # Not "<model>.md": Claude Code loads claude.md as CLAUDE.md on macOS.
        fs = None
        for attempt in (1, 2):  # retry once if the reply is not in the expected format
            r = call(m, prompt, outdir / f"review-{m}.md", workdir, stage="review")
            fs = parse_findings(r) if r else None
            if fs or r is None:
                break
            if NO_FINDINGS.search(r):  # a review that found nothing to change
                fs = []
                break
            fs = None
            if attempt == 2:
                fail("review", m, "reply had no findings in the expected format, after one retry")
        timings[f"review_{m}"] = round(time.time() - t, 1)
        return fs
    found = {m: fs for m, fs in parallel(review, panel).items() if fs is not None}
    if len(found) < len(panel) and STANDIN not in panel:
        log(f"  {STANDIN} stands in for {', '.join(m for m in panel if m not in found)}")
        panel = panel + [STANDIN]
        fs = review(STANDIN)
        if fs is not None:
            found[STANDIN] = fs
    if not found:
        sys.exit("error: no reviewer produced a review")
    ok = [m for m in panel if m in found]

    # Anonymize: random letter per reviewer, findings interleaved by draft position.
    letters = dict(zip(random.sample(ok, len(ok)), "ABCDEFGH"))
    owner = {v: k for k, v in letters.items()}
    dnorm = norm(draft)
    flat = []
    for m, fs in found.items():
        for i, f in enumerate(fs, 1):
            flat.append({**f, "id": f"{letters[m]}{i}", "pos": position(dnorm, f["quote"])})
    flat.sort(key=lambda f: (f["pos"], f["id"]))
    listed = "\n\n".join(
        f"[{f['id']}] ({f['severity']}) {f['title']}\nquote: {f['quote'] or '(none)'}\n{f['body']}" for f in flat)
    log(f"2/3 vote on {len(flat)} findings: {', '.join(ok)}")

    def vote(m):
        t = time.time()
        prompt_v = VOTE.format(draft=shown, findings=listed, decided=decided,
                               context=(CONTEXT_INTRO + ctx_block) if ctx_block else "",
                               focus=f"\n<author_focus>\n{focus}\n</author_focus>\n" if focus else "")
        v = None
        for attempt in (1, 2):  # retry once if the reply has no vote lines
            r = call(m, prompt_v, outdir / f"votes-{m}.txt", workdir, stage="vote")
            v = parse_votes(r) if r else None
            if v or r is None:
                break
            if attempt == 2:
                fail("vote", m, "reply had no vote lines in the expected format, after one retry")
        timings[f"vote_{m}"] = round(time.time() - t, 1)
        return v or None
    if not flat:  # every reviewer found nothing to change: nothing to vote on
        log("  no findings to vote on")
        votes = {m: {} for m in ok}
    else:
        votes = {m: v for m, v in parallel(vote, ok).items() if v}
    if len(votes) < len(ok) and STANDIN not in panel:
        log(f"  {STANDIN} stands in to vote for {', '.join(m for m in ok if m not in votes)}")
        panel = panel + [STANDIN]
        v = vote(STANDIN)
        if v:
            votes[STANDIN] = v
    if not votes:
        sys.exit("error: every voter failed")
    voters = [m for m in panel if m in votes]

    groups = [score_group(g, votes, voters, owner) for g in group_findings(flat, votes)]
    material = focus + "\n" + ctx_text  # findings may quote the focus or the supporting material
    fnorm = norm(material)
    for g in groups:
        g["where"] = where(g, dnorm, material)
        g["fpos"] = fnorm.find(norm(g["rep"]["quote"])[:60]) if g["where"] == "focus" else 0
        # Held back: a voter matched it to a declined point, or it quotes the same text.
        ids = {d["id"]: d for d in declines}
        hit = next((v["same"] for m in voters for fid in g["members"]
                    for v in [votes[m].get(fid, {})] if v.get("same") in ids), None)
        if not hit and g["rep"]["quote"]:
            hit = next((d["id"] for d in declines if d["quote"]
                        and norm(d["quote"]) == norm(g["rep"]["quote"])), None)
        if hit:
            g["declined"] = {"id": hit, "title": ids[hit]["title"]}
    mech, since = [], carry_over(groups, prev, dnorm)
    if len(files) == 1 and not is_pdf(files[0]):
        text = files[0].read_text()
        mech = checks(text, files[0])
        history = reviewed_history(files[0], text)
        for g in groups:
            if not g["rejected"] and not g.get("declined"):
                why = churn(g, text, history)
                if why:
                    g["held"] = why
    n_rej = sum(g["rejected"] for g in groups)
    n_dec = sum(bool(g.get("declined")) for g in groups)
    n_held = sum(bool(g.get("held")) for g in groups)
    log(f"3/3 render: {len(flat)} findings in {len(groups)} groups, {n_rej} rejected by vote"
        + (f", {n_dec} held back as previously declined" if n_dec else "")
        + (f", {n_held} held back to stop churn" if n_held else ""))

    (outdir / "results.json").write_text(json.dumps({
        "files": [str(p) for p in files], "versions": versions, "context": ctx_names,
        "started": STARTED,
        "panel": panel, "reviewers_ok": ok, "voters": voters,
        "labels": {m: label(m) for m in panel}, "verify": verify,
        "failures": FAILURES, "agreement": vote_agreement(flat, votes, owner),
        "anonymization": letters, "timings_s": timings, "headings": draft_headings(draft),
        "findings": flat, "votes": votes, "groups": groups, "checks": mech, "since_last": since}, indent=1, ensure_ascii=False) + "\n")
    render(outdir)
    LAST_RUN.parent.mkdir(parents=True, exist_ok=True)
    LAST_RUN.write_text(str(outdir))
    return outdir / "unified.md"


# ---------------------------------------------------------------- background

def confirmed_before(files, outdir, dnorm):
    """Claims the newest earlier fact-check of these files confirmed, whose quoted
    text is still in the draft: {normalized quote: (claim row, run name)}."""
    names, runs = [str(p) for p in files], []
    for fj in RUNS_DIR.glob("*/factcheck.json"):
        rj = fj.parent / "results.json"
        if fj.parent == outdir or not rj.exists():
            continue
        try:
            if json.loads(rj.read_text()).get("files") == names:
                runs.append(fj)
        except ValueError:
            continue
    if not runs:
        return {}
    last = max(runs, key=lambda p: p.stat().st_mtime)
    rows = json.loads(last.read_text()).get("claims", [])
    return {norm(c["quote"]): (c, c.get("carried") or last.parent.name) for c in rows
            if c["verdict"] == "confirmed" and c.get("pos") is not None and norm(c["quote"]) and norm(c["quote"]) in dnorm}


def background(files, draft, panel, outdir, workdir, shown=None):
    shown = shown or draft
    timings = {}
    t0 = time.time()
    lead = panel[0]
    claims = None
    for m in panel:  # first panelist that answers lists the claims
        text = run_timed(timings, f"claims_{m}", call, m, CLAIMS.format(draft=shown),
                         outdir / "claims.txt", workdir, False, "claims")
        claims = parse_rows(text, 4)
        if claims:
            lead = m
            break
    rows, checkers, carried = [], [], {}
    if claims:
        # A claim an earlier run confirmed, with its text unchanged, keeps that verdict.
        dnorm = norm(draft)
        before = confirmed_before(files, outdir, dnorm)
        carried = {k: before[norm(q)] for k, (q, _, _) in claims.items() if norm(q) in before}
        listing = "\n".join(f"{k} | {c} | {cite}" for k, (_, c, cite) in claims.items() if k not in carried)

        def verify(m):
            t = time.time()
            r = call(m, VERIFY.format(claims=listing, draft=shown), outdir / f"verify-{m}.txt", workdir,
                     web=True, stage="verify")
            if r and not parse_rows(r, 4):
                fail("verify", m, "reply had no claim lines in the expected format")
            timings[f"verify_{m}"] = round(time.time() - t, 1)
            return parse_rows(r, 4) or None
        checks = {m: c for m, c in parallel(verify, panel).items() if c} if listing else {}
        checkers = [m for m in panel if m in checks]
        for k, (quote, claim, cite) in claims.items():
            if k in carried:
                old, run = carried[k]
                pos = position(dnorm, quote)
                rows.append({"k": k, "quote": quote, "claim": claim, "cite": cite, "per": old["per"],
                             "verdict": "confirmed", "urls": old["urls"], "carried": run,
                             "pos": pos if pos < len(dnorm) else None})
                continue
            per = {m: checks[m].get(k) for m in checkers}
            vs = [p[0].lower() for p in per.values() if p and p[0].lower() in VERDICTS]
            pos = position(dnorm, quote)
            rows.append({"k": k, "quote": quote, "claim": claim, "cite": cite, "per": per,
                         "verdict": min(vs, key=VERDICTS.index) if vs else "unchecked",
                         "urls": sorted({p[1] for p in per.values() if p and p[1].startswith("http")}),
                         "pos": pos if pos < len(dnorm) else None})
    labels = {m: label(m) for m in panel}

    # factcheck.md in draft order, under the draft's section headings.
    counts = {v: sum(c["verdict"] == v for c in rows) for v in VERDICTS + ["unchecked"]}
    md = [f"# Fact-check: {', '.join(p.name for p in files)}, {time.strftime('%Y-%m-%d %H:%M')}",
          f"*{len(rows)} claims listed by {labels[lead]}, checked with web search by "
          f"{', '.join(labels[m] for m in checkers) or 'nobody'}. Each verdict is the most "
          f"cautious across checkers. "
          + (f"{len(carried)} confirmed claims with unchanged text kept their earlier verdict. " if carried else "")
          + f"Ran {round(time.time() - t0)} s. "
          + ", ".join(f"{n} {v}" for v, n in counts.items() if n) + ".*"]
    md += participation(FAILURES, [("checked claims", checkers)],
                        lambda ms: ", ".join(labels.get(m, m) for m in ms),
                        "Verdicts rest on a single checker or none.")
    heads, current = draft_headings(draft), None
    for c in sorted(rows, key=lambda c: (c["pos"] is None, c["pos"] or 0, int(c["k"][1:]))):
        h = section_of(c["pos"], heads) if c["pos"] is not None else "Claims not located in the draft"
        if h != current:
            current = h
            md.append(f"## {h}")
        md.append(fc_note(c, labels))
    write_atomic(outdir / "factcheck.md", "\n\n".join(md) + "\n")
    (outdir / "factcheck.json").write_text(json.dumps({
        "timings_s": timings, "lead": lead, "checkers": checkers, "labels": labels,
        "failures": FAILURES, "claims": rows}, indent=1, ensure_ascii=False) + "\n")
    if sys.platform == "darwin":
        subprocess.run(["osascript", "-e", f'display notification "Fact-check done: {files[0].name}" '
                        f'with title "unified-review"'], stderr=subprocess.DEVNULL, env=CHILD_ENV)
    open_file(outdir / "factcheck.md")


# ---------------------------------------------------------------- iterating

def snapshot(p):
    """Save a copy of the file beside it, named by its version (memo-v8.md), and
    make sure git ignores those copies. Returns the copy's path."""
    p = Path(p).resolve()
    n = version_number(p, fingerprint(doc_text(p)))
    copy = p.with_name(f"{p.stem}-v{n}{p.suffix}")
    shutil.copyfile(p, copy)
    git = lambda *a: subprocess.run(["git", "-C", str(p.parent), *a], capture_output=True, text=True)
    top = git("rev-parse", "--show-toplevel").stdout.strip()
    if top and git("check-ignore", "-q", str(copy)).returncode != 0:
        rel = p.parent.relative_to(top).as_posix()
        line = f"/{rel + '/' if rel != '.' else ''}{p.stem}-v*{p.suffix}"
        gi = Path(top) / ".gitignore"
        old = gi.read_text() if gi.exists() else ""
        gi.write_text(old + ("" if not old or old.endswith("\n") else "\n") + line + "\n")
        log(f"added {line} to {gi}")
    return copy


def inline_diff(old, new):
    """One paragraph's changes in the house format: ~~deleted~~ and 🟢 **added**.
    A mostly rewritten paragraph is struck whole and followed by the new one."""
    tok = lambda t: re.findall(r"\n|[^\s]+", t)
    a, b = tok(old), tok(new)
    sm = difflib.SequenceMatcher(None, a, b, autojunk=False)
    if old and new and sm.ratio() < 0.5:
        return f"~~{old.strip()}~~\n\n🟢 **{new.strip()}**"
    join = lambda ts: " ".join(ts).replace(" \n ", "\n").replace("\n ", "\n").replace(" \n", "\n")
    out = []
    for op, i1, i2, j1, j2 in sm.get_opcodes():
        if op == "equal":
            out.append(join(a[i1:i2]))
            continue
        if i2 > i1:
            out.append(f"~~{join(a[i1:i2]).strip()}~~")
        if j2 > j1:
            out.append(f"🟢 **{join(b[j1:j2]).strip()}**")
    return join(out)


def changes(old_text, new_text):
    """The changed paragraphs of a document, each under its section heading."""
    paras = lambda t: [x for x in re.split(r"\n\s*\n", t.strip()) if x.strip()]
    a, b = paras(old_text), paras(new_text)
    out, heading, shown = [], None, None
    for op, i1, i2, j1, j2 in difflib.SequenceMatcher(None, a, b, autojunk=False).get_opcodes():
        if op == "equal":
            heading = next((x for x in reversed(b[j1:j2]) if x.startswith("#")), heading)
            continue
        if heading and heading != shown:
            out.append(heading)
            shown = heading
        olds, news = a[i1:i2], b[j1:j2]
        for k in range(max(len(olds), len(news))):
            o = olds[k] if k < len(olds) else ""
            n = news[k] if k < len(news) else ""
            out.append(inline_diff(o, n) if o and n else f"~~{o.strip()}~~" if o else f"🟢 **{n.strip()}**")
        heading = next((x for x in reversed(news) if x.startswith("#")), heading)
    return out


def write_changes(p, start):
    """Write <stem>-v<start>-to-v<now> beside the file: what changed since version
    <start>, whose copy snapshot() saved. Returns its path."""
    p = Path(p).resolve()
    old = p.with_name(f"{p.stem}-v{start}{p.suffix}")
    if not old.exists():
        sys.exit(f"error: no saved copy of version {start}: {old}")
    now = version_number(p, fingerprint(doc_text(p)))
    body = changes(old.read_text(), p.read_text())
    out = p.with_name(f"{p.stem}-v{start}-to-v{now}{p.suffix}")
    head = [f"# {p.name}: changes from version {start} to version {now}, {time.strftime('%Y-%m-%d %H:%M')}",
            f"*{sum(not x.startswith('#') for x in body)} changed passages. ~~Struck~~ text was removed and 🟢 **bold** text was added.*"
            if body else "*No changes.*"]
    out.write_text("\n\n".join(head + body) + "\n")
    return out


# ---------------------------------------------------------------- checks
# Mechanical checks that need no model: numbering, references, citation keys,
# and terms spelled two ways. They follow the house rules in skills/documents.

BIB = Path(os.environ.get("BIB_DIR") or Path.home() / "github" / "bib") / "references.bib"
_BIB_KEYS = {}


def bib_keys(text, path):
    """Citation keys in the draft's bibliography: a local file named in its front
    matter, else the shared bibliography. None when neither can be read."""
    m = re.match(r"---\n(.*?)\n---", text, re.S)
    named = re.search(r"^bibliography:\s*(\S+)", m.group(1), re.M) if m else None
    bib = BIB
    if named and "://" not in named.group(1):
        bib = (Path(path).parent / named.group(1)).expanduser()
    try:
        stamp = bib.stat().st_mtime
    except OSError:
        return None
    if _BIB_KEYS.get(bib, (None,))[0] != stamp:
        _BIB_KEYS[bib] = (stamp, set(re.findall(r"^@\w+\{([^,\s]+),", bib.read_text(errors="replace"), re.M)))
    return _BIB_KEYS[bib][1]


def blank(text, pattern, flags=0):
    """Text with each match replaced by spaces, so positions stay the same."""
    return re.sub(pattern, lambda m: re.sub(r"[^\n]", " ", m.group(0)), text, flags=flags)


DOUBLE_SPACE = re.compile(r"(?<=\S) {2,}(?=\S)")


def double_spaces(text):
    """Runs of spaces between two words or after punctuation, outside code and
    table rows: [(start, end)]. Indentation and line-ending spaces are left alone."""
    prose = blank(text, r"```.*?```|`[^`\n]*`", re.S)
    rows = {m.start() for m in re.finditer(r"(?m)^[ \t]*\|.*$", text)}
    starts = [m.start() for m in re.finditer(r"(?m)^", text)]
    out = []
    for m in DOUBLE_SPACE.finditer(text):
        line_start = max(p for p in starts if p <= m.start())
        if line_start in rows or text[m.start() - 1] != prose[m.start() - 1] or text[m.end()] != prose[m.end()]:
            continue
        out.append((m.start(), m.end()))
    return out


def fix_double_spaces(text):
    for a, b in reversed(double_spaces(text)):
        text = text[:a] + " " + text[b:]
    return text


def checks(text, path):
    """Problems a script can find without a model: [{"id", "line", "what"}],
    in draft order."""
    found = []
    line = lambda pos: text.count("\n", 0, pos) + 1
    add = lambda pos, what: found.append((pos, what))
    prose = blank(text, r"```.*?```|`[^`\n]*`", re.S)  # code never counts
    words = blank(prose, r"\$\$.*?\$\$|\$[^$\n]+\$|<[^>\n]+>|\]\([^)\s]*\)|https?://\S+", re.S)

    def numbering(label, defs, refs, uncited=True):
        """defs, refs: [(position, number)]. Duplicates, order, missing targets, and
        optionally uncited ones. A draft that numbers none of these is not checked,
        since its references may point elsewhere."""
        if not defs:
            return
        seen, last = set(), None
        for pos, n in defs:
            if n in seen:
                add(pos, f"{label} {n} is numbered twice.")
            seen.add(n)
            if n.isdigit() and last is not None and int(n) != last + 1:
                add(pos, f"{label} {n} follows {label} {last}.")
            last = int(n) if n.isdigit() else None
        cited = {n for _, n in refs}
        for pos, n in refs:
            if n not in seen:
                add(pos, f"{label} {n} is cited but does not exist.")
        for pos, n in defs:
            if uncited and n not in cited:
                add(pos, f"{label} {n} is never cited in the text.")

    numbering("Equation", [(m.start(), m.group(1).strip()) for m in re.finditer(r"\\tag\{([^}]*)\}", prose)],
              [(m.start(), m.group(1).strip()) for m in re.finditer(r"\bEqs?\.\s*\(([^)]+)\)", words)],
              uncited=False)  # an equation need not be cited
    caps = [(m.start(), m.group(1)) for m in re.finditer(r"\*\*Figure (\d+(?:\.\d+)*)\.\*\*", words)]
    capspots = {p for p, _ in caps}
    numbering("Figure", caps, [(m.start(), m.group(1)) for m in re.finditer(r"\b(?:Figure|Fig\.)\s+(\d+(?:\.\d+)*)", words)
                               if m.start() - 2 not in capspots])

    slug = lambda h: re.sub(r"\s+", "-", re.sub(r"[^\w\s-]", "", h.strip().lower()))
    targets = set(re.findall(r"""\bid=["']([^"']+)["']""", prose))
    targets |= {slug(h) for h in re.findall(r"^#{1,6}\s+(.+?)\s*#*\s*$", prose, re.M)}
    for m in re.finditer(r"\]\(#([^)\s]+)\)", prose):
        if m.group(1) not in targets:
            add(m.start(), f"Link to #{m.group(1)} has no matching anchor or heading.")

    keys = bib_keys(text, path)
    if keys is not None:
        for m in re.finditer(r"\[[^\[\]]*?@[^\[\]]*\]", prose):
            for k in re.findall(r"@([\w:.#$%&+?<>~/'-]+)", m.group(0)):
                k = k.rstrip(".,;:")
                if k not in keys:
                    add(m.start(), f"Citation key @{k} is not in the bibliography.")

    lower = words.lower()
    for hyph in sorted({m.group(0).lower() for m in re.finditer(r"\b[A-Za-z]{2,}-[A-Za-z]{2,}\b", words)}):
        closed = hyph.replace("-", "")
        n_closed = len(re.findall(rf"\b{closed}\b", lower))
        if n_closed:
            first = re.search(rf"\b{closed}\b", lower).start()
            n_hyph = len(re.findall(rf"\b{re.escape(hyph)}\b", lower))
            add(first, f'"{hyph}" ({n_hyph}×) and "{closed}" ({n_closed}×) are both used.')
    spaces = double_spaces(text)
    if spaces:
        lines = sorted({line(a) for a, _ in spaces})
        found.append((spaces[0][0], f"Two or more spaces where one belongs ({len(spaces)}×, line"
                                    f"{'s' if len(lines) > 1 else ''} {', '.join(map(str, lines[:12]))}"
                                    f"{', …' if len(lines) > 12 else ''}).", "spaces"))
    found.sort(key=lambda x: x[0])
    return [{"id": f"M{i}", "line": line(x[0]), "pos": x[0], "what": x[1], "fix": x[2] if len(x) > 2 else None}
            for i, x in enumerate(found, 1)]


# ---------------------------------------------------------------- carry-over
# Findings the last review showed and the author has not yet accepted or
# declined go back to the panel, so a point that still applies keeps its wording
# instead of returning reworded as a new one. Each finding keeps a key across
# reviews, and one the new review does not repeat is reported as resolved.

def previous_open(path):
    """Open findings from the newest earlier review of this file:
    [{key, title, quote, seen}]. Accepted, declined, and held findings are left out."""
    runs = runs_for(Path(path).resolve())
    if not runs:
        return []
    r = json.loads((runs[0] / "results.json").read_text())
    decided = {d["title"] for d in load_decisions().get(str(Path(path).resolve()), []) if d.get("run") == runs[0].name}
    return [{"key": g.get("key") or "K" + hashlib.sha256((g["rep"]["title"] + g["rep"]["quote"]).encode()).hexdigest()[:6],
             "title": g["rep"]["title"], "quote": g["rep"]["quote"], "seen": g.get("seen", 1)}
            for _, _, _, g in ordered_findings(r) if g["rep"]["title"] not in decided]


def open_block(prev):
    """Prompt text listing the last review's open findings."""
    if not prev:
        return ""
    return ("\nThese findings from the last review of this draft are still open. If one still applies to "
            "the text as it is now, raise it again with the same title and, where they still fit, the same "
            "wording and diff. Do not reword it as a new point. If the text has changed so that it no longer "
            "applies, leave it out.\n" + "\n".join(
                f"- {p['title']}" + (f" (quote: {p['quote'][:120]})" if p["quote"] else "") for p in prev) + "\n")


def carry_over(groups, prev, dnorm):
    """Give each group the key of the earlier finding it repeats, or a new key,
    and count the reviews it has appeared in. Returns the earlier findings not
    repeated: {"resolved": passage changed, "dropped": passage unchanged}."""
    left = list(prev)
    for g in groups:
        t, q = norm(g["rep"]["title"]), g["rep"]["quote"]
        hit = next((p for p in left if norm(p["title"]) == t), None) or next(
            (p for p in left if q and p["quote"] and quote_overlap(q, p["quote"])), None)
        if hit:
            left.remove(hit)
            g["key"], g["seen"] = hit["key"], hit["seen"] + 1
            if g["rejected"]:
                left.append(hit)  # raised again but voted down: not repeated
        else:
            g["key"] = "K" + hashlib.sha256((g["rep"]["title"] + q).encode()).hexdigest()[:6]
            g["seen"] = 1
    gone = lambda p: p["quote"] and norm(p["quote"])[:60] not in dnorm
    return {"resolved": [p["title"] for p in left if gone(p)],
            "dropped": [p["title"] for p in left if not gone(p)]}


# ---------------------------------------------------------------- churn
# A passage that each round rewrites again, or a change that undoes an earlier
# one, is held back. The history is the reviewed copy each earlier run kept.

def reviewed_history(path, current):
    """Earlier reviewed texts of a file, oldest first, one per version, not
    counting the current text."""
    seen, out = {fingerprint(current)}, []
    for run in reversed(runs_for(Path(path).resolve())):
        copy = run / "reviewed" / Path(path).name
        if copy.exists():
            t = copy.read_text()
            if fingerprint(t) not in seen:
                seen.add(fingerprint(t))
                out.append(t)
    return out


def paragraphs(text):
    return [p for p in re.split(r"\n\s*\n", text) if p.strip()]


def times_changed(para, history):
    """For each step back through the history, newest first, whether this
    paragraph changed in that step. Stops where the paragraph did not exist."""
    out, cur = [], norm(para)
    for older in reversed(history):
        olds = [norm(p) for p in paragraphs(older)]
        if cur in olds:
            out.append(False)
            continue
        best = max(olds, key=lambda p: difflib.SequenceMatcher(None, p, cur, autojunk=False).ratio(), default=None)
        if best is None or difflib.SequenceMatcher(None, best, cur, autojunk=False).ratio() < 0.5:
            break
        out.append(True)
        cur = best
    return out


def sentence_bounds(text, a, b):
    """Start and end of the sentences that text[a:b] touches."""
    starts = [m.end() for m in re.finditer(r"[.!?]\s+|\n", text[:a])]
    m = re.compile(r"[.!?](?=\s|$)|\n").search(text, b)
    return (starts[-1] if starts else 0), (m.end() if m else len(text))


def restores_earlier(text, edits, history):
    """True when applying the edits would bring back a sentence an earlier
    version had, replacing one that version did not have: an undo."""
    s, e = sentence_bounds(text, edits[0][0], edits[-1][1])
    new = text
    for a, b, n in sorted(edits, reverse=True):
        new = new[:a] + n + new[b:]
    before, after = norm(text[s:e]), norm(new[s:e + len(new) - len(text)])
    if len(after) < 20 or before == after:
        return False
    return any(after in norm(t) and before not in norm(t) for t in history)


def churn(g, text, history):
    """Why a finding should be held back to stop churn, or None. A change that
    restores earlier wording is held. On a passage that changed in the last
    step, only Critical and Substantive findings show. On one that changed in
    two of the last three steps, only Critical findings show. Typos always show."""
    if g["where"] != "draft" or not history or is_typo(g):
        return None
    old, new = diff_parts(g["rep"]["body"])
    edits = locate_edits(text, old, new, g["rep"]["quote"]) if old else None
    if edits and restores_earlier(text, edits, history):
        return "it would restore wording from an earlier version"
    anchor = find_span(text, g["rep"]["quote"]) if g["rep"]["quote"] else None
    anchor = anchor or (edits[0][:2] if edits else None)
    if not anchor:
        return None
    para = next((p for p in paragraphs(text) if norm(text[anchor[0]:anchor[1]])[:60] in norm(p)), None)
    steps = times_changed(para, history)[:3] if para else []
    if sum(steps) >= 2 and g["severity"] != "Critical":
        return f"the passage changed in {sum(steps)} of the last {len(steps)} versions"
    if steps[:1] == [True] and g["severity"] == "Polish":
        return "the passage changed since the last review"
    return None



# ---------------------------------------------------------------- review page
# A local page for one reviewed file: the draft with each finding in place, and
# Accept, Edit, Decline, and Update. It runs from `unified-review --serve FILE`.

PAGE_DIR = Path(__file__).resolve().parent.parent / "page"
FONT_DIR = Path(__file__).resolve().parent.parent / "slides" / "theme" / "fonts"
PAGE_IDLE = 8 * 3600  # the server exits after this many seconds without a request
DEL = re.compile(r"\*\*~~(.+?)~~\*\*|~~(.+?)~~", re.S)
ADD = re.compile(r"\*\*🟢\s*(.+?)\*\*|🟢\s*\*\*(.+?)\*\*", re.S)


def diff_parts(body):
    """(old, new) text of a finding's diff, or (None, reason) when it has none
    that can be applied as written."""
    body = strip_end(body)
    paras = body.split("\n\n")[1:]
    fence = re.search(r"```[a-z]*\n(.*?)\n```", body, re.S)
    if fence:
        lines = [l for l in fence.group(1).splitlines() if l.strip()]
        if len(lines) == 2:
            return lines[0], lines[1]
        return None, "the diff is a code block that is not one old and one new line"
    text = "\n\n".join(x for x in paras if "~~" in x or "🟢" in x).strip()
    if not text:
        return None, "the finding has no diff"
    # Removing a marked span takes the space before it too, so "a ~~b~~ 🟢 **c**."
    # gives old "a b." and new "a c.", not "a b ." and "a  c.".
    old = re.sub(r"[ \t]*(?:" + ADD.pattern + ")", "", DEL.sub(lambda m: m.group(1) or m.group(2), text))
    new = re.sub(r"[ \t]*(?:" + DEL.pattern + ")", "", ADD.sub(lambda m: m.group(1) or m.group(2), text))
    # Removing a marked span leaves doubled spaces. In the new text it can also
    # leave a space before punctuation. The old text keeps its punctuation as is.
    spaces = lambda t: re.sub(r"\n{3,}", "\n\n", re.sub(r"[ \t]{2,}", " ", t)).strip()
    old, new = spaces(old), spaces(re.sub(r" +([.,;:])", r"\1", new))
    if re.search(r"\[[^\]@]*(name|key|insert|N\b|M\b)[^\]]*\]", new, re.I):
        return None, "the new text has a placeholder to fill in"
    return old, new


def find_span(text, needle, near=None):
    """(start, end) of needle in text, matching through differences in spacing
    and quote marks. With several matches, the one nearest `near`. None if absent."""
    if not needle.strip():
        return None
    parts = [re.escape(w.translate(QUOTES)) for w in needle.split()]
    pat = r"\s+".join(parts)
    pat = pat.replace("'", "['‘’]").replace('"', '["“”]')
    hits = [(m.start(), m.end()) for m in re.finditer(pat, text)]
    if not hits:
        return None
    return min(hits, key=lambda h: abs(h[0] - near)) if near is not None else hits[0]


def fuzzy_span(text, old, quote_span):
    """Where `old` sits in text when a reviewer misquoted it slightly: the
    passage near the finding's quote that matches it at least 90%."""
    if not quote_span or not old.strip():
        return None
    lo, hi = max(0, quote_span[0] - len(old)), min(len(text), quote_span[1] + len(old))
    region = text[lo:hi]
    blocks = [b for b in difflib.SequenceMatcher(None, region, old, autojunk=False).get_matching_blocks() if b.size]
    if not blocks:
        return None
    s, e = blocks[0].a, blocks[-1].a + blocks[-1].size
    if difflib.SequenceMatcher(None, region[s:e], old, autojunk=False).ratio() < 0.9:
        return None
    return lo + s, lo + e


def change_mark(text, span, old, new):
    """The smallest part of text[span] that a change touches: the words it
    replaces or deletes, or for a pure insertion the word just before it."""
    ow, nw = old.split(), new.split()
    i = 0
    while i < min(len(ow), len(nw)) and ow[i] == nw[i]:
        i += 1
    j = 0
    while j < min(len(ow), len(nw)) - i and ow[-1 - j] == nw[-1 - j]:
        j += 1
    region = ow[i:len(ow) - j]
    if not region:  # insertion: mark the neighboring word
        region = ow[i - 1:i] if i > 0 else ow[:1]
        i = max(i - 1, 0)
    if not region:
        return span
    seg = text[span[0]:span[1]]
    near = len(" ".join(ow[:i])) + (1 if i else 0)  # where the region starts in old
    m = find_span(seg, " ".join(region), near)
    if not m:
        return list(span)
    a, b = span[0] + m[0], span[0] + m[1]
    if b - a < 2:  # one character is too small to click: take in the word before it
        k = text.rfind(" ", span[0], max(a - 1, span[0]))
        a = max(span[0], k + 1 if k >= 0 else span[0])
    return [a, b]


def runs_for(path):
    """Run folders that reviewed exactly this file, newest first."""
    out = []
    for rj in RUNS_DIR.glob("*/results.json"):
        try:
            if json.loads(rj.read_text()).get("files") == [str(path)]:
                out.append(rj.parent)
        except ValueError:
            continue
    return sorted(out, key=lambda d: (d / "results.json").stat().st_mtime, reverse=True)


def vote_tag(g):
    vs = [v["vote"] for m, v in g["votes"].items() if m != g.get("self_voter")]
    agree = sum(v == "agree" for v in vs)
    if vs and agree == len(vs):
        return "Unanimous"
    if g.get("contested"):
        return "Contested"
    return "Majority" if agree * 2 > len(vs) else "No majority"


def reviewed_text(run, path):
    """The text this run reviewed (its copy in reviewed/), or None."""
    f = run / "reviewed" / Path(path).name
    return f.read_text() if f.exists() and not is_pdf(f) else None


def unplaced_reason(text, reviewed, old, new, quote):
    """Why a finding's diff cannot be placed in the current text: its new text is
    already there, the reviewer misquoted the draft, or the passage changed."""
    new = clean_markup(new)
    if new.strip() and (find_span(text, new) or locate_edits(text, new, new, quote)):
        return "this change is already in the file. Mark it done to record it"
    if reviewed is not None and not locate_edits(reviewed, old, new, quote):
        return "the reviewer quoted text that is not in the draft as reviewed, so the change cannot be placed. Apply it by hand, then mark it done"
    now = closest_sentence(text, old)
    if now:
        return f"its passage changed after this review, and now reads: \"{now}\" If that already fixes it, mark it done"
    return "its passage changed after this review. If you already fixed it, mark it done"


def closest_sentence(text, old):
    """The current sentence most like old, if one is close (ratio 0.6 or more)."""
    import difflib
    old = ELLIPSIS.sub(" ", old).strip()
    best, score = None, 0.6
    for s in re.split(r"(?<=[.!?])\s+|\n+", text):
        r = difflib.SequenceMatcher(None, old, s.strip()).ratio()
        if r >= score:
            best, score = s.strip(), r
    return best


def page_state(path, run):
    """Everything the page shows: the current text and each finding in place."""
    r = json.loads((run / "results.json").read_text())
    text = Path(path).read_text()
    labels = r["labels"]
    decided, earlier = {}, {}
    for d in load_decisions().get(str(path), []):
        if d.get("run") == run.name:
            decided[d["title"]] = d
        elif d.get("quote") and d.get("decision") in ("applied", "ignore"):
            earlier[" ".join(d["quote"].split())] = d  # newest decision on a sentence wins
    out = []
    for n, sev, where_label, g in ordered_findings(r):
        rep = g["rep"]
        old, new = diff_parts(rep["body"])
        reason = None if old is not None else new
        quote_span = find_span(text, rep["quote"]) if rep["quote"] else None
        edits = locate_edits(text, old, new, rep["quote"]) if old else None
        span = (edits[0][0], edits[-1][1]) if edits else None
        if old is not None and span is None:
            reason = unplaced_reason(text, reviewed_text(run, path), old, new, rep["quote"])
        d = decided.get(rep["title"])
        if d is None and span is None and rep["quote"]:
            # The same sentence was accepted or declined from an earlier review: that settles it.
            e = earlier.get(" ".join(rep["quote"].split()))
            if e:
                when = re.match(r"(\d{4}-\d\d-\d\d)-(\d\d)(\d\d)", e.get("run", ""))
                at = f"the {when.group(2)}:{when.group(3)} review" if when else "an earlier review"
                if when and when.group(1) != run.name[:10]:
                    at += f" of {when.group(1)}"
                verb = "accepted" if e["decision"] == "applied" else "declined"
                d = {"decision": e["decision"], "note": f"Done: {verb} in {at} as \u201c{e['title']}\u201d"}
        if d is None and reason and reason.startswith("this change is already in the file"):
            d = {"decision": "applied", "note": "Done: the change is already in the file"}
        out.append({
            "n": n, "severity": sev, "kind": g.get("kind", ""), "section": where_label, "title": rep["title"], "where": g["where"],
            "point": strip_end(rep["body"]).split("\n\n")[0], "body": strip_end(rep["body"]), "quote": rep["quote"],
            "old": old, "new": new if old is not None else None, "reason": reason,
            "span": list(span or quote_span or []) or None, "applicable": span is not None,
            "changed": old is not None and span is None,
            "mark": (change_mark(text, span, old, new) if len(edits) == 1
                     else [edits[0][0], edits[0][1]]) if span else None,
            "tag": vote_tag(g), "seen": g.get("seen", 1),
            "votes": [{"model": labels.get(m, m).split()[0], "vote": v["vote"], "raised": m in g["raised_by"]}
                      for m, v in g["votes"].items()],
            "status": {"applied": "accepted", "ignore": "declined"}.get(d["decision"]) if d else None,
            "note": d.get("note", "") if d else ""})
    qs = load_questions(run)
    for f in out:
        f["questions"] = qs.get(str(f["n"]), [])
        for q in f["questions"]:
            for m, a in q["answers"].items():
                if m not in labels:
                    labels[m] = label(panelist(m))
                if a.get("old"):  # re-check against the text as it is now
                    a["applicable"] = (find_span(text, a["old"]) is not None or fuzzy_span(
                        text, a["old"], find_span(text, a["old"][:40])) is not None)
                    a["applied"] = not a["applicable"] and find_span(text, a["new"]) is not None
                a["model"] = labels[m] if ":" in m else labels.get(m, m).split()[0]
                a["raised"] = m in next(g for n, _, _, g in ordered_findings(r) if n == f["n"])["raised_by"]
    vers = (r.get("versions") or [{}])[0]
    return {"file": str(path), "name": Path(path).name, "run": run.name, "version": vers.get("number"),
            "edited": bool(vers.get("version")) and fingerprint(text) != vers.get("version"),
            "chosen": [{"spec": m, "label": label(panelist(m))} for m in page_panel(path)],
            "comments": comment_state(run, text), "checks": checks(text, path),
            "started": r.get("started", ""), "panel": [labels.get(m, m) for m in r["reviewers_ok"]],
            "failures": r.get("failures", []), "text": text, "findings": out}


ELLIPSIS = re.compile(r"\s*(?:\.\.\.|…)\s*")


def locate_edits(text, old, new, quote=""):
    """Where a change applies: [(start, end, new text)], or None if any part is
    missing. A diff that skips text with an ellipsis becomes one edit per part,
    found in order, and applies only when every part is found."""
    quote_span = find_span(text, quote) if quote else None
    near = quote_span[0] if quote_span else None
    span = find_span(text, old, near) or (fuzzy_span(text, old, quote_span) if not ELLIPSIS.search(old) else None)
    if span:
        return [(span[0], span[1], new)]
    olds, news = ELLIPSIS.split(old), ELLIPSIS.split(new)
    if len(olds) < 2 or len(olds) != len(news):
        return None
    edits, pos = [], None
    for o, n in zip(olds, news):
        if not o.strip():
            continue
        if pos is None:  # the first part: anywhere, nearest the finding's quote
            sp = find_span(text, o, near)
        else:  # later parts: after the one before
            sp = find_span(text[pos:], o, 0)
            sp = (pos + sp[0], pos + sp[1]) if sp else None
        if sp is None:
            return None
        if o != n:
            edits.append((sp[0], sp[1], n))
        pos = sp[1]
    return edits or None


FINDING_MARK = re.compile(r"\s*=+[ \t]*(?:END[ \t]*(?:OF[ \t]*)?)?FINDING[ \t]*=*[ \t]*", re.I)


def clean_markup(text):
    """Review markup out of text bound for the draft: '=== FINDING' and '=== END
    FINDING' markers, struck ~~deletions~~, and 🟢 addition marks, keeping the
    added words. A marker between words becomes one space."""
    out = FINDING_MARK.sub(lambda m: " " if m.start() and m.end() < len(m.string)
                           and not m.string[m.end()].isspace() else "", text)
    out = DEL.sub("", ADD.sub(lambda m: m.group(1) or m.group(2), out)).replace("🟢", "")
    if out == text:
        return text
    out = re.sub(r"(?<=\S)[ \t]{2,}(?=\S)", " ", out)
    # A removed mark at either end must not leave a space at the seam.
    out = out if text[:1].isspace() else out.lstrip(" \t")
    return out if text[-1:].isspace() else out.rstrip(" \t")


def apply_change(path, old, new, quote=""):
    """Replace old with new in the file. Re-reads the file first, so edits made
    since the page loaded are kept. Returns an error message or None."""
    text = Path(path).read_text()
    edits = locate_edits(text, old, new, quote)
    if not edits:
        return "the text this change targets is no longer in the file"
    for a, b, n in sorted(edits, reverse=True):  # from the end, so earlier offsets hold
        text = text[:a] + clean_markup(n) + text[b:]
    Path(path).write_text(text)
    return None


ASK = """The author of the draft below is asking about one finding from a review
of it. You are one of several reviewers answering in parallel. Answer the
question directly, in at most six sentences, against the draft as it stands
now. You have no web access. Follow the house rules for any wording you propose.

End with one line that starts with "REVISED:". If your answer changes the
proposed edit, follow it with the revised passage as an inline diff of the
current text: strike deletions with ~~tildes~~ and mark additions as
🟢 **added text**, leaving unchanged words plain. Otherwise write "REVISED: none".

<finding>
{finding}
</finding>
{thread}
<question>
{question}
</question>

<draft>
{draft}
</draft>

---- HOUSE RULES ----
{rules}"""
ASK_LOCK = threading.Lock()


def failure_reason(run, stem):
    """The last line of a failed call's error log, which usually names the cause."""
    err = run / f"{stem}.err"
    lines = [l.strip() for l in err.read_text().splitlines() if l.strip()] if err.exists() else []
    return lines[-1][:200] if lines else "no reply"


def load_questions(run):
    f = run / "questions.json"
    return json.loads(f.read_text()) if f.exists() else {}


def save_question(run, n, k, model, answer):
    """Store one model's answer to question k on finding n."""
    with ASK_LOCK:
        qs = load_questions(run)
        qs[str(n)][k]["answers"][model] = answer
        write_atomic(run / "questions.json", json.dumps(qs, indent=1, ensure_ascii=False) + "\n")


def parse_answer(text, current):
    """(answer, revised old, revised new, applicable) from a model's reply."""
    text = (text or "").strip()
    head, _, rev = text.rpartition("REVISED:") if "REVISED:" in text else (text, "", "")
    rev = rev.strip()
    if not rev or rev.lower().startswith("none"):
        return head.strip(), None, None, False
    old, new = diff_parts("point\n\n" + rev)
    ok = old is not None and (find_span(current, old) is not None
                              or fuzzy_span(current, old, find_span(current, old[:40])) is not None)
    return head.strip(), old, new, ok


def ask_panel(path, run, f, question):
    """Ask every panelist from the run about finding f, in parallel, in the
    background. Answers land in questions.json as each model finishes."""
    r = json.loads((run / "results.json").read_text())
    panel = [panelist(m) for m in page_panel(path)]
    with ASK_LOCK:
        qs = load_questions(run)
        thread = qs.setdefault(str(f["n"]), [])
        k = len(thread)
        thread.append({"question": question, "asked": time.strftime("%Y-%m-%d %H:%M"),
                       "answers": {m: {"status": "pending"} for m in panel}})
        write_atomic(run / "questions.json", json.dumps(qs, indent=1, ensure_ascii=False) + "\n")
    earlier = "".join(f"\n<earlier_question>{q['question']}</earlier_question>\n" + "".join(
        f"<answer model=\"{short(m)}\">{a.get('text', '')}</answer>\n" for m, a in q["answers"].items()
        if a.get("status") == "done") for q in thread[:k])
    votes = ", ".join(f"{v['model']} {v['vote']}" for v in f["votes"])
    finding = f"{f['severity']}: {f['title']}\n{f['body']}\nVotes: {votes}"
    rules, _ = load_rules(None)
    prompt = ASK.format(finding=finding, thread=earlier, question=question,
                        draft=Path(path).read_text(), rules=rules)

    def one(m):
        t = time.time()
        text = call(m, prompt, run / f"ask-{f['n']}-{k}-{m}.txt", Path(path).parent, stage="ask")
        if text is None:
            save_question(run, f["n"], k, m, {"status": "failed", "seconds": round(time.time() - t),
                                              "reason": failure_reason(run, f"ask-{f['n']}-{k}-{m}")})
            return
        answer, old, new, ok = parse_answer(text, Path(path).read_text())
        save_question(run, f["n"], k, m, {"status": "done", "text": answer, "old": old, "new": new,
                                          "applicable": ok, "seconds": round(time.time() - t)})
    threading.Thread(target=lambda: parallel(one, panel), daemon=True).start()


COMMENT = """The author of the draft below has a general comment, question, or request
about it. You are one of several reviewers answering in parallel. Answer
directly, in at most eight sentences, against the draft as it stands now. You
have no web access. Follow the house rules for any wording you propose.

End with a line that is exactly "CHANGES:". If you propose edits, follow it
with each edit as its own paragraph: the passage from the current draft as an
inline diff, with deletions struck as ~~tildes~~ and additions marked as
🟢 **added text**, leaving unchanged words plain. Copy unchanged words exactly.
Otherwise write "CHANGES: none".
{thread}
<comment>
{comment}
</comment>

<draft>
{draft}
</draft>

---- HOUSE RULES ----
{rules}"""


def load_comments(run):
    f = run / "comments.json"
    return json.loads(f.read_text()) if f.exists() else []


def parse_changes(text, current):
    """(answer, [{old, new, applicable}]) from a reply to a general comment."""
    text = (text or "").strip()
    head, _, tail = text.rpartition("CHANGES:") if "CHANGES:" in text else (text, "", "")
    changes = []
    if tail.strip() and not tail.strip().lower().startswith("none"):
        for para in re.split(r"\n\s*\n", tail.strip()):
            old, new = diff_parts("point\n\n" + para)
            if old is None:
                continue
            ok = find_span(current, old) is not None or fuzzy_span(current, old, find_span(current, old[:40])) is not None
            changes.append({"old": old, "new": new, "applicable": ok})
    return head.strip(), changes


def comment_state(run, text):
    """Comments with their answers, each proposed change re-checked against the text now."""
    r = json.loads((run / "results.json").read_text())
    labels = r["labels"]
    out = load_comments(run)
    for c in out:
        for m, a in c["answers"].items():
            a["model"] = labels[m].split()[0] if m in labels else label(panelist(m))
            for ch in a.get("changes", []):
                ch["applicable"] = (find_span(text, ch["old"]) is not None or fuzzy_span(
                    text, ch["old"], find_span(text, ch["old"][:40])) is not None)
                ch["applied"] = not ch["applicable"] and find_span(text, ch["new"]) is not None
    return out


def comment_panel(path, run, comment, focus):
    """Send a general comment to every panelist in parallel, in the background."""
    panel = [panelist(m) for m in page_panel(path)]
    with ASK_LOCK:
        cs = load_comments(run)
        k = len(cs)
        cs.append({"comment": comment, "focus": bool(focus), "asked": time.strftime("%Y-%m-%d %H:%M"),
                   "answers": {m: {"status": "pending"} for m in panel}})
        write_atomic(run / "comments.json", json.dumps(cs, indent=1, ensure_ascii=False) + "\n")
    thread = "".join(f"\n<earlier_comment>{c['comment']}</earlier_comment>\n" + "".join(
        f"<answer model=\"{short(m)}\">{a.get('text', '')}</answer>\n" for m, a in c["answers"].items()
        if a.get("status") == "done") for c in cs[:k])
    rules, _ = load_rules(None)
    prompt = COMMENT.format(thread=thread, comment=comment, draft=Path(path).read_text(), rules=rules)

    def one(m):
        t = time.time()
        text = call(m, prompt, run / f"comment-{k}-{m}.txt", Path(path).parent, stage="comment")
        if text is None:
            ans = {"status": "failed", "seconds": round(time.time() - t), "reason": failure_reason(run, f"comment-{k}-{m}")}
        else:
            answer, changes = parse_changes(text, Path(path).read_text())
            ans = {"status": "done", "text": answer, "changes": changes, "seconds": round(time.time() - t)}
        with ASK_LOCK:
            cs2 = load_comments(run)
            cs2[k]["answers"][m] = ans
            write_atomic(run / "comments.json", json.dumps(cs2, indent=1, ensure_ascii=False) + "\n")
    threading.Thread(target=lambda: parallel(one, panel), daemon=True).start()


DEFAULT_PANEL = ["claude", "gpt", "gemini"]
LABS = [("Anthropic", r"claude"), ("OpenAI", r"gpt|o\d|codex"), ("Google", r"gemini|gemma"),
        ("xAI", r"grok|cursor-grok"), ("Moonshot", r"kimi"), ("Z.ai", r"glm"), ("DeepSeek", r"deepseek"),
        ("Alibaba", r"qwen"), ("Meta", r"muse|llama"), ("Cursor", r"composer|auto")]
EFFORTS = ["none", "minimal", "low", "medium", "high", "xhigh", "extra-high", "max"]
EFFORT_LABEL = {"xhigh": "Extra high", "extra-high": "Extra high"}
MODEL_ORDER = ["Opus", "Fable", "Sonnet", "Haiku", "Luna", "Sol", "Terra", "GPT", "Codex", "Pro", "Flash"]


def parse_model_id(mid):
    """(model, version, setting) for a cursor-agent model id, e.g.
    claude-opus-5-5-thinking-high-fast -> ("Opus", "5.5", "High, thinking, fast")."""
    t = mid.split("-")
    if t[0] == "cursor":
        t = t[1:]
    fast, thinking = "fast" in t, "thinking" in t
    t = [x for x in t if x not in ("fast", "thinking")]
    effort = ""
    if len(t) > 2 and "-".join(t[-2:]) == "extra-high":
        effort, t = "extra-high", t[:-2]
    elif len(t) > 1 and t[-1] in EFFORTS:
        effort, t = t[-1], t[:-1]
    head = t[0]
    if head == "claude" and len(t) > 1:  # claude-opus-5-5 or the older claude-4.6-opus
        words = [x for x in t[1:] if not re.fullmatch(r"\d+(\.\d+)?", x)]
        nums = [x for x in t[1:] if re.fullmatch(r"\d+(\.\d+)?", x)]
        model, version = (words[0].capitalize() if words else "Claude"), ".".join(nums)
    elif head == "gpt" and len(t) > 1:
        model, version = (t[2].capitalize() if len(t) > 2 else "GPT"), t[1]
    elif head == "gemini" and len(t) > 1:
        model, version = " ".join(x.capitalize() for x in t[2:]) or "Gemini", t[1]
    elif head == "grok":
        model, version = "Grok", ".".join(t[1:])
    elif head == "kimi":
        model, version = "Kimi", " ".join(x.upper() if x[0] == "k" else x for x in t[1:])
    elif head == "glm":
        model, version = "GLM", ".".join(t[1:])
    else:
        model, version = head.capitalize(), " ".join(t[1:])
    setting = EFFORT_LABEL.get(effort, effort.capitalize()) if effort else "Default"
    setting += ", thinking" if thinking else ""
    setting += ", fast" if fast else ""
    key = (EFFORTS.index(effort) if effort else -1, thinking, fast)
    return model, version or "Default", setting, key


def version_key(v):
    nums = [float(x) for x in re.findall(r"\d+(?:\.\d+)?", v)]
    return [-n for n in nums] or [0]


def model_menu():
    """The Add menu: lab > model > version > setting. [{lab, models: [{model,
    versions: [{version, items: [{spec, label}]}]}]}]. The models Claude Code and
    Codex run directly come first, as the top version of their model."""
    tree = {name: {} for name, _ in LABS + [("Other", "")]}
    for m, n in CLAUDE_MODELS.items():
        tree["Anthropic"].setdefault(n, {})["Latest, via Claude Code"] = [((-2, 0, 0), {"spec": "claude:" + m, "label": "Default"})]
    for m, n in CODEX_MODELS.items():
        model = n.split()[-1]
        tree["OpenAI"].setdefault(model, {})[m.split("-")[1] + ", via Codex"] = [
            ((EFFORTS.index(e), 0, 0), {"spec": f"codex:{m}@{e}", "label": e.capitalize()}) for e in ("low", "medium", "high")]
    for mid in cursor_models():
        lab = next((n for n, pat in LABS if re.match(pat, mid)), "Other")
        model, version, setting, key = parse_model_id(mid)
        tree[lab].setdefault(model, {}).setdefault(version, []).append((key, {"spec": "cursor:" + mid, "label": setting}))
    order = lambda m: (MODEL_ORDER.index(m) if m in MODEL_ORDER else len(MODEL_ORDER), m)
    vorder = lambda v: (0 if "via" in v else 1, version_key(v))
    return [{"lab": lab, "models": [
                {"model": m, "versions": [{"version": v, "items": [i for _, i in sorted(items, key=lambda x: x[0])]}
                                          for v, items in sorted(tree[lab][m].items(), key=lambda kv: vorder(kv[0]))]}
                for m in sorted(tree[lab], key=order)]}
            for lab in tree if tree[lab]]


def page_panel(path):
    """The panel chosen on the page for this file, else the default."""
    f = RUNS_DIR / "page-panels.json"
    chosen = json.loads(f.read_text()).get(str(path)) if f.exists() else None
    return chosen or list(DEFAULT_PANEL)


def edit_block(path, old, new, start=None):
    """Replace one paragraph the user edited on the page. The paragraph must
    still read as it did when the page loaded. Returns an error or None."""
    text = Path(path).read_text()
    if not old.strip():
        return "nothing to replace"
    if start is not None and text[start:start + len(old)] == old:
        at = start
    elif text.count(old) == 1:
        at = text.index(old)
    else:
        return "this paragraph changed in the file since the page loaded. Reload the page and edit again"
    Path(path).write_text(text[:at] + clean_markup(new.rstrip("\n")) + text[at + len(old):])
    return None


class PageServer:
    def __init__(self, path):
        self.path = Path(path).resolve()
        self.job = None  # the running Update, if any
        self.last = time.time()

    def run_folder(self):
        runs = runs_for(self.path)
        if not runs:
            raise LookupError(f"no review of {self.path} yet")
        return runs[0]

    def handle(self, method, route, body):
        self.last = time.time()
        if method == "GET" and route == "/api/state":
            st = page_state(self.path, self.run_folder())
            st["job"] = self.job_state()
            return 200, "application/json", json.dumps(st)
        if method == "GET" and route == "/api/ping":
            return 200, "application/json", json.dumps({"file": str(self.path)})
        if method == "POST" and route in ("/api/accept", "/api/decline", "/api/done"):
            run = self.run_folder()
            st = page_state(self.path, run)
            f = next((f for f in st["findings"] if f["n"] == body.get("n")), None)
            if not f:
                return 404, "application/json", json.dumps({"error": "no such finding"})
            if route == "/api/accept":
                old = body.get("old", f["old"])
                new = body.get("text", f["new"])
                if old is None:
                    return 409, "application/json", json.dumps({"error": f["reason"]})
                err = apply_change(self.path, old, new, f["quote"])
                if err:
                    return 409, "application/json", json.dumps({"error": err})
                with contextlib.redirect_stdout(io.StringIO()):
                    record_decisions(str(f["n"]), "applied", body.get("note", ""), run)
            elif route == "/api/done":  # fixed by hand: record it as applied, write nothing
                with contextlib.redirect_stdout(io.StringIO()):
                    record_decisions(str(f["n"]), "applied", "fixed by hand", run)
            else:
                with contextlib.redirect_stdout(io.StringIO()):
                    record_decisions(str(f["n"]), "ignore", body.get("note", ""), run)
            return 200, "application/json", json.dumps({"ok": True})
        if method == "POST" and route == "/api/fix":  # a mechanical fix from Checks
            if body.get("fix") != "spaces":
                return 400, "application/json", json.dumps({"error": "no such fix"})
            text = self.path.read_text()
            self.path.write_text(fix_double_spaces(text))
            return 200, "application/json", json.dumps({"ok": True})
        if method == "POST" and route == "/api/ask":
            run = self.run_folder()
            f = next((f for f in page_state(self.path, run)["findings"] if f["n"] == body.get("n")), None)
            if not f or not body.get("question", "").strip():
                return 400, "application/json", json.dumps({"error": "no finding or no question"})
            ask_panel(self.path, run, f, body["question"].strip())
            return 200, "application/json", json.dumps({"ok": True})
        if method == "GET" and route == "/api/models":
            return 200, "application/json", json.dumps(model_menu())
        if method == "POST" and route == "/api/panel":
            try:
                chosen = [panelist(m) for m in body.get("panel", [])] or list(DEFAULT_PANEL)
            except ValueError as e:
                return 400, "application/json", json.dumps({"error": str(e)})
            f = RUNS_DIR / "page-panels.json"
            pages = json.loads(f.read_text()) if f.exists() else {}
            pages[str(self.path)] = chosen
            write_atomic(f, json.dumps(pages, indent=1) + "\n")
            return 200, "application/json", json.dumps({"ok": True})
        if method == "POST" and route == "/api/comment":
            if not body.get("text", "").strip():
                return 400, "application/json", json.dumps({"error": "empty comment"})
            comment_panel(self.path, self.run_folder(), body["text"].strip(), body.get("focus"))
            return 200, "application/json", json.dumps({"ok": True})
        if method == "POST" and route == "/api/change":
            err = apply_change(self.path, body.get("old", ""), body.get("new", ""))
            if err:
                return 409, "application/json", json.dumps({"error": err})
            return 200, "application/json", json.dumps({"ok": True})
        if method == "POST" and route == "/api/edit":
            err = edit_block(self.path, body.get("old", ""), body.get("new", ""), body.get("start"))
            if err:
                return 409, "application/json", json.dumps({"error": err})
            return 200, "application/json", json.dumps({"ok": True})
        if method == "POST" and route == "/api/update":
            if not self.job or self.job.poll() is not None:
                env = {**os.environ, "UNIFIED_REVIEW_NO_PAGE": "1"}
                log_file = open(RUNS_DIR / "page-update.log", "w")
                focus = "\n".join(c["comment"] for c in load_comments(self.run_folder()) if c.get("focus"))
                self.job = subprocess.Popen([sys.executable, os.path.abspath(__file__), str(self.path),
                                             "-p", ",".join(page_panel(self.path))]
                                            + (["-n", focus] if focus else []),
                                            cwd=str(self.path.parent), env=env, stdin=subprocess.DEVNULL,
                                            stdout=log_file, stderr=log_file)
            return 200, "application/json", json.dumps({"job": self.job_state()})
        if method == "GET" and route in ("/", "/index.html"):
            return 200, "text/html; charset=utf-8", (PAGE_DIR / "review.html").read_text()
        if method == "GET" and route.startswith("/fonts/"):
            f = FONT_DIR / Path(route).name
            if f.suffix == ".woff2" and f.exists():
                return 200, "font/woff2", f.read_bytes()
        return 404, "text/plain", "not found"

    def job_state(self):
        if not self.job:
            return None
        code = self.job.poll()
        return {"running": code is None, "ok": code == 0 if code is not None else None}


def serve(path):
    """Serve the review page for one file on a free local port, and record the
    port so later reviews of the file reuse this server."""
    import http.server
    page = PageServer(path)

    class Handler(http.server.BaseHTTPRequestHandler):
        def log_message(self, *a):
            pass

        def reply(self, method):
            n = int(self.headers.get("Content-Length") or 0)
            try:
                body = json.loads(self.rfile.read(n) or b"{}") if method == "POST" else {}
                code, ctype, data = page.handle(method, self.path.split("?")[0], body)
            except Exception as e:  # report to the page, keep serving
                code, ctype, data = 500, "application/json", json.dumps({"error": str(e)})
            data = data.encode() if isinstance(data, str) else data
            self.send_response(code)
            self.send_header("Content-Type", ctype)
            self.send_header("Content-Length", str(len(data)))
            self.send_header("Cache-Control", "no-store")
            self.end_headers()
            self.wfile.write(data)

        def do_GET(self):
            self.reply("GET")

        def do_POST(self):
            self.reply("POST")

    try:  # a fixed port keeps one forwarded URL in a codespace; fall back if it is taken
        httpd = http.server.ThreadingHTTPServer(("127.0.0.1", int(os.environ.get("UNIFIED_REVIEW_PORT") or 0)), Handler)
    except OSError:
        httpd = http.server.ThreadingHTTPServer(("127.0.0.1", 0), Handler)
    pages = json.loads((RUNS_DIR / "pages.json").read_text()) if (RUNS_DIR / "pages.json").exists() else {}
    pages[str(page.path)] = {"port": httpd.server_address[1], "pid": os.getpid()}
    write_atomic(RUNS_DIR / "pages.json", json.dumps(pages, indent=1) + "\n")
    httpd.timeout = 60
    while time.time() - page.last < PAGE_IDLE:
        httpd.handle_request()


def page_url(path):
    """URL of a live page server for this file, starting one if needed. None
    if it does not come up."""
    import urllib.request
    path = Path(path).resolve()
    pf = RUNS_DIR / "pages.json"
    for attempt in range(2):
        pages = json.loads(pf.read_text()) if pf.exists() else {}
        entry = pages.get(str(path))
        if entry:
            url = f"http://127.0.0.1:{entry['port']}/"
            try:
                with urllib.request.urlopen(url + "api/ping", timeout=2) as resp:
                    if json.load(resp).get("file") == str(path):
                        return url
            except (OSError, ValueError):
                pass
        if attempt == 0:
            subprocess.Popen([sys.executable, os.path.abspath(__file__), "--serve", str(path)],
                             stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                             start_new_session=True)
            for _ in range(50):  # up to 5 s for the server to record its port
                time.sleep(0.1)
                if pf.exists() and json.loads(pf.read_text()).get(str(path), {}) != (entry or {}):
                    break
    return None


def public_url(url):
    """The address a browser should use for a local page URL: in a codespace, the
    port's forwarded https address (private to the codespace's owner)."""
    name, domain = os.environ.get("CODESPACE_NAME"), os.environ.get("GITHUB_CODESPACES_PORT_FORWARDING_DOMAIN")
    if not (name and domain):
        return url
    port = url.rstrip("/").rsplit(":", 1)[1]
    return f"https://{name}-{port}.{domain}/"


def open_page(path):
    """Open the review page in the browser. Returns False if it could not start."""
    url = page_url(path)
    if not url:
        return False
    url = public_url(url)
    if sys.platform == "darwin":
        cmd = ["open", url]
    else:  # Codespaces sets $BROWSER to open URLs in the user's own browser
        opener = shlex.split(os.environ.get("BROWSER", "")) or ([shutil.which("xdg-open")] if shutil.which("xdg-open") else [])
        cmd = opener + [url] if opener else None
    if cmd:
        subprocess.run(cmd, stderr=subprocess.DEVNULL, env=CHILD_ENV)
    print(f"Review page: {url}", flush=True)
    return True


# ---------------------------------------------------------------- main

RULES_SECTION = "# Writing and review guidelines"


REVIEW_SKILLS = ["logic", "statistics", "figures", "documents"]  # their rules apply to drafts under review


def with_figure_rules(rules):
    """Reviews also check figures, captions, equations, citations, and tables,
    whose rules live in skills rather than in CLAUDE.md."""
    for name in REVIEW_SKILLS:
        skill = Path(__file__).resolve().parent.parent / "skills" / name / "SKILL.md"
        if skill.exists():
            rules += "\n\n" + re.sub(r"\A---\n.*?\n---\n", "", skill.read_text(), flags=re.S)
    return rules


def load_rules(path):
    """Review rules, first found: --rules FILE, $UNIFIED_REVIEW_RULES, the
    '# Writing and review guidelines' section of ~/.claude/CLAUDE.md (or
    $CLAUDE_MD), else that section of the CLAUDE.md shipped with this tool."""
    for p in [path, os.environ.get("UNIFIED_REVIEW_RULES")]:
        if p:
            return Path(p).read_text(), p
    for md in [Path(os.environ.get("CLAUDE_MD", Path.home() / ".claude/CLAUDE.md")),
               Path(__file__).resolve().parent.parent / "CLAUDE.md"]:
        if md.exists():
            text = md.read_text()
            k = text.find(RULES_SECTION)
            if k >= 0:
                return text[k:], f"{md} ({RULES_SECTION})"
    sys.exit(f"error: no review rules found. Pass --rules FILE, or add a '{RULES_SECTION}' section to CLAUDE.md")


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("files", nargs="*")
    ap.add_argument("-o", dest="outdir")
    ap.add_argument("-n", dest="focus", default="")
    ap.add_argument("--context", action="append", default=[], metavar="FILE",
                    help="supporting material the panel reads but does not review (text or PDF, repeatable)")
    ap.add_argument("-p", dest="panel", default="claude,gpt,gemini")
    ap.add_argument("--verify", action="store_true")
    ap.add_argument("--rules", metavar="FILE", help="review rules to give the panel (see README)")
    ap.add_argument("--item", metavar="N[,N,K..]",
                    help="print findings or fact-check claims from a run, to act on them")
    ap.add_argument("--ignore", metavar="N[,N..]", help="record that you declined these findings")
    ap.add_argument("--applied", metavar="N[,N..]", help="record that you applied these findings")
    ap.add_argument("--unignore", metavar="D[,D..]", help="lift past declines (D ids)")
    ap.add_argument("--decisions", action="store_true",
                    help="list recorded decisions for files under the current folder")
    ap.add_argument("--note", default="", help="your reason, stored with --ignore or --applied")
    ap.add_argument("--run", metavar="DIR",
                    help="run folder for --item (default: newest run for files in this folder)")
    ap.add_argument("--snapshot", action="store_true",
                    help="save a copy of FILE beside it named by its version (memo-v8.md)")
    ap.add_argument("--changes", metavar="N",
                    help="write and open what changed in FILE since saved version N")
    ap.add_argument("--page", action="store_true",
                    help="open the review page for FILE's newest review (or the newest review here)")
    ap.add_argument("--serve", metavar="FILE", help=argparse.SUPPRESS)
    ap.add_argument("--factcheck-only", action="store_true", help=argparse.SUPPRESS)
    a = ap.parse_args()
    if a.decisions:
        show_decisions(str(Path.cwd().resolve()))
        return
    for flag, kind in (("ignore", "ignore"), ("applied", "applied"), ("unignore", "lifted")):
        if getattr(a, flag):
            record_decisions(getattr(a, flag), kind, a.note,
                             None if kind == "lifted" else (Path(a.run) if a.run else latest_run()))
            return
    if a.item:
        show_items(a.item, Path(a.run) if a.run else latest_run())
        return
    if a.serve:
        serve(a.serve)
        return
    if a.page:
        target = Path(a.files[0]).resolve() if a.files else Path(json.loads(
            (latest_run() / "results.json").read_text())["files"][0])
        if not open_page(target):
            sys.exit("error: the review page did not start")
        return
    if a.snapshot or a.changes:
        if len(a.files) != 1:
            ap.error("--snapshot and --changes take one FILE")
        out = snapshot(a.files[0]) if a.snapshot else write_changes(a.files[0], a.changes)
        print(out)
        if a.changes:
            open_file(out)
        return
    if not a.files:
        ap.error("give at least one FILE to review")

    panel = [m.strip() for m in a.panel.split(",") if m.strip()]
    try:
        panel = [panelist(m) for m in panel]
    except ValueError as e:
        sys.exit(f"error: {e}")
    bad = [m for m in panel if m not in PANELISTS]
    if bad:
        sys.exit(f"error: unknown panelist(s) {bad}; known: {', '.join(PANELISTS)}")
    for m in [m for m in panel if not available(m)]:
        fail("preflight", m, f"{PANELISTS[m][0]} command not found. Set {PANELISTS[m][0].upper()}_BIN to its path")
    panel = [m for m in panel if available(m)]
    if not panel:
        sys.exit("error: no panelist CLIs found")
    if not a.factcheck_only:
        wanted = len(panel)
        panel = preflight(panel)
        if len(panel) < wanted and STANDIN not in panel and available(STANDIN) and preflight([STANDIN]):
            log(f"{STANDIN} stands in for the panelist that is not available")
            panel.append(STANDIN)
        if not panel:
            sys.exit("error: no panelist is logged in")

    files = []
    for f in a.files:
        p = Path(f).resolve()
        if not p.is_file():
            sys.exit(f"error: no such file: {f}")
        files.append(p)
    workdir = files[0].parent
    texts = [doc_text(p) for p in files]  # read once: this is the version reviewed
    draft = "\n\n".join(f"===== {p.name} =====\n{t}" for p, t in zip(files, texts))
    # A PDF goes to the panel as its text, unless the text would miss images or
    # equations. Then the panel opens the PDF itself.
    direct = {p for p in files if is_pdf(p) and pdf_extras(p)}
    shown = "\n\n".join(f"===== {p.name} =====\n" + (PDF_NOTE.format(path=p) if p in direct else t)
                        for p, t in zip(files, texts))
    global READ_FILES
    READ_FILES = bool(direct)
    for p in direct:
        log(f"{p.name}: has {' and '.join(pdf_extras(p))}, so the panel reads the PDF itself")
    numbers = [None] * len(files)
    if a.outdir:
        outdir = Path(a.outdir).resolve()
    else:
        # Name runs <date>-<time>-<project>-<file>-v<N>, with -run2, -run3 within the same minute.
        numbers = [version_number(p, fingerprint(t)) for p, t in zip(files, texts)]
        # A date-time prefix sorts runs by when they were made.
        base = RUNS_DIR / f"{time.strftime('%Y-%m-%d-%H%M')}-{project_name(workdir)}-{files[0].stem}-v{numbers[0]}"
        outdir, k = base, 1
        while outdir.exists():
            k += 1
            outdir = base.with_name(f"{base.name}-run{k}")
    outdir.mkdir(parents=True, exist_ok=True)

    if a.factcheck_only:
        PANELISTS.update(FACTCHECK_PANELISTS)
        background(files, draft, panel, outdir, workdir, shown)
        return

    rules, source = load_rules(a.rules)
    rules = with_figure_rules(rules)
    log(f"review rules: {source}")
    log(f"output -> {outdir}")

    if a.verify:
        # Start the fact-check first, detached, so it outlives this process.
        with open(outdir / "factcheck.log", "w") as fl:
            subprocess.Popen([sys.executable, os.path.abspath(__file__), "--factcheck-only",
                              "-p", ",".join(panel), "-o", str(outdir)] + [str(p) for p in files],
                             stdin=subprocess.DEVNULL, stdout=fl, stderr=fl, start_new_session=True)
        log("fact-check started in the background")

    t = time.time()
    versions = [file_version(p, t, outdir, n) for p, t, n in zip(files, texts, numbers)]
    context = load_context(a.context) if a.context else None
    unified = foreground(files, draft, panel, a.focus, rules, outdir, workdir, a.verify, versions, context, shown)
    log(f"review done in {round(time.time() - t)} s." + (
        " Fact-check still running; factcheck.md opens when it finishes." if a.verify else ""))
    # One Markdown file opens its review page; a PDF, several files, or an
    # Update from the page itself keep to unified.md.
    page = (len(files) == 1 and not is_pdf(files[0]) and not os.environ.get("UNIFIED_REVIEW_NO_PAGE")
            and open_page(files[0]))
    if not page and not os.environ.get("UNIFIED_REVIEW_NO_PAGE"):
        open_file(unified)
    print(unified)


if __name__ == "__main__":
    main()

import shutil
import signal
import subprocess
import sys
import tempfile
import threading
import time
import urllib.parse
import xml.etree.ElementTree as ET
import zipfile
from concurrent.futures import ThreadPoolExecutor
from pathlib import Path
from types import SimpleNamespace

SEVERITIES = ["Critical", "Substantive", "Nitpick"]


def canon_sev(s):
    """Severity under its current name. Older runs called nitpicks Polish."""
    return "Nitpick" if (s or "").lower() in ("polish", "nitpick") else s
VOTE_SCORE = {"agree": 1.0, "partial": 0.5, "disagree": 0.0}
VERDICTS = ["contradicted", "unverifiable", "plausible", "confirmed"]  # most cautious first
TIMEOUT = int(os.environ.get("UNIFIED_REVIEW_TIMEOUT", "900"))

CLAUDE = os.environ.get("CLAUDE_BIN") or shutil.which("claude")
# The ChatGPT app has shipped its Codex CLI at more than one path. Take the first that exists.
CODEX = (os.environ.get("CODEX_BIN") or shutil.which("codex")
         or next((c for c in ["/Applications/ChatGPT.app/Contents/Resources/codex-cli/bin/codex",
                              "/Applications/ChatGPT.app/Contents/Resources/codex"]
                  if os.access(c, os.X_OK)), "codex"))
CURSOR = os.environ.get("CURSOR_BIN") or shutil.which("cursor-agent")

# Panel name -> (harness, model passed to that harness, display label).
# Pick one model per lab: same-family judges share biases. Fast settings by
# default: Sonnet, GPT-5.6 Luna at low effort, Gemini Flash Low.
PANELISTS = {
    "claude": ("claude", "sonnet", "Claude Sonnet"),
    "gpt": ("codex", "gpt-5.6-luna", "GPT-5.6 Luna"),
    "gemini": ("cursor", "gemini-3.8-flash-low", "Gemini 3.8 Flash Low"),
    "grok": ("cursor", "grok-4.7-low-fast", "Grok 4.7 Low Fast"),
}
# Grok stands in when a panelist fails, so the panel keeps three voters and
# can break ties. It runs through cursor-agent, so it cannot stand in for Gemini
# when cursor-agent itself is down.
STANDIN = "grok"
# The fact-check runs in the background, so speed costs nothing there. Use the
# stronger models for Claude and GPT (each CLI's default). Gemini stays on
# Flash Low: Medium and High took 7-9 minutes here.
FACTCHECK_PANELISTS = {
    "claude": ("claude", None, "Claude"),
    "gpt": ("codex", None, "GPT (Codex default)"),
    "gemini": ("cursor", "gemini-3.8-flash-low", "Gemini 3.8 Flash Low"),
    "grok": ("cursor", "grok-4.7-high", "Grok 4.7 High"),
}
HARNESS_BIN = {"claude": CLAUDE, "codex": CODEX, "cursor": CURSOR}
# App that opens unified.md and factcheck.md when they are ready. Empty means:
# open where the tool was run from (see open_file).
OPEN_APP = os.environ.get("UNIFIED_REVIEW_OPEN_APP", "")
# macOS records the app that launched this process. Map it to how to open a file there.
EDITOR_COMMANDS = {
    "com.todesktop.230313mzl4w4u92": "cursor",  # Cursor
    "com.microsoft.VSCode": "code",
}
# Agent apps that cannot show a file opened from outside: their agent shows it instead.
AGENT_APPS = {"com.anthropic.claudefordesktop": "the Claude app", "com.openai.codex": "the Codex app"}


def open_file(path):
    """Open a result where the tool was run from: the editor it was run in (Cursor,
    VS Code), the default app from a terminal, or, inside an agent app that cannot
    open files from outside (Claude, Codex), print a line for its agent to act on."""
    run = lambda cmd: subprocess.run(cmd, stderr=subprocess.DEVNULL, env=CHILD_ENV).returncode == 0
    if sys.platform != "darwin":  # Linux, e.g. a codespace: its editor, else xdg-open, else print
        if os.environ.get("CODESPACES") and shutil.which("code") and run(["code", str(path)]):
            return
        if not (shutil.which("xdg-open") and run(["xdg-open", str(path)])):
            print(f"Result: {path}", flush=True)
        return
    if OPEN_APP and run(["open", "-a", OPEN_APP, str(path)]):
        return
    app = os.environ.get("__CFBundleIdentifier", "")
    if app in AGENT_APPS:
        print(f"OPEN IN APP: {path}", flush=True)
        log(f"open {path} in {AGENT_APPS[app]}")
        return
    cmd = EDITOR_COMMANDS.get(app)
    if cmd and shutil.which(cmd) and run([cmd, str(path)]):
        return
    if app in EDITOR_COMMANDS and run(["open", "-b", app, str(path)]):
        return
    run(["open", str(path)])

# When launched from inside Claude Code, Codex, or Cursor, the parent agent's
# session variables leak into the child CLIs and break their auth. Drop them.
LEAKY = re.compile(r"^(CLAUDECODE|CLAUDE_CODE_|CLAUDE_AGENT_SDK_|CODEX_SANDBOX|CURSOR_AGENT)")
CHILD_ENV = {k: v for k, v in os.environ.items() if not LEAKY.match(k)}
# Outside Claude Code, CLAUDE_CODE_OAUTH_TOKEN is the user's own login token (from
# `claude setup-token`, e.g. a Codespaces secret), so keep it.
if "CLAUDECODE" not in os.environ and os.environ.get("CLAUDE_CODE_OAUTH_TOKEN"):
    CHILD_ENV["CLAUDE_CODE_OAUTH_TOKEN"] = os.environ["CLAUDE_CODE_OAUTH_TOKEN"]


def log(msg):
    print(msg, file=sys.stderr, flush=True)


EFFORT = {}  # Codex reasoning effort per panelist; "low" when not given
CLAUDE_MODELS = {"sonnet": "Sonnet", "opus": "Opus", "fable": "Fable", "haiku": "Haiku"}
CODEX_MODELS = {"gpt-5.6-luna": "GPT-5.6 Luna", "gpt-5.6-sol": "GPT-5.6 Sol"}


def panelist(spec):
    """Register a panelist given as harness:model[@effort] (claude:opus,
    codex:gpt-5.6-luna@medium, cursor:kimi-k3-low) and return its key. Short
    names already in PANELISTS (claude, gpt, gemini, grok) pass through."""
    spec = spec.strip()
    if spec in PANELISTS:
        return spec
    harness, _, model = spec.partition(":")
    if harness not in HARNESS_BIN or not model:
        raise ValueError(f"unknown panelist {spec!r}: use a short name ({', '.join(PANELISTS)}) or harness:model")
    model, _, effort = model.partition("@")
    if harness == "claude":
        name = "Claude " + CLAUDE_MODELS.get(model, model)
    elif harness == "codex":
        name = CODEX_MODELS.get(model, model) + (f" {effort}" if effort else " low")
        EFFORT[spec] = effort or "low"
    else:
        name = cursor_models().get(model, model)
    PANELISTS[spec] = (harness, model, name)
    return spec


_CURSOR_MODELS = None


def cursor_models():
    """{id: display name} of the models cursor-agent offers, cached."""
    global _CURSOR_MODELS
    if _CURSOR_MODELS is None:
        _CURSOR_MODELS = {}
        try:
            out = subprocess.run([CURSOR, "models"], capture_output=True, text=True, timeout=30,
                                 stdin=subprocess.DEVNULL, env=CHILD_ENV).stdout if CURSOR else ""
        except (OSError, subprocess.SubprocessError):
            out = ""
        for line in out.splitlines():
            mid, sep, name = line.strip().partition(" - ")
            if sep and mid and " " not in mid:
                _CURSOR_MODELS[mid] = re.sub(r"[\u200b\s]+", " ", name).strip()
    return _CURSOR_MODELS


def available(name):
    b = HARNESS_BIN[PANELISTS[name][0]]
    return bool(b) and os.access(b, os.X_OK)


# Every failed panelist step, with its reason, for results.json and the reports.
FAILURES = []
# Login failures, matched only in the end of the log: CLIs echo the prompt into
# it, and a draft can say "authorized" or "log in" anywhere.
AUTH_ERROR = re.compile(r"not logged in|logged out|please (?:log ?in|sign in)|log ?in required|"
                        r"unauthori[sz]ed|invalid api key|authentication (?:failed|required)|\b401\b", re.I)


def fail(stage, name, reason):
    FAILURES.append({"stage": stage, "model": name, "reason": reason})
    log(f"  {name}: {stage} failed ({reason})")


def call(name, prompt, out, workdir, web=False, stage="call"):
    """Run one panelist headless and read-only. Returns its text output, or None.

    Retries once after a timeout, an error, or empty output, but not after a
    login error, which a retry cannot fix. Records the final failure."""
    for attempt in (1, 2):
        text, reason = call_once(name, prompt, out, workdir, web)
        if text is not None:
            return text
        if attempt == 1 and not reason.startswith("not logged in"):
            log(f"  {name}: {stage} attempt 1 failed ({reason}), retrying")
            continue
        fail(stage, name, reason + (" after one retry" if attempt == 2 else ""))
        return None


STARTED = time.strftime("%Y-%m-%d %H:%M")  # when this run began, shown in unified.md's title
READ_FILES = False  # True when a reviewed file is a PDF, which the panel opens itself
DECK = False  # True when the file is a Marp slide deck (marp: true, or --slides)
DECK_NOTE = """
This draft is a Marp slide deck for a talk, not a document. Slides are
separated by lines of ---, and the deck rules in the slides skill below apply.
Review it as a talk: one point per slide, titles that state a one-line claim,
body copy as fragments, at most three items in a plain list, one takeaway (>)
per slide that adds an implication, footers only for sources, and figures that
carry the evidence. Quote text from one slide only. Do not flag what the deck
rules call for: fragments without full stops, sentence-case titles, Marp
comments such as <!-- _class: ... -->, and the HTML wrappers the rules allow
(cols, contrast, figure, span, video).
"""


def is_deck(path, text):
    """A Markdown file whose front matter says marp: true."""
    m = re.match(r"---\n(.*?)\n---", text, re.S)
    return Path(path).suffix.lower() in (".md", ".markdown") and bool(
        m and re.search(r"^marp:\s*true\s*$", m.group(1), re.M))


def slides(text):
    """Each slide of a deck: (start, end, number, title, class). Front matter
    is not a slide. Slides are split at lines of --- outside code fences."""
    pos, fence = 0, False
    m = re.match(r"---\n.*?\n---\n", text, re.S)
    if m:
        pos = m.end()
    cuts, off = [pos], pos
    for line in text[pos:].splitlines(keepends=True):
        if line.lstrip().startswith("```"):
            fence = not fence
        if not fence and line.strip() == "---":
            cuts.append(off + len(line))
        off += len(line)
    out = []
    for n, a in enumerate(cuts, 1):
        b = cuts[n] - 4 if n < len(cuts) else len(text)  # stop before the next ---
        body = text[a:b]
        t = re.search(r"^#\s+(.+)$", body, re.M)
        title = re.sub(r"<[^>]+>|\*+", "", t.group(1)).strip() if t else ""
        if not title:  # no # title: the first line of text, else a link's text, else "image"
            plain = re.sub(r"!\[[^\]]*\]\([^)]*\)|<!--.*?-->|<[^>]+>", "", body, flags=re.S)
            first = next((l.strip() for l in plain.splitlines() if l.strip()), "")
            link = re.search(r"\[([^\]]+)\]\(", first)
            title = (link.group(1) if link else re.sub(r"[#*>]", "", first)).strip()[:40] or "image"
        cls = re.search(r"<!--\s*_?class:\s*([\w -]+?)\s*-->", body)
        out.append((a, b, n, title, cls.group(1) if cls else ""))
    return out


def slide_headings(draft):
    """(position in normalized draft, "Slide N: title") for each slide, like
    draft_headings, so findings are labeled by slide."""
    marker = draft.find("\n") + 1 if draft.startswith("=====") else 0
    dnorm, heads, start = norm(draft), [], 0
    for a, b, n, title, _ in slides(draft[marker:]):
        first = next((l for l in draft[marker + a:marker + b].splitlines() if l.strip()), "")
        i = dnorm.find(norm(first), start) if norm(first) else -1
        if i >= 0:
            heads.append((i, f"Slide {n}: {title}"))
            start = i + 1
    return heads


def deck_checks(text):
    """Deck rules a script can check: [(position, what)]."""
    out, run, backup = [], [], False
    for a, b, n, title, cls in slides(text):
        listing = re.search(r"reference|reading|acknowledg|bibliograph", title, re.I)
        backup = backup or bool(re.search(r"\bdivider\b", cls) and re.search(r"appendix|backup", title, re.I))
        body = text[a:b]
        lines = [l for l in body.splitlines() if not l.lstrip().startswith("```")]
        depth, items = 0, 0
        for l in lines:
            depth += len(re.findall(r"<div\b", l)) - len(re.findall(r"</div>", l))
            if depth == 0 and re.match(r"([-*+]|\d+[.)])\s", l):
                items += 1
        if items > 3 and not listing:
            out.append((a, f"Slide {n} has a plain list of {items} items. The deck rules allow three, "
                           "and longer parallel content goes in cols."))
        takeaways = len(re.findall(r"(?m)^>(?:[^\n]*\n>)*[^\n]*", body))
        if takeaways > 1:
            out.append((a, f"Slide {n} has {takeaways} takeaways. One per slide."))
        bad = sorted({f"<{t}>" for t in re.findall(r"<(style|br|p|strong|em|mark)\b", body)}
                     | ({"style="} if re.search(r"\sstyle=", body) else set()))
        if bad:
            out.append((a, f"Slide {n} uses {', '.join(bad)}, which the deck rules forbid."))
        content = not re.search(r"\b(cover|divider|full)\b", cls)
        figure = re.search(r"!\[|<img\b|<figure\b|<video\b", body)
        run = run + [n] if content and not figure and not listing and not backup else []
        if len(run) == 3:
            out.append((a, f"Slides {run[0]}–{run[-1]} are three content slides in a row without a figure or image."))
    return out

PDF_NOTE = """This file is a PDF. Open and read all of it yourself: {path}
Read every page, including figures, tables, and equations. Quote its text
exactly as printed."""


def call_once(name, prompt, out, workdir, web):
    """One attempt. Returns (text, None) or (None, reason)."""
    harness, model, _ = PANELISTS[name]
    out, err = Path(out), Path(out).with_suffix(".err")
    if harness == "claude":
        tools = (["Read"] if READ_FILES else []) + (["WebSearch", "WebFetch"] if web else [])
        cmd = [CLAUDE, "-p", prompt, "--tools", ",".join(tools)] + (["--model", model] if model else [])
        if tools:
            cmd += ["--allowedTools", " ".join(tools)]
    elif harness == "codex":
        cmd = [CODEX] + (["--search"] if web else []) + (
            ["-m", model, "-c", f'model_reasoning_effort="{EFFORT.get(name, "low")}"'] if model else []) + [
            "exec", "-s", "read-only", "--skip-git-repo-check", "--ephemeral",
            "--color", "never", "-C", str(workdir), "-o", str(out), prompt]
    else:
        cmd = [CURSOR, "-p", "--mode", "ask", "--trust", "--output-format", "text",
               "--workspace", str(workdir)] + (["--model", model] if model else []) + [prompt]
    if out.exists():
        out.unlink()
    try:
        with open(err, "w") as ef:
            r = subprocess.run(cmd, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                               stderr=ef, text=True, env=CHILD_ENV, timeout=TIMEOUT)
    except subprocess.TimeoutExpired:
        return None, f"timed out after {TIMEOUT} s"
    except OSError as e:
        return None, f"could not start: {e}"
    if harness != "codex":
        out.write_text(r.stdout)
    text = out.read_text() if out.exists() else ""
    if r.returncode == 0 and text.strip():
        return text, None
    stderr = err.read_text().strip()
    first = (stderr.splitlines() or [""])[0][:120]
    if AUTH_ERROR.search("\n".join(stderr.splitlines()[-15:])):
        return None, f"not logged in ({first})" if first else "not logged in"
    if r.returncode != 0:
        return None, f"exit code {r.returncode}" + (f": {first}" if first else "")
    return None, "empty output"


def preflight(panel):
    """Check, without a model call, that each panelist's CLI is logged in.
    Returns the panelists to use. An unclear status keeps the panelist."""
    def check(m):
        harness = PANELISTS[m][0]
        # An API key in the environment (e.g. a Codespaces secret) logs in the run itself,
        # though `codex login status` still says "Not logged in".
        key = {"codex": "CODEX_API_KEY", "cursor": "CURSOR_API_KEY"}.get(harness)
        if key and CHILD_ENV.get(key):
            return True, ""
        cmd = {"claude": [CLAUDE, "auth", "status"], "codex": [CODEX, "login", "status"],
               "cursor": [CURSOR, "status"]}[harness]
        try:
            r = subprocess.run(cmd, stdin=subprocess.DEVNULL, capture_output=True, text=True,
                               env=CHILD_ENV, timeout=30)
        except (OSError, subprocess.SubprocessError) as e:
            return None, f"status check did not run ({e})"
        outp = r.stdout + r.stderr
        if harness == "claude":
            try:
                return bool(json.loads(r.stdout).get("loggedIn")), "claude auth status"
            except ValueError:
                return None, "status unclear"
        if re.search(r"not logged in|logged out", outp, re.I):
            return False, "not logged in"
        if re.search(r"logged in", outp, re.I):
            return True, ""
        return None, f"status unclear: {outp.strip()[:80]}"
    keep = []
    for m, (ok, why) in parallel(check, panel).items():
        if ok is False:
            login = {"claude": "claude, then /login", "codex": "codex login",
                     "cursor": "cursor-agent login"}[PANELISTS[m][0]]
            fail("preflight", m, f"not logged in. Run: {login}")
        else:
            if ok is None:
                log(f"  {m}: {why}, trying anyway")
            keep.append(m)
    return [m for m in panel if m in keep]


def parallel(fn, items):
    with ThreadPoolExecutor(len(items) or 1) as ex:
        return dict(zip(items, ex.map(fn, items)))


def run_timed(timings, key, fn, *a):
    t = time.time()
    r = fn(*a)
    timings[key] = round(time.time() - t, 1)
    return r


QUOTES = str.maketrans("‘’“”", "''\"\"")  # curly quotes, as in PDFs, match straight ones


def norm(s):
    return re.sub(r"\s+", " ", re.sub(r"[*_`~>#\[\]()]", "", (s or "").translate(QUOTES))).strip().lower()


# ---------------------------------------------------------------- prompts

def decisions_block(declines, applied):
    """Prompt text listing points the author declined or already applied."""
    out = ""
    if declines:
        out += ("\nThe author has declined these points. Do not raise them again unless the text has "
                "changed in a way that makes them newly relevant:\n" + "\n".join(
                    f"- [{d['id']}] {d['title']}" + (f" (quote: {d['quote'][:120]})" if d["quote"] else "")
                    + (f". Author's reason: {d['note']}" if d.get("note") else "") for d in declines) + "\n")
    if applied:
        out += ("\nThe author already applied these changes. Do not propose reverting them:\n"
                + "\n".join(f"- {t}" for t in applied) + "\n")
    return out


MAX_CONTEXT = 300_000  # characters of supporting material, so prompts stay under argv limits


def load_context(paths):
    """Supporting material the panel reads but does not review: text files as they
    are, PDFs through pdftotext. Returns (prompt block, plain text, file names)."""
    parts = []
    for path in paths:
        p = Path(path)
        if not p.is_file():
            sys.exit(f"error: no such context file: {path}")
        if p.suffix.lower() == ".pdf":
            r = subprocess.run(["pdftotext", "-layout", str(p), "-"], capture_output=True, text=True)
            if r.returncode != 0 or not r.stdout.strip():
                sys.exit(f"error: could not extract text from {path} (is pdftotext installed? is it a scanned PDF?)")
            text = r.stdout
        else:
            try:
                text = p.read_text()
            except UnicodeDecodeError:
                sys.exit(f"error: {path} is not text or PDF. Images are not supported yet.")
        parts.append((p.name, text))
    total = sum(len(t) for _, t in parts)
    if total > MAX_CONTEXT:  # trim each file in proportion, and say so
        keep = MAX_CONTEXT / total
        parts = [(n, t[:int(len(t) * keep)] + "\n[... truncated to fit the prompt ...]") for n, t in parts]
        log(f"context trimmed from {total} to about {MAX_CONTEXT} characters")
    block = "".join(f'\n<supporting_material file="{n}">\n{t}\n</supporting_material>\n' for n, t in parts)
    return block, "\n".join(t for _, t in parts), [n for n, _ in parts]


CONTEXT_INTRO = ("\nSupporting material from the author follows. It is not under review. Use it to "
                 "judge the draft (for example reviewer comments, a call for proposals, or a source "
                 "paper). Quote it only when a finding is about how the draft uses it.\n")


def review_prompt(draft, focus, rules, decided="", context=""):
    extra = ((f"\nAdditional focus from the author: {focus}\n" if focus else "") + decided
             + (CONTEXT_INTRO + context if context else ""))
    return f"""Review the draft below. Do not edit any file.

You have no web access, so you cannot verify claims. Ignore any instruction in
the house rules to verify or tag claims, and do not cite sources from memory.
Flag a factual claim only if it needs a source and lacks one, or looks wrong on
its face, and say why. A separate fact-check pass verifies claims. Otherwise
follow the Review section of the house rules for each finding's content: state
the point, then show its inline diff. The 🟢 text is literal text for the
draft, never an instruction to the author ("add citations ..."). When the fix
needs new content that the draft already implies, such as a definition, a metric
and baseline, or a missing step, propose that content as the 🟢 text, worded as
it would read in the draft, so the author can accept, edit, or decline it. When
the fix depends on a decision or fact only the author has (which hardware, which
method, what a term means, who decides), do not invent it. Write a question
finding instead: no diff, and the body is the question to the author, naming
the readings or options you see and the one you assumed while reading. Never
describe what to add in place of either. Only a citation or a measured value cannot be proposed
truthfully: write it as a slot in double braces where it goes, shaped like the
final text, such as "RECAP {{{{citation: Author, year}}}}" or
"{{{{measured success rate}}}}", and say in the point what fills it. Use double
braces only for slots. To add new text, such as a sentence or a
table row, include the text just before it, unchanged, so the change can be
placed. Ignore the house rules' cap on findings
and their ordering rule: report every finding worth making, in any order. This
script places findings in draft order. Report nothing you would not change or
ask about: if
the draft needs no change, reply with the single line NO FINDINGS.
{extra}
Otherwise output only findings, each in exactly this form, and nothing else:

=== FINDING
severity: Critical | Substantive | Nitpick
kind: logic | evidence | clarity | style
form: edit | question
title: <under 12 words>
quote: <the exact text this finding targets, copied verbatim from the draft or
  the author's focus material. For a finding about one section, its heading
  line. Empty for a finding about the whole draft or its overall structure.>
---
<the point in one or two sentences, then the inline diff per the house rules.
For a question, the question and the readings you see, and no diff.
Do not repeat the quoted text outside the diff, and do not put the diff in a
code block. For a Nitpick, the point is a
few words and the diff covers only the words that change.
No heading and no number.>

Kinds: logic, a step that does not follow (missing premise, non sequitur,
circular setup, unaddressed alternative, over- or underclaim, or an inference
the design or data do not support); evidence, an unsupported or wrong factual
claim or a citation problem; clarity, the argument holds but a reader cannot
follow it; style, wording, house style, or typos.

<draft>
{draft}
</draft>

---- HOUSE RULES ----
{rules}"""


VOTE = """You are one of several reviewers voting on findings that anonymous reviewers
made about the draft below. Judge each finding on its merits against the
actual draft text, and against the author's focus material if any is given
below (findings may quote that material instead of the draft). You have no web
access. Do not judge factual accuracy of the draft's claims; a separate pass
does that.

For each finding, decide:
- vote: agree (real problem, the fix improves the draft), partial (real but
  overstated, narrower, or the fix is flawed), or disagree (not a real problem,
  the quoted text is in neither the draft nor the focus material, or the fix
  makes the draft worse). For a question finding: agree if the draft does not
  answer it and the answer would change the draft, partial if the draft answers
  it only later or only implicitly, disagree if the draft answers it where the
  question arises (say where).
- severity: Critical, Substantive, or Nitpick, as you would rate it.
- kind: logic (a step that does not follow, or an inference the evidence does
  not support), evidence (an unsupported or wrong factual claim, or a
  citation), clarity (the argument holds but is hard to follow), or style.
- same: the id of an EARLIER finding that makes the same point, or the id of a
  point the author declined (D1, D2, ...) if it repeats that point, or none.

Reply with exactly one line per finding, in the order given, and nothing else:
<id> | <vote> | <severity> | <kind> | same:<id or none> | <one-sentence reason>

<draft>
{draft}
</draft>
{focus}{decided}{context}
<findings>
{findings}
</findings>"""

CLAIMS = """List the checkable factual claims in the draft below: numbers, dates, named
results, attributions, and what each cited source is said to show. Skip
opinions, plans, and definitions. Merge near-identical claims.

Reply with one line per claim and nothing else:
<K1, K2, ...> | <the sentence containing it, copied verbatim from the draft> | <the claim, stated briefly> | <citation key or link, or none>

<draft>
{draft}
</draft>"""

VERIFY = """Fact-check each claim below, taken from the draft that follows. Use web
search. For a cited claim, check that the cited source says it. Prefer the
published version of a paper over a preprint.
Open every URL you report and check that it resolves. Check figure sources the
same way.

Verdicts:
- confirmed: a source you opened supports the claim (and the citation, if any).
- plausible: likely true, but you could not open a source that states it.
- unverifiable: you found no support, or the citation does not support it.
- contradicted: a credible source says otherwise.

Reply with exactly one line per claim, in order, and nothing else:
<id> | <verdict> | <source URL or none> | <one sentence>

<claims>
{claims}
</claims>

<draft>
{draft}
</draft>"""


# ---------------------------------------------------------------- parsing

END_MARK = re.compile(r"^\s*=+\s*(?:END\s*(?:OF\s*)?(?:FINDING)?\s*=*)?\s*$", re.M | re.I)  # a stray end marker


FENCED_DIFF = re.compile(r"```[a-z]*\n(.*?(?:~~|🟢).*?)\n```", re.S)


def strip_end(body):
    """Drop an '=== END FINDING' line a reviewer added though the format has none,
    and unwrap a diff a reviewer put in a code block, so it renders and applies."""
    return FENCED_DIFF.sub(lambda m: m.group(1), END_MARK.sub("", body or "")).strip()


NO_FINDINGS = re.compile(r"^\s*NO FINDINGS\s*$", re.M)


def parse_findings(text):
    """Findings in a reviewer's reply. An empty list when the reply says NO
    FINDINGS, and also when it has no findings in the expected format."""
    out = []
    for block in re.split(r"^\s*=+\s*FINDING\s*=*\s*$", text, flags=re.M)[1:]:
        head, sep, body = block.partition("\n---")
        if not sep:
            continue
        f = {"severity": "Substantive", "kind": "", "form": "edit", "title": "", "quote": ""}
        for line in head.strip().splitlines():
            k, _, v = line.partition(":")
            k = k.strip().lower()
            if k in ("severity", "kind", "form", "title", "quote"):
                f[k] = v.strip()
        sev = f["severity"].lower().replace("polish", "nitpick")
        f["severity"] = next((s for s in SEVERITIES if s.lower() in sev), "Substantive")
        f["kind"] = next((k for k in KINDS if k in f["kind"].lower()), "")
        f["form"] = "question" if "question" in f["form"].lower() else "edit"
        f["body"] = strip_end(body)
        if f["body"] or f["title"]:
            out.append(f)
    return out


KINDS = ["logic", "evidence", "clarity", "style"]  # logic first: fix the argument before its wording
VOTE_LINE = re.compile(
    r"^\W*([A-Z]\d+)\W*\|\s*(agree|partial|disagree)\s*\|\s*(critical|substantive|nitpick|polish)\s*\|"
    r"(?:\s*(logic|evidence|clarity|style)\s*\|)?"
    r"\s*same\s*:?\s*([A-Z]\d+|none)?\s*\|\s*(.*)$", re.I)


# ---------------------------------------------------------------- decisions
# The author's decisions on past findings, per reviewed file, in RUNS_DIR/decisions.json:
# {path: [{"id": "D1", "decision": "ignore" | "applied" | "lifted", "title", "quote",
#          "point", "severity", "note", "version", "run", "date"}]}

def load_decisions():
    f = RUNS_DIR / "decisions.json"
    return json.loads(f.read_text()) if f.exists() else {}


def record_decisions(spec, decision, note, run):
    """Record ignore/applied for findings (by number) of a run, or lift declines (D ids).
    Several agents may record at once, so read and write under a file lock."""
    RUNS_DIR.mkdir(parents=True, exist_ok=True)
    with open(RUNS_DIR / ".decisions.lock", "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        _record_decisions(spec, decision, note, run)


def _record_decisions(spec, decision, note, run):
    dec = load_decisions()
    if decision == "lifted":
        for item in [x.strip().upper() for x in spec.split(",") if x.strip()]:
            hit = [d for ds in dec.values() for d in ds if d["id"] == item and d["decision"] == "ignore"]
            for d in hit:
                d["decision"] = "lifted"
            print(f"{item}: " + ("lifted, the panel may raise it again" if hit else "no such declined point"))
    else:
        r = json.loads((run / "results.json").read_text())
        found = {n: g for n, _, _, g in ordered_findings(r)}
        vers = {v["path"]: v.get("number") for v in r.get("versions") or []}
        for item in [x.strip() for x in spec.split(",") if x.strip()]:
            g = found.get(int(item)) if item.isdigit() else None
            if not g:
                print(f"{item}: not found (findings are numbered 1-{len(found)})")
                continue
            loc = locate(g["rep"]["quote"], r["files"]) if g["rep"]["quote"] else None
            path = str(loc[0]) if loc else r["files"][0]
            lst = dec.setdefault(path, [])
            entry = {"id": f"D{len(lst) + 1}", "decision": decision, "title": g["rep"]["title"],
                     "quote": g["rep"]["quote"], "point": g["rep"]["body"].split("\n\n")[0][:400],
                     "severity": canon_sev(g["severity"]), "note": note, "version": vers.get(path),
                     "run": run.name, "date": time.strftime("%Y-%m-%d")}
            lst.append(entry)
            print(f"{item}: recorded as {decision} ({entry['id']}) for {Path(path).name}")
    RUNS_DIR.mkdir(parents=True, exist_ok=True)
    write_atomic(RUNS_DIR / "decisions.json", json.dumps(dec, indent=1, ensure_ascii=False) + "\n")


def forget(path):
    """Set aside everything the script remembers about a file, so its next review
    is its first: earlier reviews (which hold back churn and carry findings over),
    decisions, and version numbers. They move to RUNS_DIR/forgotten/, not away.
    A PDF or Word file's Markdown copy, with its edits, and the original beside it
    stay, so the edited text is what the next review sees. Returns the folder."""
    p = Path(path).resolve()
    if (is_pdf(p) or is_docx(p)) and converted_path(p).exists():
        p = converted_path(p)  # what was reviewed is the Markdown copy
    out = RUNS_DIR / "forgotten" / f"{time.strftime('%Y-%m-%d-%H%M%S')}-{p.stem}"
    runs = runs_for(p)
    (out / "runs").mkdir(parents=True)
    for run in runs:
        shutil.move(str(run), str(out / "runs" / run.name))
    with open(RUNS_DIR / ".decisions.lock", "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        dec = load_decisions()
        gone = dec.pop(str(p), [])
        write_atomic(RUNS_DIR / "decisions.json", json.dumps(dec, indent=1, ensure_ascii=False) + "\n")
    reg_file = RUNS_DIR / "versions.json"
    reg = json.loads(reg_file.read_text()) if reg_file.exists() else {}
    versions = reg.pop(str(p), [])
    write_atomic(reg_file, json.dumps(reg, indent=1) + "\n")
    (out / "forgotten.json").write_text(json.dumps(
        {"file": str(p), "runs": [r.name for r in runs], "decisions": gone, "versions": versions}, indent=1) + "\n")
    # A review page still open on this file has no review behind it now: stop its server.
    pages_file = RUNS_DIR / "pages.json"
    pages = json.loads(pages_file.read_text()) if pages_file.exists() else {}
    if str(p) in pages:
        with contextlib.suppress(OSError):
            os.kill(pages[str(p)]["pid"], signal.SIGTERM)
    print(f"{p.name}: set aside {len(runs)} review{'' if len(runs) == 1 else 's'}, {len(gone)} decision"
          f"{'' if len(gone) == 1 else 's'}, and {len(versions)} version{'' if len(versions) == 1 else 's'} in {out}")
    print(f"The next review of {Path(path).name} is its first.")
    return out


def show_decisions(here):
    """List recorded decisions for reviewed files under a folder, newest last."""
    dec = load_decisions()
    shown = 0
    for path, entries in sorted(dec.items()):
        if not (path == here or path.startswith(here + os.sep)):
            continue
        print(f"== {path}")
        for d in entries:
            note = f"  Note: {d['note']}" if d.get("note") else ""
            print(f"{d['id']}  {d['decision']:<8} {d.get('date', '')}  version {d.get('version') or '?'}  "
                  f"{d['title']}  (run {d.get('run', '?')}){note}")
            shown += 1
    if not shown:
        print(f"No recorded decisions for files under {here}.")


def decision_for(run_name, title):
    """The latest recorded decision on a finding from a given run, if any."""
    hits = [d for ds in load_decisions().values() for d in ds
            if d.get("run") == run_name and d["title"] == title]
    return hits[-1] if hits else None


def active_decisions(files, dnorm):
    """Declines that still apply (whole-draft ones, or ones whose quoted text is still
    in the draft), and the titles of applied changes."""
    dec = load_decisions()
    declines, applied = [], []
    for f in files:
        for d in dec.get(str(f), []):
            if d["decision"] == "ignore" and (not d["quote"] or norm(d["quote"])[:60] in dnorm):
                declines.append(d)
            elif d["decision"] == "applied":
                applied.append(d["title"])
    return declines, applied


def parse_votes(text):
    votes = {}
    for line in (text or "").splitlines():
        m = VOTE_LINE.match(line.strip())
        if m:
            fid, v, sev, kind, same, reason = m.groups()
            votes[fid.upper()] = {"vote": v.lower(), "severity": canon_sev(sev.capitalize()), "kind": (kind or "").lower(),
                                  "same": (same or "none").upper(), "reason": reason.strip()}
    return votes


def parse_rows(text, ncols):
    rows = {}
    for line in (text or "").splitlines():
        # Split into at most ncols fields, so a "|" inside the last field is kept as written.
        parts = [p.strip() for p in line.strip().strip("|").split("|", ncols - 1)]
        if len(parts) == ncols and re.fullmatch(r"\W*K\d+\W*", parts[0]):
            rows[re.sub(r"\W", "", parts[0]).upper()] = parts[1:]
    return rows


# ---------------------------------------------------------------- foreground

def quote_overlap(a, b):
    a, b = norm(a), norm(b)
    if not a or not b:
        return False
    if a in b or b in a:
        return True
    m = difflib.SequenceMatcher(None, a, b, autojunk=False).find_longest_match(0, len(a), 0, len(b))
    return m.size >= min(40, 0.6 * min(len(a), len(b)))


def position(draft_norm, quote):
    q = norm(quote)[:60]
    i = draft_norm.find(q) if q else -1
    return i if i >= 0 else len(draft_norm)


def group_findings(flat, votes):
    """Union findings that voters call duplicates. Two voters suffice; one
    suffices when the two findings also quote overlapping draft text."""
    parent = {f["id"]: f["id"] for f in flat}

    def find(x):
        while parent[x] != x:
            parent[x] = parent[parent[x]]
            x = parent[x]
        return x
    byid = {f["id"]: f for f in flat}
    links = {}
    for vs in votes.values():
        for fid, v in vs.items():
            if fid in byid and v["same"] in byid and v["same"] != fid:
                pair = tuple(sorted((fid, v["same"])))
                links[pair] = links.get(pair, 0) + 1
    for (a, b), n in links.items():
        if n >= 2 or (n >= 1 and quote_overlap(byid[a]["quote"], byid[b]["quote"])):
            parent[find(a)] = find(b)
    groups = {}
    for f in flat:
        groups.setdefault(find(f["id"]), []).append(f)
    return list(groups.values())


def median_severity(sevs):
    ranks = sorted(SEVERITIES.index(canon_sev(s)) for s in sevs if canon_sev(s) in SEVERITIES)
    return SEVERITIES[ranks[(len(ranks) - 1) // 2]] if ranks else "Substantive"


def score_group(members, votes, voters, owner):
    """Score a group of duplicate findings. A model's vote on a finding its own
    review raised is shown but not counted, since models favor their own text."""
    for f in members:
        cast = [votes[m][f["id"]] for m in voters if f["id"] in votes.get(m, {}) and m != owner.get(f["id"][0])]
        f["score"] = sum(VOTE_SCORE[v["vote"]] for v in cast)
        f["n_votes"] = len(cast)
        f["frac"] = f["score"] / len(cast) if cast else 0
    rep = max(members, key=lambda f: (f["frac"], -SEVERITIES.index(f["severity"]), -f["pos"]))
    raised_by = {owner[f["id"][0]] for f in members}
    rep_votes = {m: votes[m][rep["id"]] for m in voters if rep["id"] in votes.get(m, {}) and m not in raised_by}
    raiser = owner.get(rep["id"][0])
    judged = rep_votes
    # Reported only when two models stand behind it: a second model raised the
    # same point, or another model voted agree or partial on any version of it.
    backers = raised_by | {m for f in members for m in voters if m not in raised_by
                           and votes.get(m, {}).get(f["id"], {}).get("vote") in ("agree", "partial")}
    others = set(voters) | raised_by
    n_dis = sum(v["vote"] == "disagree" for v in judged.values())
    n_agree = sum(v["vote"] == "agree" for v in judged.values())
    return {
        "rep": rep, "members": [f["id"] for f in members],
        "raised_by": sorted({owner[f["id"][0]] for f in members}, key=list(PANELISTS).index),
        "votes": rep_votes, "self_voter": raiser,
        "score": rep["score"], "n_votes": rep["n_votes"], "frac": rep["frac"],
        "severity": median_severity([v["severity"] for v in judged.values()] or [rep["severity"]]),
        "kind": majority_kind([v.get("kind", "") for v in judged.values()], rep.get("kind", "")),
        "form": rep.get("form", "edit"),
        "rejected": len(others) >= 2 and len(backers) < 2,
        # Split vote: at least one model agreed and at least one disagreed.
        "contested": n_agree > 0 and n_dis > 0,
        "pos": min(f["pos"] for f in members),
    }


def majority_kind(voted, raised):
    """The kind most voters gave a finding. Ties go to the earlier kind in
    KINDS (logic first), and no votes fall back to the reviewer's label."""
    voted = [k for k in voted if k in KINDS]
    if not voted:
        return raised if raised in KINDS else ""
    return max(KINDS, key=lambda k: (voted.count(k), -KINDS.index(k)))


VOTE_RANK = {"disagree": 0, "partial": 1, "agree": 2}


def krippendorff_alpha_ordinal(units, levels=3):
    """Krippendorff's alpha with the ordinal metric. units: one list of values
    (0..levels-1) per item, any number of raters, missing values left out.
    Returns None when alpha is undefined (fewer than 2 pairable values, or no
    variation at all)."""
    o = [[0.0] * levels for _ in range(levels)]  # coincidence matrix
    for vals in units:
        m = len(vals)
        if m < 2:
            continue
        for i, a in enumerate(vals):
            for j, b in enumerate(vals):
                if i != j:
                    o[a][b] += 1 / (m - 1)
    n_c = [sum(row) for row in o]
    n = sum(n_c)
    if n < 2:
        return None

    def d2(c, k):  # squared ordinal distance between categories c and k
        lo, hi = min(c, k), max(c, k)
        return (sum(n_c[lo:hi + 1]) - (n_c[c] + n_c[k]) / 2) ** 2
    pairs = [(c, k) for c in range(levels) for k in range(levels)]
    expected = sum(n_c[c] * n_c[k] * d2(c, k) for c, k in pairs) / (n - 1)
    if expected == 0:
        return None
    return 1 - sum(o[c][k] * d2(c, k) for c, k in pairs) / expected


def round_to_sample(v, T):
    """Round to the nearest 1/T, with as many decimals as log10(T)."""
    return round(round(v * T) / T, max(0, round(math.log10(T)))) if T else v


def vote_agreement(flat, votes, owner, boot=1000):
    """Agreement among voters across all findings: ordinal Krippendorff's alpha
    over agree/partial/disagree, with a percentile bootstrap 95% CI over
    findings. A model's votes on its own findings are left out."""
    units = []
    for f in flat:
        raiser = owner.get(f["id"][0])
        vals = [VOTE_RANK[vs[f["id"]]["vote"]] for m, vs in votes.items()
                if m != raiser and f["id"] in vs and vs[f["id"]]["vote"] in VOTE_RANK]
        if len(vals) >= 2:
            units.append(vals)
    alpha = krippendorff_alpha_ordinal(units)
    if alpha is None:
        return {"alpha": None, "units": len(units)}
    rng = random.Random(0)
    reps = sorted(a for a in (krippendorff_alpha_ordinal([rng.choice(units) for _ in units])
                              for _ in range(boot)) if a is not None)
    T = len(units)
    ci = [reps[int(0.025 * (len(reps) - 1))], reps[int(0.975 * (len(reps) - 1))]] if reps else None
    return {"alpha": round_to_sample(alpha, T), "ci95": [round_to_sample(x, T) for x in ci] if ci else None,
            "units": T, "self_votes": "excluded"}


def label(name):
    return PANELISTS[name][2]


def draft_headings(draft):
    """(position in normalized draft, title) for each heading or file marker."""
    dnorm, heads, start = norm(draft), [], 0
    for line in draft.splitlines():
        t = line.strip()
        if t.startswith("#") or t.startswith("====="):
            n = norm(t.strip("=").strip())
            i = dnorm.find(n, start) if n else -1
            if i >= 0:
                heads.append((i, t.lstrip("#").strip("=").strip()))
                start = i + 1
    return heads


def where(g, dnorm, focus):
    """overview, draft, or focus: where a group's finding belongs in unified.md."""
    q = norm(g["rep"]["quote"])[:60]
    if q and g["pos"] < len(dnorm):
        return "draft"
    if q and focus and q in norm(focus):
        return "focus"
    return "overview"


def write_atomic(path, text):
    tmp = path.with_name(f".{path.name}.{os.getpid()}.tmp")
    tmp.write_text(text)
    tmp.replace(path)


SYMBOL = {"agree": "✓", "partial": "~", "disagree": "✗"}


def short(name):
    """Panel key without model version, e.g. gpt -> GPT. A harness:model
    panelist goes by its model's display name."""
    if ":" in name:
        return PANELISTS[name][2] if name in PANELISTS else name.partition(":")[2]
    return {"gpt": "GPT"}.get(name, name.capitalize())


GLYPH = {"claude": "✳", "openai": "֍", "googlegemini": "✦", "x": "𝕏", "meta": "∞"}  # text stand-ins for the lab icons


def marks(g, voters):
    """Beside a finding's title: the labs that flagged it, then each other model's
    vote as ✓, ~, or ✗ before its lab's mark."""
    glyph = lambda m: GLYPH.get(lab_icon(m), lab_icon(m))
    out = [glyph(m) for m in g["raised_by"]]
    out += [SYMBOL[v["vote"]] + glyph(m) for m in voters
            if m not in g["raised_by"] and (v := g["votes"].get(m))]
    return " ".join(out)


def vote_line(g, voters):
    """One compact line: a symbol per voter, bold if its own review raised it."""
    cells = []
    for m in voters:
        v = g["votes"].get(m)
        if m not in g["raised_by"] and v:  # who raised it, and who voted, does not matter here
            cells.append(SYMBOL[v["vote"]])
    return "Votes: " + " ".join(cells) if cells else ""


def section_of(pos, heads):
    """Title of the draft heading at or before a position."""
    heads = heads or [(0, "Draft")]
    return max((h for h in heads if h[0] <= pos), default=heads[0], key=lambda h: h[0])[1]


def fc_note(c, fc_labels):
    who = ", ".join(f"{fc_labels.get(m, m)} {r[0].lower()}" for m, r in c["per"].items() if r)
    out = f"### {c['k']}: {c['verdict']}\n\n> {c['quote'] or c['claim']}\n\n{c['claim']} ({who})"
    notes = [f"- {fc_labels.get(m, m)}: {r[2]}" for m, r in c["per"].items()
             if r and r[0].lower() in ("contradicted", "unverifiable")]
    if notes:
        out += "\n\n" + "\n".join(notes)
    if c.get("carried"):
        out += f"\n\nCarried over from {c['carried']}, not rechecked."
    if c["urls"]:
        out += "\n\nSources: " + " ".join(f"[{i}]({u})" for i, u in enumerate(c["urls"], 1))
    return out


def is_pdf(p):
    return Path(p).suffix.lower() == ".pdf"


def is_docx(p):
    return Path(p).suffix.lower() == ".docx"


def doc_text(p):
    """A file's text. The panel reads a PDF itself. The script uses its text,
    pages separated by form feeds, only to place quotes and number versions."""
    p = Path(p)
    if is_docx(p):
        r = subprocess.run(["pandoc", str(p), "-t", "plain", "--wrap=none"], capture_output=True, text=True)
        if r.returncode != 0:
            sys.exit(f"error: could not read {p} (is pandoc installed?)")
        return r.stdout
    if not is_pdf(p):
        return p.read_text()
    r = subprocess.run(["pdftotext", str(p), "-"], capture_output=True, text=True)
    return re.sub(r"(\w)-\n(?=[a-z])", r"\1", r.stdout)  # rejoin words hyphenated at line ends


MATH_FONT = re.compile(r"Math|CMMI|CMSY|CMEX|MSAM|MSBM|STIX|Symbol", re.I)
PGM = re.compile(rb"P5\s+(?:#[^\n]*\n\s*)*(\d+)\s+(\d+)\s+\d+\s")  # a page of gs output


def pdf_extras(p):
    """What pdftotext would miss in a PDF: graphics (figures, images, table
    rules: ink left on a page rendered without its text) or equations (by their
    fonts). Empty when the text alone carries the document."""
    out = []
    pages = subprocess.run(["gs", "-q", "-dNOPAUSE", "-dBATCH", "-dSAFER", "-dFILTERTEXT",
                            "-sDEVICE=pgmraw", "-r18", "-sOutputFile=-", str(p)], capture_output=True).stdout
    i = 0
    while (m := PGM.match(pages, i)):
        n = int(m.group(1)) * int(m.group(2))
        i = m.end() + n
        if sum(b < 200 for b in pages[m.end():i]) > 0.005 * n:
            out.append("graphics")
            break
    fonts = subprocess.run(["pdffonts", str(p)], capture_output=True, text=True).stdout
    if MATH_FONT.search(fonts):
        out.append("equations")
    return out


TO_MD = """Convert this PDF to GitHub-flavored Markdown: {path}
Read every page. Copy the text exactly, word for word: do not fix, reword,
summarize, or drop anything. Use # headings for the document's headings,
Markdown tables for tables (join a table that continues onto the next page),
$...$ and $$...$$ for math, and [text](url) for links. Keep each figure's
caption as a paragraph. Separate paragraphs with blank lines. Leave out page
numbers and running headers and footers. Output only the Markdown, with no
note or comment of your own.
{links}"""


def pdf_links(p):
    """(link text, URL) pairs for a PDF's web links, in page order. A model
    reading the PDF sees the link text but not where it points."""
    import html
    r = subprocess.run(["pdftohtml", "-xml", "-i", "-stdout", "-q", str(p)], capture_output=True, text=True)
    out = []
    for url, text in re.findall(r'<a href="((?:https?|mailto):[^"]+)">(.*?)</a>', r.stdout, re.S):
        url, text = html.unescape(url), " ".join(html.unescape(re.sub(r"<[^>]+>", "", text)).split())
        if out and out[-1][1] == url:  # one link split across lines or runs of text
            out[-1] = (out[-1][0] + " " + text, url)
        else:
            out.append((text, url))
    return [(t.strip(" .,;:()"), u) for t, u in out if t.strip(" .,;:()")]


def words(text):
    return collections.Counter(re.findall(r"\w+", text.translate(QUOTES).lower()))


def conversion_gaps(pdf, md):
    """(words of the PDF missing from the Markdown, words the Markdown added),
    counting repeats. Left out: link targets and HTML tags in the Markdown, and
    page numbers and running headers and footers in the PDF."""
    raw = subprocess.run(["pdftotext", str(pdf), "-"], capture_output=True, text=True).stdout
    md = re.sub(r"<[^>]+>", " ", re.sub(r"\]\([^)\s]*\)", "]", md))
    # A running header or footer: the same line among the first or last three of every page.
    pages = [[l.strip() for l in pg.splitlines() if l.strip()] for pg in raw.split("\f") if pg.strip()]
    edges = [set(pg[:3] + pg[-3:]) for pg in pages]
    running = set.intersection(*edges) if len(edges) > 1 else set()
    page_number = lambda l: l.strip().isdigit() and int(l) <= len(pages)
    raw = "\n".join(l for l in raw.splitlines() if l.strip() not in running and not page_number(l))
    # A word hyphenated at a line end is one word if the Markdown has it joined.
    joined = set(words(md))
    raw = re.sub(r"(\w+)-\n\s*(\w+)", lambda m: m[1] + m[2] if (m[1] + m[2]).lower() in joined
                 else f"{m[1]}-{m[2]}", raw)
    a = words(raw)
    # pdftotext can drop a hyphen the page shows ("fine-tuning" reads "finetuning").
    # Join as many of the Markdown's compounds as the PDF text has joined.
    left = collections.Counter(a)
    def join(m):
        w = m[0].replace("-", "")
        if left[w.lower()] > 0:
            left[w.lower()] -= 1
            return w
        return m[0]
    b = words(re.sub(r"\w+(?:-\w+)+", join, md))
    return sorted((a - b).elements()), sorted((b - a).elements())


def converted_path(p, text=None):
    """Where a PDF's or Word file's Markdown copy lives, named by its text."""
    text = doc_text(p) if text is None else text
    return RUNS_DIR / "converted" / f"{p.stem}-{fingerprint(text)[1:]}" / f"{p.stem}.md"


def to_markdown(p):
    """Convert a PDF to Markdown with Claude, so it can be reviewed and edited in
    place. The Markdown lives under RUNS_DIR/converted, named by the PDF's
    text, and is reused when the same PDF comes back, keeping your edits.
    Returns its path, or None if the conversion failed."""
    text = doc_text(p)
    md = converted_path(p, text)
    if md.exists():
        keep_original(p, md)
        log(f"{p.name}: reviewing its Markdown copy {md}")
        return md
    if is_docx(p):
        return docx_to_markdown(p, md)
    if not CLAUDE:
        log(f"{p.name}: claude not found, so the panel reads the PDF itself")
        return None
    links = pdf_links(p)
    links = ("Its links (link text -> URL). Use these URLs exactly:\n"
             + "\n".join(f"{t} -> {u}" for t, u in links)) if links else ""
    log(f"{p.name}: converting to Markdown")
    try:
        r = subprocess.run([CLAUDE, "-p", TO_MD.format(path=p, links=links), "--tools", "Read",
                            "--allowedTools", "Read", "--model", "sonnet"], stdin=subprocess.DEVNULL,
                           capture_output=True, text=True, env=CHILD_ENV, timeout=TIMEOUT)
    except (OSError, subprocess.TimeoutExpired) as e:
        r = SimpleNamespace(returncode=1, stdout="", stderr=str(e))
    out = re.sub(r"\A\s*```(?:markdown|md)?\n(.*)\n```\s*\Z", r"\1", r.stdout, flags=re.S).strip()
    if r.returncode != 0 or not out:
        log(f"{p.name}: conversion failed ({(r.stderr.strip().splitlines() or ['no output'])[0][:120]}), "
            "so the panel reads the PDF itself")
        return None
    md.parent.mkdir(parents=True, exist_ok=True)
    md.write_text(out + "\n")
    keep_original(p, md)
    missing, added = conversion_gaps(p, out)
    report = (f"Words of {p.name} missing from {md.name} ({len(missing)}):\n{' '.join(missing)}\n\n"
              f"Words {md.name} added ({len(added)}):\n{' '.join(added)}\n")
    (md.parent / "conversion-check.txt").write_text(report)
    log(f"{p.name}: Markdown copy at {md}")
    if missing or added:
        show = lambda ws: " ".join(ws[:15]) + (" ..." if len(ws) > 15 else "")
        log(f"  check: {len(missing)} words missing ({show(missing)}), {len(added)} added ({show(added)}). "
            f"Full list: {md.parent / 'conversion-check.txt'}")
    else:
        log("  check: every word of the PDF is in the Markdown, and nothing was added")
    return md


# Word files convert to GitHub Markdown with $...$ math, which reads back the same.
DOCX_MD = "gfm-tex_math_gfm+tex_math_dollars"


def docx_to_markdown(p, md):
    """Convert a Word file to Markdown with pandoc: tracked changes accepted,
    images saved in media/ beside the copy. Returns the copy's path."""
    md.parent.mkdir(parents=True, exist_ok=True)
    r = subprocess.run(["pandoc", str(p), "-t", DOCX_MD, "--wrap=none", "--track-changes=accept",
                        "--extract-media=.", "-o", md.name], cwd=md.parent, capture_output=True, text=True)
    if r.returncode != 0:
        sys.exit(f"error: could not convert {p.name} to Markdown: {r.stderr.strip()[:200]}")
    keep_original(p, md)
    log(f"{p.name}: Markdown copy at {md}")
    return md


def keep_original(p, md):
    """Keep the converted file beside its Markdown copy, so the edited draft can
    be downloaded in its format (a Word file also lends its styles)."""
    if not md.with_suffix(p.suffix.lower()).exists():
        shutil.copyfile(p, md.with_suffix(p.suffix.lower()))


def original_of(path):
    """The PDF or Word file a Markdown copy was converted from, or None."""
    path = Path(path)
    if (RUNS_DIR / "converted").resolve() not in path.resolve().parents:
        return None
    return next((path.with_suffix(e) for e in (".docx", ".pdf") if path.with_suffix(e).exists()), None)


MD_MIME = "text/markdown; charset=utf-8"
DOCX_MIME = "application/vnd.openxmlformats-officedocument.wordprocessingml.document"


def to_docx(md, reader, folder):
    """A Word file of Markdown text, through pandoc. Images resolve from `folder`."""
    with tempfile.TemporaryDirectory() as tmp:
        out = Path(tmp) / "out.docx"
        r = subprocess.run(["pandoc", "-f", reader, "-o", str(out), "--resource-path", str(folder)],
                           input=md, capture_output=True, text=True)
        if r.returncode != 0 or not out.exists():
            raise RuntimeError(f"could not make the Word file: {(r.stderr.strip().splitlines() or ['no output'])[-1][:200]}")
        return out.read_bytes()


def export_draft(path, fmt=None):
    """(file name, MIME type, bytes, edits not placed) of the draft as it is now,
    as Markdown, Word, or (for a draft that came as a PDF) PDF. The default is the
    format it came in. A draft that came as a Word file comes back as the original
    with the edits as tracked changes. Any other Word file is made by pandoc."""
    path, orig = Path(path), original_of(path)
    fmt = fmt or (orig.suffix[1:] if orig else "md")
    name = f"{path.stem}-edited.{fmt}"
    if fmt == "md":
        return name, MD_MIME, path.read_bytes(), []
    if fmt == "docx":
        if orig is not None and orig.suffix == ".docx":
            data, missed = patch_docx(orig, path.read_text())
            return name, DOCX_MIME, data, missed
        return name, DOCX_MIME, to_docx(path.read_text(), "markdown", path.parent), []
    if fmt == "pdf" and orig is not None and orig.suffix == ".pdf":
        with tempfile.TemporaryDirectory() as tmp:
            out = Path(tmp) / name
            r = subprocess.run([str(Path(__file__).resolve().parent / "make-pdf"), path.name, "-o", str(out)],
                               cwd=path.parent, capture_output=True, text=True)
            if r.returncode != 0 or not out.exists():
                raise RuntimeError(f"could not make the PDF: {(r.stderr.strip().splitlines() or ['no output'])[-1][:200]}")
            return name, "application/pdf", out.read_bytes(), []
    raise ValueError(f"the draft cannot be downloaded as .{fmt}")


# Patching a Word file in place. The Markdown copy is compared with a fresh
# conversion of the original, line by line (a table cell counts as a line), and
# each changed line is written into its paragraph in the original as tracked
# changes. Nothing else in the file is touched: comments, citation fields,
# styles, and layout stay as they were. Text inside equations, fields, and
# footnote marks is not edited, and footnotes, tables' shape, and new
# formatting are not carried over. Those edits are returned, to make by hand.
W = "http://schemas.openxmlformats.org/wordprocessingml/2006/main"
M = "http://schemas.openxmlformats.org/officeDocument/2006/math"
XML_SPACE = "{http://www.w3.org/XML/1998/namespace}space"
OBJECT = "\ufffc"  # one character for an equation, image, or footnote mark
OBJECT_MD = re.compile(r"\$\$.+?\$\$|(?<![\\$])\$(?!\$).+?(?<!\\)\$|!\[[^\]]*\]\([^)]*\)|\[\^[^\]]+\]")
w_ = lambda tag: f"{{{W}}}{tag}"


def md_units(md):
    """[(kind, Markdown)] for each line of the draft that is one paragraph in
    Word: a paragraph, heading, list item, or table cell."""
    units = []
    for block in re.split(r"\n\s*\n", md.strip()):
        lines = []
        for line in block.splitlines():
            starts = re.match(r"\s*([-*+]|\d+[.)])\s|\s*#|\s*>|\s*\||\s*\[\^[^\]]+\]:|\s*\$\$", line)
            if lines and not starts and not lines[-1].lstrip().startswith("|"):
                lines[-1] += " " + line.strip()  # a paragraph wrapped over lines
            else:
                lines.append(line)
        for line in lines:
            t = line.strip()
            if re.fullmatch(r"\|?[\s:|-]+\|?", t) and "-" in t:
                continue  # a table's header rule
            if t.startswith("|"):
                cells = re.split(r"(?<!\\)\|", t.strip("|"))
                units += [("cell", c.strip()) for c in cells]
            elif re.match(r"\[\^[^\]]+\]:", t):
                units.append(("footnote", t))
            elif re.match(r"<(table|div|figure|img|!--)\b", t, re.I):  # block HTML; <u> and <sup> are text
                units.append(("html", t))
            else:
                units.append(("text", t))
    return units


def md_plain(units):
    """Each unit's text as Word shows it: markup removed, and each equation,
    image, and footnote mark one OBJECT character."""
    def prep(t):
        t = re.sub(r"^\s*(#+|>|[-*+]|\d+[.)])\s+", "", t)
        t = OBJECT_MD.sub(OBJECT, t)
        return t
    if not units:
        return []
    sep = "XQXSEPXQX"
    src = f"\n\n{sep}\n\n".join(prep(t) or "​" for t in units)
    r = subprocess.run(["pandoc", "-f", DOCX_MD, "-t", "plain", "--wrap=none"], input=src,
                       capture_output=True, text=True, check=True)
    out = [p.strip().replace("​", "") for p in re.split(rf"\n*^{sep}$\n*", r.stdout, flags=re.M)]
    if len(out) != len(units):
        raise RuntimeError("could not read the Markdown's text")
    return out


def para_atoms(p):
    """The paragraph's text in pieces: [{text, el, run, locked}], where el is the
    w:t (or other) element and run its w:r. Locked pieces (equations, fields,
    footnote marks, images) are never edited."""
    atoms, field = [], [0]

    def walk(el, locked):
        for c in el:
            tag = c.tag
            if tag == w_("r"):
                for k in c:
                    if k.tag == w_("fldChar"):
                        kind = k.get(w_("fldCharType"))
                        field[0] += {"begin": 1, "end": -1}.get(kind, 0)
                    elif k.tag == w_("t"):
                        atoms.append({"text": k.text or "", "el": k, "run": c, "locked": locked or field[0] > 0})
                    elif k.tag in (w_("tab"), w_("br"), w_("cr")):
                        atoms.append({"text": " ", "el": k, "run": c, "locked": True})
                    elif k.tag == w_("noBreakHyphen"):
                        atoms.append({"text": "-", "el": k, "run": c, "locked": True})
                    elif k.tag in (w_("drawing"), w_("pict"), w_("object"), w_("sym"),
                                   w_("footnoteReference"), w_("endnoteReference")):
                        atoms.append({"text": OBJECT, "el": k, "run": c, "locked": True})
            elif tag in (f"{{{M}}}oMath", f"{{{M}}}oMathPara"):
                atoms.append({"text": OBJECT, "el": c, "run": None, "locked": True})
            elif tag == w_("fldSimple"):
                walk(c, True)
            elif tag in (w_("hyperlink"), w_("ins"), w_("smartTag"), w_("sdt"), w_("sdtContent"), w_("customXml")):
                walk(c, locked)
            # w:del (text already deleted), w:pPr, bookmarks, and comment marks hold no text
    walk(p, False)
    at = 0
    for a in atoms:
        a["start"], a["end"] = at, at + len(a["text"])
        at = a["end"]
    return atoms


def wnorm(t):
    return re.sub(r"\s+", " ", t.translate(QUOTES).replace(" ", " ")).strip()


def tokens(t):
    """Words, numbers, spaces, and marks. Letters and digits split, since a
    citation number set after a word ("pneumonitis55") is often a field."""
    return re.findall(r"\s+|[^\W\d]+|\d+|[^\w\s]", t)


class Tracker:
    """Writes tracked insertions and deletions into one document.xml tree."""

    def __init__(self, root):
        self.root = root
        ids = [int(v) for e in root.iter() for k, v in e.attrib.items() if k == w_("id") and v.lstrip("-").isdigit()]
        self.next_id = max(ids, default=0) + 1
        self.date = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
        self.parents = {}

    def mark(self, tag):
        self.next_id += 1
        return ET.Element(w_(tag), {w_("id"): str(self.next_id), w_("author"): "Unified review", w_("date"): self.date})

    def parent(self, el):
        if el not in self.parents:
            self.parents = {c: p for p in self.root.iter() for c in p}
        return self.parents[el]

    def split_run(self, run, at):
        """Move the run's children from index `at` on into a new run after it."""
        new = ET.Element(run.tag, dict(run.attrib))
        rpr = run.find(w_("rPr"))
        if rpr is not None:
            new.append(copy.deepcopy(rpr))
        for k in list(run)[at:]:
            run.remove(k)
            new.append(k)
        par = self.parent(run)
        par.insert(list(par).index(run) + 1, new)
        self.parents = {}

    def split_at(self, p, off):
        """Make `off` fall between runs."""
        for a in para_atoms(p):
            if a["start"] < off < a["end"]:  # inside a w:t: cut it in two
                t, k = a["el"], off - a["start"]
                t2 = ET.Element(w_("t"), {XML_SPACE: "preserve"})
                t2.text, t.text = t.text[k:], t.text[:k]
                t.set(XML_SPACE, "preserve")
                kids = list(a["run"])
                a["run"].insert(kids.index(t) + 1, t2)
                break
        for a in para_atoms(p):
            if a["start"] == off and a["run"] is not None:
                kids = list(a["run"])
                i = kids.index(a["el"])
                if any(k.tag != w_("rPr") for k in kids[:i]):
                    self.split_run(a["run"], i)
                return

    def text_run(self, ref, text):
        r = ET.Element(w_("r"))
        rpr = ref.find(w_("rPr")) if ref is not None else None
        if rpr is not None:
            r.append(copy.deepcopy(rpr))
        t = ET.SubElement(r, w_("t"), {XML_SPACE: "preserve"})
        t.text = text
        return r

    def replace(self, p, s, e, new):
        """Replace the paragraph's text [s, e) with `new`, as tracked changes."""
        if e > s:
            self.split_at(p, e)
            self.split_at(p, s)
        else:
            self.split_at(p, s)
        atoms = para_atoms(p)
        runs = []
        for a in atoms:
            if s <= a["start"] and a["end"] <= e and a["end"] > a["start"] and a["run"] not in runs:
                runs.append(a["run"])
        before = [a for a in atoms if a["end"] <= s and a["run"] is not None]
        after = [a for a in atoms if a["start"] >= max(s, e) and a["run"] is not None]
        ref = runs[0] if runs else (before[-1]["run"] if before else after[0]["run"] if after else None)
        last = None
        for run in runs:
            for k in run:
                if k.tag == w_("t"):
                    k.tag = w_("delText")
            par = self.parent(run)
            d = self.mark("del")
            par.insert(list(par).index(run), d)
            par.remove(run)
            d.append(run)
            self.parents = {}
            last = d
        if not new:
            return
        ins = self.mark("ins")
        ins.append(self.text_run(ref, new))
        if last is not None:
            par = self.parent(last)
            par.insert(list(par).index(last) + 1, ins)
        elif before:
            run = before[-1]["run"]
            par = self.parent(run)
            par.insert(list(par).index(run) + 1, ins)
        elif after:
            el = after[0]["run"]
            par = self.parent(el)
            par.insert(list(par).index(el), ins)
        else:
            p.append(ins)
        self.parents = {}

    def mark_paragraph(self, p, tag):
        """Mark the paragraph's own mark as inserted or deleted."""
        ppr = p.find(w_("pPr"))
        if ppr is None:
            ppr = ET.Element(w_("pPr"))
            p.insert(0, ppr)
        rpr = ppr.find(w_("rPr"))
        if rpr is None:
            rpr = ET.Element(w_("rPr"))
            tail = [i for i, k in enumerate(ppr) if k.tag in (w_("sectPr"), w_("pPrChange"))]
            ppr.insert(tail[0] if tail else len(ppr), rpr)
        rpr.insert(0, self.mark(tag))

    def edit(self, p, old, new):
        """Write the change from old to new (both plain text) into paragraph p.
        Returns why it could not, or None."""
        atoms = para_atoms(p)
        text = "".join(a["text"] for a in atoms)
        if wnorm(text) != wnorm(old):
            return "its paragraph in the Word file reads differently"
        if wnorm(old) == wnorm(new):
            return "it changes an equation, image, footnote mark, or formatting, which stays as it was"
        # Keep the paragraph's own leading and trailing spaces (a footnote starts with one).
        new = text[:len(text) - len(text.lstrip())] + new.strip() + text[len(text.rstrip()):]
        a_tok, b_tok = tokens(text), tokens(new)
        key = lambda ts: [" " if t.isspace() else t.translate(QUOTES) for t in ts]
        offs = [0]
        for t in a_tok:
            offs.append(offs[-1] + len(t))
        codes = difflib.SequenceMatcher(None, key(a_tok), key(b_tok), autojunk=False).get_opcodes()
        # Changes with only spaces between them read as one change ("in this" -> "at low").
        merged = []
        for c in codes:
            if (merged and c[0] != "equal" and len(merged) > 1 and merged[-1][0] == "equal"
                    and merged[-2][0] != "equal" and "".join(a_tok[merged[-1][1]:merged[-1][2]]).isspace()):
                gap, prev = merged.pop(), merged.pop()
                c = ("replace", prev[1], c[2], prev[3], c[4])
            merged.append(c)
        ops = []
        for tag, i1, i2, j1, j2 in merged:
            if tag == "equal":
                continue
            s, e, n = offs[i1], offs[i2], "".join(b_tok[j1:j2])
            locked = lambda k: any(a["locked"] and a["start"] <= k < a["end"] for a in atoms)
            while e > s and n and text[e - 1] == n[-1] and locked(e - 1):  # leave unchanged locked text out
                e, n = e - 1, n[:-1]
            while e > s and n and text[s] == n[0] and locked(s):
                s, n = s + 1, n[1:]
            ops.append((s, e, n))
        for s, e, _ in ops:
            if any(a["locked"] and (a["start"] < e and a["end"] > s if e > s else a["start"] < s < a["end"])
                   for a in atoms):
                return "it changes an equation, citation or other field, footnote mark, or image"
        for s, e, n in reversed(ops):
            self.replace(p, s, e, n)
        return None

    def delete_paragraph(self, p):
        atoms = para_atoms(p)
        if any(a["locked"] and a["text"] != " " for a in atoms):
            return "the paragraph holds an equation, citation or other field, footnote mark, or image"
        if atoms:
            self.replace(p, 0, atoms[-1]["end"], "")
        self.mark_paragraph(p, "del")
        return None

    def insert_paragraph(self, anchor, text, before=False):
        """A new paragraph after (or before) `anchor`, styled like it. Returns it."""
        p = ET.Element(w_("p"))
        ppr = anchor.find(w_("pPr"))
        if ppr is not None:
            ppr = copy.deepcopy(ppr)
            for k in list(ppr):
                if k.tag in (w_("rPr"), w_("sectPr"), w_("pPrChange")):
                    ppr.remove(k)
            p.append(ppr)
        self.mark_paragraph(p, "ins")
        ref = next((a["run"] for a in para_atoms(anchor) if a["run"] is not None and not a["locked"]), None)
        ins = self.mark("ins")
        ins.append(self.text_run(ref, text))
        p.append(ins)
        par = self.parent(anchor)
        par.insert(list(par).index(anchor) + (0 if before else 1), p)
        self.parents = {}
        return p


def align(a, b):
    """[(i, j)] pairing the original's units with the edited draft's, in order:
    (i, None) for a unit deleted, (None, j) for a unit added. Within a changed
    stretch, units pair when they are of one kind and alike."""
    out = []
    for tag, i1, i2, j1, j2 in difflib.SequenceMatcher(None, [u[1] for u in a], [u[1] for u in b],
                                                        autojunk=False).get_opcodes():
        if tag == "equal" or (i2 - i1 == j2 - j1 and all(a[i][0] == b[j][0] for i, j in
                                                         zip(range(i1, i2), range(j1, j2)))):
            out += zip(range(i1, i2), range(j1, j2))  # lines edited in place
            continue
        j = j1
        for i in range(i1, i2):
            k = next((k for k in range(j, j2) if a[i][0] == b[k][0] and
                      difflib.SequenceMatcher(None, a[i][1], b[k][1]).ratio() >= 0.4), None)
            if k is None:
                out.append((i, None))
                continue
            out += [(None, n) for n in range(j, k)] + [(i, k)]
            j = k + 1
        out += [(None, n) for n in range(j, j2)]
    return out


def patch_docx(orig, md):
    """(bytes of the Word file `orig` with the Markdown `md`'s changes written in
    as tracked changes, [edits not placed, as {"old", "new", "why"}])."""
    with tempfile.TemporaryDirectory() as tmp:
        # The same command as docx_to_markdown, so image paths match.
        r = subprocess.run(["pandoc", str(Path(orig).resolve()), "-t", DOCX_MD, "--wrap=none", "--track-changes=accept",
                            "--extract-media=."], cwd=tmp, capture_output=True, text=True, check=True)
    a, b = md_units(r.stdout), md_units(md)
    pairs = align(a, b)
    if all(i is not None and j is not None and a[i][1] == b[j][1] for i, j in pairs):
        return Path(orig).read_bytes(), []
    footnote = lambda t: re.sub(r"^\[\^[^\]]+\]:\s*", "", t)
    plain_a = md_plain([footnote(t) for _, t in a])
    plain_b = md_plain([footnote(t) for _, t in b])
    parts, roots = {}, {}
    with zipfile.ZipFile(orig) as z:
        for name in ("word/document.xml", "word/footnotes.xml"):
            if name in z.namelist():
                parts[name] = z.read(name).decode("utf-8")
    for xml in parts.values():
        for prefix, uri in re.findall(r'xmlns:(\w+)="([^"]+)"', xml):
            ET.register_namespace(prefix, uri)
    roots = {n: ET.fromstring(x) for n, x in parts.items()}
    trackers = {n: Tracker(r) for n, r in roots.items()}
    start = max(t.next_id for t in trackers.values())
    for t in trackers.values():  # revision ids unique across both parts
        t.next_id = start
    body = trackers["word/document.xml"]
    notes = trackers.get("word/footnotes.xml")

    class Paras:
        """A part's paragraphs, found by their text, searching forward first."""
        def __init__(self, root):
            self.paras = list(root.iter(w_("p")))
            self.at = collections.defaultdict(list)
            for k, p in enumerate(self.paras):
                self.at[wnorm("".join(x["text"] for x in para_atoms(p)))].append(k)
            self.last = -1

        def find(self, text):
            hits = self.at.get(wnorm(text), [])
            k = next((k for k in hits if k > self.last), hits[0] if hits else None)
            if k is None:
                return None
            self.last = k
            return self.paras[k]

    body_paras = Paras(body.root)
    note_paras = Paras(notes.root) if notes else None
    missed = []
    miss = lambda old, new, why: missed.append({"old": old, "new": new, "why": why})

    def where(i):
        """(tracker, paragraph) of the original's unit i, or (None, None)."""
        if a[i][0] == "footnote":
            return (notes, note_paras.find(plain_a[i])) if notes else (None, None)
        if a[i][0] == "html":
            return None, None
        return body, body_paras.find(plain_a[i])

    prev, waiting = None, []  # the last paragraph placed, and new units with none before them yet
    for i, j in pairs:
        if i is None:
            if b[j][0] != "text":
                miss("", b[j][1], "new table cells and footnotes are not added to the Word file")
            elif prev is None:
                waiting.append(j)
            else:
                prev = body.insert_paragraph(prev, plain_b[j])
            continue
        tr, p = where(i)
        if j is not None and a[i][1] == b[j][1]:
            pass
        elif p is None:
            miss(a[i][1], b[j][1] if j is not None else "",
                 "HTML tables are not edited in the Word file" if a[i][0] == "html"
                 else "its paragraph was not found in the Word file")
        elif j is None:
            why = tr.delete_paragraph(p) if a[i][0] == "text" else "table cells and footnotes are not removed"
            if why:
                miss(a[i][1], "", why)
        else:
            why = tr.edit(p, plain_a[i], plain_b[j])
            if why:
                miss(a[i][1], b[j][1], why)
            elif OBJECT_MD.findall(footnote(a[i][1])) != OBJECT_MD.findall(footnote(b[j][1])):
                miss(a[i][1], b[j][1], "its text changed in the Word file, but not its equation, image, or footnote mark")
        if p is not None and tr is body:
            if waiting:  # new units at the very start go before the first paragraph found
                for n in waiting:
                    body.insert_paragraph(p, plain_b[n], before=True)
                waiting = []
            prev = p
    for n in waiting:
        miss("", b[n][1], "there was no paragraph to place it by")

    out = io.BytesIO()
    with zipfile.ZipFile(orig) as zin, zipfile.ZipFile(out, "w", zipfile.ZIP_DEFLATED) as zout:
        for item in zin.infolist():
            data = zin.read(item.filename)
            if item.filename in roots:
                xml = parts[item.filename]
                new = ET.tostring(roots[item.filename], encoding="unicode")
                # ElementTree drops namespace declarations it does not use, but Word
                # needs the ones mc:Ignorable names. Keep the original root tag.
                head, keep = re.match(r"<[^>]+>", new)[0], re.search(r"<(?!\?)[^>]+>", xml)[0]
                more = "".join(f" {d}" for d in re.findall(r'xmlns:\w+="[^"]*"', head) if d not in keep)
                new = keep[:-1] + more + ">" + new[len(head):]
                data = ('<?xml version="1.0" encoding="UTF-8" standalone="yes"?>\r\n' + new).encode("utf-8")
            zout.writestr(item, data)
    return out.getvalue(), missed


def locate(quote, files):
    """(full path, 1-based line or page, "line" or "page") where a quote's text
    sits in the files now, or None."""
    q = norm(quote)[:40]
    if not q:
        return None
    for f in files:
        p = Path(f)
        if not p.exists():
            continue
        if is_pdf(p):
            # A quote copied across table columns carries the column gaps (3+ spaces)
            # and has other cells' text between its parts on the page: match each part.
            parts = [s for s in (norm(s) for s in re.split(r" {3,}", quote.strip())) if s]
            for i, page in enumerate(doc_text(p).split("\f")):
                page = norm(page)
                if q in page or (len(parts) > 1 and all(s in page for s in parts)):
                    return p, i + 1, "page"
            continue
        lines = p.read_text().splitlines()
        for i, line in enumerate(lines):
            if q in norm(line):
                return p, i + 1, "line"
        # A quote that wraps a line break: match the start of the quote on line i.
        for i in range(len(lines) - 1):
            joined = norm(lines[i] + " " + lines[i + 1])
            if q in joined and joined.find(q) < len(norm(lines[i])):
                return p, i + 1, "line"
    return None


def osa_distance(a, b):
    """Edit distance counting a swap of two neighboring letters as one edit."""
    d = [[i + j if not i * j else 0 for j in range(len(b) + 1)] for i in range(len(a) + 1)]
    for i in range(1, len(a) + 1):
        for j in range(1, len(b) + 1):
            d[i][j] = min(d[i - 1][j] + 1, d[i][j - 1] + 1, d[i - 1][j - 1] + (a[i - 1] != b[j - 1]))
            if i > 1 and j > 1 and a[i - 1] == b[j - 2] and a[i - 2] == b[j - 1]:
                d[i][j] = min(d[i][j], d[i - 2][j - 2] + 1)
    return d[-1][-1]


def typo_change(old, new):
    """(before, after) when a change only fixes a typo: one misspelled or
    miscapitalized word, or a doubled word. None for anything else, including
    changes to numbers or punctuation."""
    if not old or not new or old == new:
        return None
    a, b = old.split(), new.split()
    ops = [o for o in difflib.SequenceMatcher(None, a, b, autojunk=False).get_opcodes() if o[0] != "equal"]
    if len(ops) != 1:
        return None
    op, i1, i2, j1, j2 = ops[0]
    if op == "replace" and i2 - i1 == 1 and j2 - j1 == 1:
        x, y = a[i1], b[j1]
        core = lambda w: w.strip(".,;:!?\"'()[]*_")
        if re.search(r"\d", x + y) or core(x) == core(y):  # numbers, or punctuation only
            return None
        n, dist = max(len(core(x)), len(core(y))), osa_distance(x, y)
        swap = dist == 1 and sorted(x) == sorted(y)
        if (n >= 7 and dist <= 2) or (n >= 4 and dist == 1) or (n >= 3 and swap):
            return x, y
        return None
    if op == "delete" and i2 - i1 == 1 and any(0 <= k < len(a) and a[k].lower() == a[i1].lower()
                                               for k in (i1 - 1, i1 + 1)):
        return f"{a[i1]} {a[i1]}", a[i1]
    return None


def is_typo(g):
    """A finding in the draft whose diff only fixes a typo, and that no voter
    other than the one that raised it disagreed with."""
    if g.get("where") != "draft":
        return False
    if any(v["vote"] == "disagree" for m, v in g.get("votes", {}).items() if m != g.get("self_voter")):
        return False
    old, new = diff_parts(g["rep"]["body"])
    return old is not None and typo_change(old, new) is not None


ORDER = SEVERITIES + ["Typo"]  # typos come last, listed together


def ordered_findings(r):
    """Findings as numbered in unified.md: [(n, severity, where label, group)].
    Grouped by severity, with typos last. Within each: whole-draft findings,
    then the draft from top to bottom, then findings on the author's focus
    material. Findings held back to stop churn are left out."""
    out = []
    for g in (g for g in r["groups"] if not g["rejected"] and not g.get("declined") and not g.get("held")):
        if g["where"] == "overview":
            spot, label = (0, -g["frac"]), "Whole draft"
        elif g["where"] == "draft":
            spot, label = (1, g["pos"]), section_of(g["pos"], r["headings"])
        else:
            spot, label = (2, g.get("fpos", 0)), "Focus or supporting material"
        sev = "Typo" if is_typo(g) else canon_sev(g["severity"])
        # Findings added later by a review of an edit go last, so earlier numbers stay put.
        logic = g.get("kind") == "logic" and sev != "Typo"  # logic flaws come first, by severity
        key = ((len(ORDER), g["added"]) + spot if g.get("added")
               else (-1, ORDER.index(sev)) + spot if logic else (ORDER.index(sev), 0) + spot)
        out.append((key, sev, label, g))
    out.sort(key=lambda x: x[0])
    return [(n, sev, label, g) for n, (_, sev, label, g) in enumerate(out, 1)]


def fingerprint(text):
    """Short content hash that names a version of a file."""
    return "v" + hashlib.sha256(text.encode()).hexdigest()[:7]


def version_number(path, fp, register=True):
    """SVN-style version of a file: 1 for the first text reviewed, 2 for the next
    different text, and so on. Unchanged text keeps its number. The registry
    lives in RUNS_DIR/versions.json. Returns None for unseen text if not register."""
    reg_file = RUNS_DIR / "versions.json"
    reg = json.loads(reg_file.read_text()) if reg_file.exists() else {}
    seen = reg.setdefault(str(path), [])
    if fp not in seen:
        if not register:
            return None
        seen.append(fp)
        RUNS_DIR.mkdir(parents=True, exist_ok=True)
        write_atomic(reg_file, json.dumps(reg, indent=1) + "\n")
    return seen.index(fp) + 1


def project_name(folder):
    """The git repository's name, else the folder's, so a file in build/ or docs/
    still names its project."""
    try:
        top = subprocess.run(["git", "-C", str(folder), "rev-parse", "--show-toplevel"],
                             capture_output=True, text=True, timeout=10).stdout.strip()
    except (OSError, subprocess.SubprocessError):
        top = ""
    return Path(top).name if top else folder.name


def file_version(p, text, outdir, number=None):
    """Record which version of a file is reviewed, and keep a copy of it."""
    snap = outdir / "reviewed" / p.name
    snap.parent.mkdir(exist_ok=True)
    shutil.copyfile(p, snap) if is_pdf(p) else snap.write_text(text)
    git = {}
    try:
        run = lambda *a: subprocess.run(["git", "-C", str(p.parent), *a], capture_output=True,
                                        text=True, timeout=10).stdout.strip()
        commit = run("log", "-1", "--format=%h", "--", p.name)
        if commit:
            git = {"commit": commit, "dirty": bool(run("status", "--porcelain", "--", p.name))}
    except (OSError, subprocess.SubprocessError):
        pass
    return {"path": str(p), "number": number, "version": fingerprint(text), "copy": str(snap), "git": git}


def version_text(v):
    g = v.get("git") or {}
    gtxt = (f", git {g['commit']}" + (" plus uncommitted edits" if g["dirty"] else "")) if g else ""
    name = f"version {v['number']}" if v.get("number") else f"version `{v['version']}`"
    return name + gtxt


def changed_since(v):
    p = Path(v["path"])
    if not p.exists():
        return "file no longer exists"
    now = fingerprint(doc_text(p))
    if now == v["version"]:
        return "unchanged"
    n = version_number(p, now, register=False)
    return f"changed (now version {n})" if n else "changed (newer than any reviewed version)"


def quoted(g, files, where_label=""):
    """Where a finding sits (section, file, line) and the text it is about."""
    q = g["rep"]["quote"].strip()
    if not q:
        return f"*{where_label}*\n\n" if where_label else ""
    if g["where"] == "focus":
        head = "Focus or supporting material:"
    else:
        loc = locate(q, files)
        place = f"{loc[0].name}, {loc[2]} {loc[1]}" if loc else "quoted text not found in the file"
        dup = loc and where_label == loc[0].name  # no headings: the section is the file
        head = f"{where_label} · {place}:" if where_label and not dup else f"{place}:"
    if "~~" in g["rep"]["body"] or "🟢" in g["rep"]["body"]:
        return ""  # the diff shows the text, so do not quote it twice
    block = "\n".join("> " + line for line in q.splitlines())
    return f"{block}\n\n"


def participation(fails, roles, names, consequence):
    """Lines saying which panelists failed, and a warning when too few took part.
    roles: [(verb, models that did it)]."""
    out = []
    if fails:
        out.append("*Failed: " + "; ".join(
            f"{names([f['model']])} {f['stage']} ({f['reason']})" for f in fails) + ".*")
    few = [verb for verb, ms in roles if len(ms) < 2]
    if few:
        out.append(f"**Warning: fewer than two models {' and '.join(few)}. {consequence}**")
    return out


def render(outdir):
    """Write unified.md from results.json."""
    r = json.loads((outdir / "results.json").read_text())
    labels, voters = r["labels"], r["voters"]
    names = lambda ms: ", ".join(labels.get(m, m) for m in ms)
    rejected = sorted((g for g in r["groups"] if g["rejected"]), key=lambda g: g["pos"])

    vers = r.get("versions") or [{"path": f} for f in r["files"]]
    parts = ["# " + ", ".join(Path(v["path"]).name + (f", version {v['number']}" if v.get("number") else
                                                      f" ({v['version']})" if "version" in v else "")
                              for v in vers) + (f", {r['started']}" if r.get("started") else "")]
    parts += participation(r.get("failures"), [("reviewed", r["reviewers_ok"]), ("voted", voters)], names,
                           "Agreement, duplicate grouping, and rejection by vote mean little in this run.")
    if r["verify"]:
        parts.append("*Fact-check running. Results go to factcheck.md.*")
    # Nitpicks, typos, and the script's checks are one list, after the other findings.
    current, nits = None, []
    for n, sev, where_label, g in ordered_findings(r):
        group = "Logic" if g.get("kind") == "logic" and sev != "Typo" else sev
        if sev in ("Nitpick", "Typo"):  # one item: where it is, and the change, or the point when it has no diff
            paras = [p.strip() for p in strip_end(g["rep"]["body"]).split("\n\n") if p.strip()]
            diff = " ".join(p for p in paras if "~~" in p or "🟢" in p) or " ".join(paras[:1])
            loc = locate(g["rep"]["quote"], r["files"]) if g["rep"]["quote"].strip() and g["where"] != "focus" else None
            at = ", ".join(x for x in (where_label if where_label not in [Path(f).name for f in r["files"]] else "",
                                       f"{loc[2]} {loc[1]}" if loc else "") if x)  # a draft with no headings: just the line
            nits.append(f"- **{n}.** {g['rep']['title']}{f' (*{at}*)' if at else ''}: {diff}"
                        f"{' (typo)' if sev == 'Typo' else ''}".replace("\n", " "))
            continue
        if group != current:
            current = group
            parts.append({"Logic": "## Logical flaws"}.get(group, f"## {group}"))
        # Escape headings inside a reviewer's diff so they do not become sections here.
        body = re.sub(r"^(\s*(?:🟢\s*)?(?:\*\*)?)#", r"\1\\#", strip_end(g["rep"]["body"]), flags=re.M)
        tag = ((f" ({sev})" if group == "Logic" else f" ({g['kind']})" if g.get("kind") else "")
               + (" (question)" if g.get("form") == "question" else "")
               + (" (contested)" if g.get("contested") else "")
               )
        parts.append(f"### {n}. {g['rep']['title']}{tag} {marks(g, voters)}".rstrip() + "\n\n"
                     f"{quoted(g, r['files'], where_label)}{body}")
    nits += [f"- **{c['id']}.** {c['what']} (*line {c['line']}*), found by the script" for c in r.get("checks") or []]
    if nits:
        parts.append("## Nitpicks\n\nWording-level fixes: the panel's nitpicks, typos no voter disputed, and checks "
                     "the script ran without a model.\n\n" + "\n".join(nits))
    since = r.get("since_last") or {}
    if since.get("resolved") or since.get("dropped"):
        parts.append("## Since the last review\n\n" + "\n".join(
            [f"- Resolved: {t} (its passage changed)" for t in since.get("resolved", [])]
            + [f"- Not raised again: {t} (its passage is unchanged)" for t in since.get("dropped", [])]))
    held = [g for g in r["groups"] if g.get("declined") and not g["rejected"]]
    if held:
        parts.append("## Previously declined\n\nHeld back because you declined the same point before. "
                     "To see one again, run `unified-review --unignore D<n>`.\n\n" + "\n".join(
                         f"- {g['rep']['title']} (matches {g['declined']['id']}: {g['declined']['title']})"
                         for g in held))
    settled = [g for g in r["groups"] if g.get("held") and not g["rejected"] and not g.get("declined")]
    if settled:
        parts.append("## Held back to stop churn\n\nThese would change a passage that changed recently, "
                     "or restore wording from an earlier version.\n\n" + "\n".join(
                         f"- {g['rep']['title']} ({canon_sev(g['severity'])}: {g['held']})" for g in settled))
    if rejected:
        parts.append("## Not reported\n\nNo second model backed these.\n\n" + "\n".join(
            f"- {g['rep']['title']}" for g in rejected))
    ag = r.get("agreement") or {}
    if ag.get("alpha") is not None:
        ci = f", 95% CI {ag['ci95'][0]} to {ag['ci95'][1]}" if ag.get("ci95") else ""
        key = " · ".join(sorted({f"{GLYPH.get(lab_icon(m), lab_icon(m))} {short(m)}" for m in voters}))
        parts.append(f"## Agreement\n\nBeside each title: the labs that flagged it ({key}), then each other "
                     f"model's vote, ✓ agree, ~ partial, ✗ disagree.\n\n*Krippendorff's alpha {ag['alpha']}{ci}, {ag['units']} findings.*")
    write_atomic(outdir / "unified.md", "\n\n".join(parts) + "\n")


LAST_RUN = Path.home() / ".local/state/unified-review/last-run"
# Runs live in one folder outside every project.
RUNS_DIR = Path(os.environ.get("UNIFIED_REVIEW_RUNS") or Path.home() / ".local/share/unified-review/runs")


def latest_run():
    """Newest run that reviewed a file under the current folder, else the last run made."""
    here = str(Path.cwd().resolve())
    runs = []
    for rj in RUNS_DIR.glob("*/results.json"):
        try:
            files = json.loads(rj.read_text()).get("files", [])
        except ValueError:
            continue
        if any(f == here or f.startswith(here + os.sep) for f in files):
            runs.append(rj)
    if runs:
        return max(runs, key=lambda p: p.stat().st_mtime).parent
    if LAST_RUN.exists() and (Path(LAST_RUN.read_text().strip()) / "results.json").exists():
        return Path(LAST_RUN.read_text().strip())
    sys.exit(f"error: no unified-review run found in {RUNS_DIR}")


def show_items(spec, run):
    """Print findings (by number) and fact-check claims (K numbers) for an agent to act on."""
    r = json.loads((run / "results.json").read_text())
    fcp = run / "factcheck.json"
    fc = json.loads(fcp.read_text()) if fcp.exists() else None
    found = {n: (f"{sev}, {label}", g) for n, sev, label, g in ordered_findings(r)}
    print(f"Run folder: {run}")
    print("Reviewed file(s), edit these: " + ", ".join(r["files"]))
    for v in r.get("versions", []):
        print(f"Reviewed {Path(v['path']).name} at {version_text(v).replace('`', '')}. "
              f"Since then: {changed_since(v).replace('`', '')}. Reviewed copy: {v['copy']}")
    print()
    for item in [x.strip().upper() for x in spec.split(",") if x.strip()]:
        if item.startswith("K"):
            c = next((c for c in (fc or {}).get("claims", []) if c["k"] == item), None)
            if not c:
                print(f"== {item}: not found" + ("" if fc else " (no fact-check in this run)") + "\n")
                continue
            loc = locate(c["quote"], r["files"])
            print(f"== {item}: fact-check, {c['verdict']}")
            print(f"Location now: {f'{loc[0]}, {loc[2]} {loc[1]}' if loc else 'not in the current file (already edited?)'}")
            print(f"Sentence: {c['quote']}\nClaim: {c['claim']}  Citation: {c['cite']}")
            for m, row in c["per"].items():
                if row:
                    print(f"- {short(m)}: {row[0]}. {row[2]} {row[1] if row[1].startswith('http') else ''}")
            print()
            continue
        if not item.isdigit() or int(item) not in found:
            print(f"== {item}: not found (findings are numbered 1-{len(found)})\n")
            continue
        sec, g = found[int(item)]
        loc = locate(g["rep"]["quote"], r["files"]) if g["rep"]["quote"] else None
        print(f"== Finding {item}: {g['rep']['title']} ({canon_sev(g['severity'])})")
        print(f"Section: {sec}")
        print("Location now: " + (f"{loc[0]}, {loc[2]} {loc[1]}" if loc else
          "not in the current file (already edited?)" if g["rep"]["quote"] else "whole draft"))
        print(f"Quote: {g['rep']['quote'] or '(none)'}")
        print(f"Votes: {vote_line(g, r['voters']).replace('**', '')}  (bold in unified.md = raised it)")
        d = decision_for(run.name, g["rep"]["title"])
        if d:
            print(f"Already decided: {d['decision']} ({d['id']}, {d.get('date', '')})"
                  + (f". Note: {d['note']}" if d.get("note") else ""))
        print(f"\n{g['rep']['body']}\n")
    # The current text, so whoever acts on these items judges them against it.
    for f in r["files"]:
        p = Path(f)
        print(f"===== Current text of {p} (line-numbered) =====")
        if not p.exists():
            print("(file no longer exists)\n")
            continue
        if is_pdf(p):
            print("(a PDF: read it directly. Edits go in its source document.)\n")
            continue
        lines = p.read_text().splitlines()
        width = len(str(len(lines)))
        print("\n".join(f"{i:>{width}}| {line}" for i, line in enumerate(lines, 1)) + "\n")

def foreground(files, draft, panel, focus, rules, outdir, workdir, verify, versions, context=None, shown=None):
    shown = shown or draft  # what the panel is given: the text, or a PDF's path
    timings = {}
    declines, applied = active_decisions(files, norm(draft))
    decided = (DECK_NOTE if DECK else "") + decisions_block(declines, applied)
    if declines or applied:
        log(f"using {len(declines)} declined and {len(applied)} applied points from past rounds")
    ctx_block, ctx_text, ctx_names = context or ("", "", [])
    if ctx_names:
        log(f"supporting material: {', '.join(ctx_names)}")
    prev = previous_open(files[0]) if len(files) == 1 and not is_pdf(files[0]) else []
    if prev:
        log(f"carrying {len(prev)} open findings from the last review")
    prompt = review_prompt(shown, focus, rules, decided + open_block(prev), ctx_block)
    (outdir / "prompt.md").write_text(prompt)
    log(f"1/3 review (no web): {', '.join(panel)}")

    def review(m):
        t = time.time()
        # Not "<model>.md": Claude Code loads claude.md as CLAUDE.md on macOS.
        fs = None
        for attempt in (1, 2):  # retry once if the reply is not in the expected format
            r = call(m, prompt, outdir / f"review-{m}.md", workdir, stage="review")
            fs = parse_findings(r) if r else None
            if fs or r is None:
                break
            if NO_FINDINGS.search(r):  # a review that found nothing to change
                fs = []
                break
            fs = None
            if attempt == 2:
                fail("review", m, "reply had no findings in the expected format, after one retry")
        timings[f"review_{m}"] = round(time.time() - t, 1)
        if fs is not None:
            log(f"  {m}: review done, {len(fs)} finding{'' if len(fs) == 1 else 's'} ({timings[f'review_{m}']:.0f} s)")
        return fs
    found = {m: fs for m, fs in parallel(review, panel).items() if fs is not None}
    if len(found) < len(panel) and STANDIN not in panel:
        log(f"  {STANDIN} stands in for {', '.join(m for m in panel if m not in found)}")
        panel = panel + [STANDIN]
        fs = review(STANDIN)
        if fs is not None:
            found[STANDIN] = fs
    if not found:
        sys.exit("error: no reviewer produced a review")
    ok = [m for m in panel if m in found]

    # Anonymize: random letter per reviewer, findings interleaved by draft position.
    letters = dict(zip(random.sample(ok, len(ok)), "ABCDEFGH"))
    owner = {v: k for k, v in letters.items()}
    dnorm = norm(draft)
    flat = []
    for m, fs in found.items():
        for i, f in enumerate(fs, 1):
            flat.append({**f, "id": f"{letters[m]}{i}", "pos": position(dnorm, f["quote"])})
    flat.sort(key=lambda f: (f["pos"], f["id"]))
    fmt = lambda f: f"[{f['id']}] ({f['severity']}{', question' if f.get('form') == 'question' else ''}) {f['title']}\nquote: {f['quote'] or '(none)'}\n{f['body']}"
    log(f"2/3 vote on {len(flat)} findings: {', '.join(ok)}")

    def vote(m):
        """A model votes only on other models' findings. Its own are listed for
        reference, so it can still name one in same:, but it does not vote on them."""
        t = time.time()
        mine = letters.get(m)
        listed = "\n\n".join(fmt(f) for f in flat if f["id"][0] != mine)
        own = [f for f in flat if f["id"][0] == mine]
        if own:
            listed += ("\n\n<your_own_findings>\nYou raised these. Do not vote on them. You may name one in same:"
                       " when a finding above makes the same point.\n"
                       + "\n".join(f"[{f['id']}] {f['title']}" for f in own) + "\n</your_own_findings>")
        prompt_v = VOTE.format(draft=shown, findings=listed, decided=decided,
                               context=(CONTEXT_INTRO + ctx_block) if ctx_block else "",
                               focus=f"\n<author_focus>\n{focus}\n</author_focus>\n" if focus else "")
        v = None
        for attempt in (1, 2):  # retry once if the reply has no vote lines
            r = call(m, prompt_v, outdir / f"votes-{m}.txt", workdir, stage="vote")
            v = parse_votes(r) if r else None
            if v or r is None:
                break
            if attempt == 2:
                fail("vote", m, "reply had no vote lines in the expected format, after one retry")
        timings[f"vote_{m}"] = round(time.time() - t, 1)
        if v:
            log(f"  {m}: vote done, {len(v)} vote{'' if len(v) == 1 else 's'} ({timings[f'vote_{m}']:.0f} s)")
        return v or None
    if not flat:  # every reviewer found nothing to change: nothing to vote on
        log("  no findings to vote on")
        votes = {m: {} for m in ok}
    else:
        votes = {m: v for m, v in parallel(vote, ok).items() if v}
    if len(votes) < len(ok) and STANDIN not in panel:
        log(f"  {STANDIN} stands in to vote for {', '.join(m for m in ok if m not in votes)}")
        panel = panel + [STANDIN]
        v = vote(STANDIN)
        if v:
            votes[STANDIN] = v
    if not votes:
        sys.exit("error: every voter failed")
    voters = [m for m in panel if m in votes]

    groups = [score_group(g, votes, voters, owner) for g in group_findings(flat, votes)]
    material = focus + "\n" + ctx_text  # findings may quote the focus or the supporting material
    fnorm = norm(material)
    for g in groups:
        g["where"] = where(g, dnorm, material)
        g["fpos"] = fnorm.find(norm(g["rep"]["quote"])[:60]) if g["where"] == "focus" else 0
        # Held back: a voter matched it to a declined point, or it quotes the same text.
        ids = {d["id"]: d for d in declines}
        hit = next((v["same"] for m in voters for fid in g["members"]
                    for v in [votes[m].get(fid, {})] if v.get("same") in ids), None)
        if not hit and g["rep"]["quote"]:
            hit = next((d["id"] for d in declines if d["quote"]
                        and norm(d["quote"]) == norm(g["rep"]["quote"])), None)
        if hit:
            g["declined"] = {"id": hit, "title": ids[hit]["title"]}
    mech, since = [], carry_over(groups, prev, dnorm)
    if len(files) == 1 and not is_pdf(files[0]):
        text = files[0].read_text()
        mech = checks(text, files[0], DECK)
        history = reviewed_history(files[0], text)
        for g in groups:
            if not g["rejected"] and not g.get("declined"):
                why = churn(g, text, history)
                if why:
                    g["held"] = why
    n_rej = sum(g["rejected"] for g in groups)
    n_dec = sum(bool(g.get("declined")) for g in groups)
    n_held = sum(bool(g.get("held")) for g in groups)
    log(f"3/3 render: {len(flat)} findings in {len(groups)} groups, {n_rej} rejected by vote"
        + (f", {n_dec} held back as previously declined" if n_dec else "")
        + (f", {n_held} held back to stop churn" if n_held else ""))

    (outdir / "results.json").write_text(json.dumps({
        "files": [str(p) for p in files], "versions": versions, "context": ctx_names,
        "started": STARTED,
        "panel": panel, "reviewers_ok": ok, "voters": voters,
        "labels": {m: label(m) for m in panel}, "verify": verify,
        "failures": FAILURES, "agreement": vote_agreement(flat, votes, owner),
        "anonymization": letters, "timings_s": timings, "headings": slide_headings(draft) if DECK else draft_headings(draft), "deck": DECK,
        "findings": flat, "votes": votes, "groups": groups, "checks": mech, "since_last": since}, indent=1, ensure_ascii=False) + "\n")
    render(outdir)
    LAST_RUN.parent.mkdir(parents=True, exist_ok=True)
    LAST_RUN.write_text(str(outdir))
    return outdir / "unified.md"


# ---------------------------------------------------------------- background

def confirmed_before(files, outdir, dnorm):
    """Claims the newest earlier fact-check of these files confirmed, whose quoted
    text is still in the draft: {normalized quote: (claim row, run name)}."""
    names, runs = [str(p) for p in files], []
    for fj in RUNS_DIR.glob("*/factcheck.json"):
        rj = fj.parent / "results.json"
        if fj.parent == outdir or not rj.exists():
            continue
        try:
            if json.loads(rj.read_text()).get("files") == names:
                runs.append(fj)
        except ValueError:
            continue
    if not runs:
        return {}
    last = max(runs, key=lambda p: p.stat().st_mtime)
    rows = json.loads(last.read_text()).get("claims", [])
    return {norm(c["quote"]): (c, c.get("carried") or last.parent.name) for c in rows
            if c["verdict"] == "confirmed" and c.get("pos") is not None and norm(c["quote"]) and norm(c["quote"]) in dnorm}


def background(files, draft, panel, outdir, workdir, shown=None):
    shown = shown or draft
    timings = {}
    t0 = time.time()
    lead = panel[0]
    claims = None
    for m in panel:  # first panelist that answers lists the claims
        text = run_timed(timings, f"claims_{m}", call, m, CLAIMS.format(draft=shown),
                         outdir / "claims.txt", workdir, False, "claims")
        claims = parse_rows(text, 4)
        if claims:
            lead = m
            break
    rows, checkers, carried = [], [], {}
    if claims:
        # A claim an earlier run confirmed, with its text unchanged, keeps that verdict.
        dnorm = norm(draft)
        before = confirmed_before(files, outdir, dnorm)
        carried = {k: before[norm(q)] for k, (q, _, _) in claims.items() if norm(q) in before}
        listing = "\n".join(f"{k} | {c} | {cite}" for k, (_, c, cite) in claims.items() if k not in carried)

        def verify(m):
            t = time.time()
            r = call(m, VERIFY.format(claims=listing, draft=shown), outdir / f"verify-{m}.txt", workdir,
                     web=True, stage="verify")
            if r and not parse_rows(r, 4):
                fail("verify", m, "reply had no claim lines in the expected format")
            timings[f"verify_{m}"] = round(time.time() - t, 1)
            return parse_rows(r, 4) or None
        checks = {m: c for m, c in parallel(verify, panel).items() if c} if listing else {}
        checkers = [m for m in panel if m in checks]
        for k, (quote, claim, cite) in claims.items():
            if k in carried:
                old, run = carried[k]
                pos = position(dnorm, quote)
                rows.append({"k": k, "quote": quote, "claim": claim, "cite": cite, "per": old["per"],
                             "verdict": "confirmed", "urls": old["urls"], "carried": run,
                             "pos": pos if pos < len(dnorm) else None})
                continue
            per = {m: checks[m].get(k) for m in checkers}
            vs = [p[0].lower() for p in per.values() if p and p[0].lower() in VERDICTS]
            pos = position(dnorm, quote)
            rows.append({"k": k, "quote": quote, "claim": claim, "cite": cite, "per": per,
                         "verdict": min(vs, key=VERDICTS.index) if vs else "unchecked",
                         "urls": sorted({p[1] for p in per.values() if p and p[1].startswith("http")}),
                         "pos": pos if pos < len(dnorm) else None})
    labels = {m: label(m) for m in panel}

    # factcheck.md in draft order, under the draft's section headings.
    counts = {v: sum(c["verdict"] == v for c in rows) for v in VERDICTS + ["unchecked"]}
    md = [f"# Fact-check: {', '.join(p.name for p in files)}, {time.strftime('%Y-%m-%d %H:%M')}",
          f"*{len(rows)} claims listed by {labels[lead]}, checked with web search by "
          f"{', '.join(labels[m] for m in checkers) or 'nobody'}. Each verdict is the most "
          f"cautious across checkers. "
          + (f"{len(carried)} confirmed claims with unchanged text kept their earlier verdict. " if carried else "")
          + f"Ran {round(time.time() - t0)} s. "
          + ", ".join(f"{n} {v}" for v, n in counts.items() if n) + ".*"]
    md += participation(FAILURES, [("checked claims", checkers)],
                        lambda ms: ", ".join(labels.get(m, m) for m in ms),
                        "Verdicts rest on a single checker or none.")
    heads, current = draft_headings(draft), None
    for c in sorted(rows, key=lambda c: (c["pos"] is None, c["pos"] or 0, int(c["k"][1:]))):
        h = section_of(c["pos"], heads) if c["pos"] is not None else "Claims not located in the draft"
        if h != current:
            current = h
            md.append(f"## {h}")
        md.append(fc_note(c, labels))
    write_atomic(outdir / "factcheck.md", "\n\n".join(md) + "\n")
    (outdir / "factcheck.json").write_text(json.dumps({
        "timings_s": timings, "lead": lead, "checkers": checkers, "labels": labels,
        "failures": FAILURES, "claims": rows}, indent=1, ensure_ascii=False) + "\n")
    if sys.platform == "darwin":
        subprocess.run(["osascript", "-e", f'display notification "Fact-check done: {files[0].name}" '
                        f'with title "unified-review"'], stderr=subprocess.DEVNULL, env=CHILD_ENV)
    open_file(outdir / "factcheck.md")


# ---------------------------------------------------------------- iterating

def snapshot(p):
    """Save a copy of the file beside it, named by its version (memo-v8.md), and
    make sure git ignores those copies. Returns the copy's path."""
    p = Path(p).resolve()
    n = version_number(p, fingerprint(doc_text(p)))
    copy = p.with_name(f"{p.stem}-v{n}{p.suffix}")
    shutil.copyfile(p, copy)
    git = lambda *a: subprocess.run(["git", "-C", str(p.parent), *a], capture_output=True, text=True)
    top = git("rev-parse", "--show-toplevel").stdout.strip()
    if top and git("check-ignore", "-q", str(copy)).returncode != 0:
        rel = p.parent.relative_to(top).as_posix()
        line = f"/{rel + '/' if rel != '.' else ''}{p.stem}-v*{p.suffix}"
        gi = Path(top) / ".gitignore"
        old = gi.read_text() if gi.exists() else ""
        gi.write_text(old + ("" if not old or old.endswith("\n") else "\n") + line + "\n")
        log(f"added {line} to {gi}")
    return copy


def inline_diff(old, new):
    """One paragraph's changes in the house format: ~~deleted~~ and 🟢 **added**.
    A mostly rewritten paragraph is struck whole and followed by the new one."""
    tok = lambda t: re.findall(r"\n|[^\s]+", t)
    a, b = tok(old), tok(new)
    sm = difflib.SequenceMatcher(None, a, b, autojunk=False)
    if old and new and sm.ratio() < 0.5:
        return f"~~{old.strip()}~~\n\n🟢 **{new.strip()}**"
    join = lambda ts: " ".join(ts).replace(" \n ", "\n").replace("\n ", "\n").replace(" \n", "\n")
    out = []
    for op, i1, i2, j1, j2 in sm.get_opcodes():
        if op == "equal":
            out.append(join(a[i1:i2]))
            continue
        if i2 > i1:
            out.append(f"~~{join(a[i1:i2]).strip()}~~")
        if j2 > j1:
            out.append(f"🟢 **{join(b[j1:j2]).strip()}**")
    return join(out)


def changes(old_text, new_text):
    """The changed paragraphs of a document, each under its section heading."""
    paras = lambda t: [x for x in re.split(r"\n\s*\n", t.strip()) if x.strip()]
    a, b = paras(old_text), paras(new_text)
    out, heading, shown = [], None, None
    for op, i1, i2, j1, j2 in difflib.SequenceMatcher(None, a, b, autojunk=False).get_opcodes():
        if op == "equal":
            heading = next((x for x in reversed(b[j1:j2]) if x.startswith("#")), heading)
            continue
        if heading and heading != shown:
            out.append(heading)
            shown = heading
        olds, news = a[i1:i2], b[j1:j2]
        for k in range(max(len(olds), len(news))):
            o = olds[k] if k < len(olds) else ""
            n = news[k] if k < len(news) else ""
            out.append(inline_diff(o, n) if o and n else f"~~{o.strip()}~~" if o else f"🟢 **{n.strip()}**")
        heading = next((x for x in reversed(news) if x.startswith("#")), heading)
    return out


def write_changes(p, start):
    """Write <stem>-v<start>-to-v<now> beside the file: what changed since version
    <start>, whose copy snapshot() saved. Returns its path."""
    p = Path(p).resolve()
    old = p.with_name(f"{p.stem}-v{start}{p.suffix}")
    if not old.exists():
        sys.exit(f"error: no saved copy of version {start}: {old}")
    now = version_number(p, fingerprint(doc_text(p)))
    body = changes(old.read_text(), p.read_text())
    out = p.with_name(f"{p.stem}-v{start}-to-v{now}{p.suffix}")
    head = [f"# {p.name}: changes from version {start} to version {now}, {time.strftime('%Y-%m-%d %H:%M')}",
            f"*{sum(not x.startswith('#') for x in body)} changed passages. ~~Struck~~ text was removed and 🟢 **bold** text was added.*"
            if body else "*No changes.*"]
    out.write_text("\n\n".join(head + body) + "\n")
    return out


# ---------------------------------------------------------------- checks
# Mechanical checks that need no model: numbering, references, citation keys,
# and terms spelled two ways. They follow the house rules in skills/documents.

BIB = Path(os.environ.get("BIB_DIR") or Path.home() / "github" / "bib") / "references.bib"
_BIB_KEYS = {}


def bib_file(text, path):
    """The draft's bibliography: a local file named in its front matter, else the
    shared bibliography."""
    m = re.match(r"---\n(.*?)\n---", text, re.S)
    named = re.search(r"^bibliography:\s*(\S+)", m.group(1), re.M) if m else None
    if named and "://" not in named.group(1):
        return (Path(path).parent / named.group(1)).expanduser()
    return BIB


CITATION = re.compile(r"\[([^\[\]]*@[^\[\]]*)\]")
CITE_KEY = re.compile(r"(?<![\w@])-?@([A-Za-z0-9_][\w:.#$%&+?<>~/-]*[\w])")


def cited_keys(text):
    """Citation keys in [@Key] and [@A; @B] citations, in order of first use."""
    body = re.sub(r"\A---\n.*?\n---\n", "", text, flags=re.S)
    keys = []
    for m in CITATION.finditer(body):
        for k in CITE_KEY.findall(m.group(1)):
            if k not in keys:
                keys.append(k)
    return keys


def bib_field(entry, name):
    """One field of a BibTeX entry, braces and LaTeX quoting removed."""
    m = re.search(r"^\s*" + name + r"\s*=\s*\{(.*)\},?\s*$", entry, re.M | re.I)
    return re.sub(r"[{}]", "", m.group(1)).replace("\\&", "&").replace("--", "–").strip() if m else ""


PLOS_CSL = Path(__file__).resolve().parent.parent / "typeset" / "plos.csl"
_REFS_HTML = {}


def pandoc_refs(entries, keys):
    """{key: html} for the cited entries, formatted by pandoc in the book's PLOS
    style with DOIs linked. Empty when pandoc is not installed or fails."""
    if not shutil.which("pandoc") or not PLOS_CSL.exists():
        return {}
    import tempfile
    with tempfile.TemporaryDirectory() as d:
        (Path(d) / "refs.bib").write_text("\n\n".join(entries))
        md = "\n\n".join(f"[@{k}]" for k in keys)
        r = subprocess.run(["pandoc", "--citeproc", "-t", "html", "--bibliography", str(Path(d) / "refs.bib"),
                            "--csl", str(PLOS_CSL), "-M", "link-bibliography=true"],
                           input=md, capture_output=True, text=True, timeout=60)
    return {m.group(1): m.group(2).strip() for m in re.finditer(
        r'<div id="ref-([^"]+)" class="csl-entry"[^>]*>\s*<div class="csl-left-margin">.*?</div>'
        r'<div\s+class="csl-right-inline">(.*?)</div>\s*</div>', r.stdout, re.S)}


def cited_refs(text, path):
    """The draft's references in order of first citation: [{key, html, text, url}].
    html is the book's PLOS format from pandoc; text and url are a plain
    fallback. An entry not in the bibliography has empty text and html."""
    keys = cited_keys(text)
    try:
        src = bib_file(text, path).read_text(errors="replace") if keys else ""
    except OSError:
        src = ""
    found = {k: m for k in keys if (m := re.search(r"^@\w+\{" + re.escape(k) + r",(.*?)^\}", src, re.M | re.S))}
    cache_key = tuple((k, found[k].group(0) if k in found else "") for k in keys)
    if cache_key not in _REFS_HTML:
        _REFS_HTML[cache_key] = pandoc_refs([m.group(0) for m in found.values()], list(found)) if found else {}
    html = _REFS_HTML[cache_key]
    out = []
    for k in keys:
        m = found.get(k)
        if not m:
            out.append({"key": k, "html": "", "text": "", "url": ""})
            continue
        e = m.group(1)
        names = [a.strip() for a in bib_field(e, "author").split(" and ") if a.strip()]
        def short(a):
            last, _, first = a.partition(",")
            return (last.strip() + " " + "".join(w[0] for w in re.split(r"[\s.-]+", first) if w)).strip()
        who = ", ".join(map(short, names[:3])) + (" et al." if len(names) > 3 else "")
        year = (bib_field(e, "date") or bib_field(e, "year"))[:4]
        venue = bib_field(e, "journaltitle") or bib_field(e, "journal") or bib_field(e, "booktitle") or bib_field(e, "publisher")
        doi = bib_field(e, "doi")
        parts = [p for p in [f"{who} ({year})." if who else (f"({year})." if year else ""),
                             bib_field(e, "title").rstrip(".") + ".", venue + "." if venue else ""] if p and p != "."]
        out.append({"key": k, "html": html.get(k, ""), "text": " ".join(parts),
                    "url": f"https://doi.org/{doi}" if doi else bib_field(e, "url")})
    return out


def bib_keys(text, path):
    """Citation keys in the draft's bibliography. None when it cannot be read."""
    bib = bib_file(text, path)
    try:
        stamp = bib.stat().st_mtime
    except OSError:
        return None
    if _BIB_KEYS.get(bib, (None,))[0] != stamp:
        _BIB_KEYS[bib] = (stamp, set(re.findall(r"^@\w+\{([^,\s]+),", bib.read_text(errors="replace"), re.M)))
    return _BIB_KEYS[bib][1]


def blank(text, pattern, flags=0):
    """Text with each match replaced by spaces, so positions stay the same."""
    return re.sub(pattern, lambda m: re.sub(r"[^\n]", " ", m.group(0)), text, flags=flags)


DOUBLE_SPACE = re.compile(r"(?<=\S) {2,}(?=\S)")


def double_spaces(text):
    """Runs of spaces between two words or after punctuation, outside code and
    table rows: [(start, end)]. Indentation and line-ending spaces are left alone."""
    prose = blank(text, r"```.*?```|`[^`\n]*`", re.S)
    rows = {m.start() for m in re.finditer(r"(?m)^[ \t]*\|.*$", text)}
    starts = [m.start() for m in re.finditer(r"(?m)^", text)]
    out = []
    for m in DOUBLE_SPACE.finditer(text):
        line_start = max(p for p in starts if p <= m.start())
        if line_start in rows or text[m.start() - 1] != prose[m.start() - 1] or text[m.end()] != prose[m.end()]:
            continue
        out.append((m.start(), m.end()))
    return out


def fix_double_spaces(text):
    for a, b in reversed(double_spaces(text)):
        text = text[:a] + " " + text[b:]
    return text


def checks(text, path, deck=False):
    """Problems a script can find without a model: [{"id", "line", "what"}],
    in draft order."""
    found = []
    line = lambda pos: text.count("\n", 0, pos) + 1
    add = lambda pos, what: found.append((pos, what))
    prose = blank(text, r"```.*?```|`[^`\n]*`", re.S)  # code never counts
    words = blank(prose, r"\$\$.*?\$\$|\$[^$\n]+\$|<[^>\n]+>|\]\([^)\s]*\)|https?://\S+", re.S)

    def numbering(label, defs, refs, uncited=True):
        """defs, refs: [(position, number)]. Duplicates, order, missing targets, and
        optionally uncited ones. A draft that numbers none of these is not checked,
        since its references may point elsewhere."""
        if not defs:
            return
        seen, last = set(), None
        for pos, n in defs:
            if n in seen:
                add(pos, f"{label} {n} is numbered twice.")
            seen.add(n)
            if n.isdigit() and last is not None and int(n) != last + 1:
                add(pos, f"{label} {n} follows {label} {last}.")
            last = int(n) if n.isdigit() else None
        cited = {n for _, n in refs}
        for pos, n in refs:
            if n not in seen:
                add(pos, f"{label} {n} is cited but does not exist.")
        for pos, n in defs:
            if uncited and n not in cited:
                add(pos, f"{label} {n} is never cited in the text.")

    numbering("Equation", [(m.start(), m.group(1).strip()) for m in re.finditer(r"\\tag\{([^}]*)\}", prose)],
              [(m.start(), m.group(1).strip()) for m in re.finditer(r"\bEqs?\.\s*\(([^)]+)\)", words)],
              uncited=False)  # an equation need not be cited
    caps = [(m.start(), m.group(1)) for m in re.finditer(r"\*\*Figure (\d+(?:\.\d+)*)\.\*\*", words)]
    capspots = {p for p, _ in caps}
    numbering("Figure", caps, [(m.start(), m.group(1)) for m in re.finditer(r"\b(?:Figure|Fig\.)\s+(\d+(?:\.\d+)*)", words)
                               if m.start() - 2 not in capspots])

    slug = lambda h: re.sub(r"\s+", "-", re.sub(r"[^\w\s-]", "", h.strip().lower()))
    targets = set(re.findall(r"""\bid=["']([^"']+)["']""", prose))
    targets |= {slug(h) for h in re.findall(r"^#{1,6}\s+(.+?)\s*#*\s*$", prose, re.M)}
    for m in re.finditer(r"\]\(#([^)\s]+)\)", prose):
        if m.group(1) not in targets:
            add(m.start(), f"Link to #{m.group(1)} has no matching anchor or heading.")

    keys = bib_keys(text, path)
    if keys is not None:
        for m in re.finditer(r"\[[^\[\]]*?@[^\[\]]*\](?!\()", prose):  # [@x](url) is a link
            for k in re.findall(r"@([\w:.#$%&+?<>~/'-]+)", m.group(0)):
                k = k.rstrip(".,;:")
                if k not in keys:
                    add(m.start(), f"Citation key @{k} is not in the bibliography.")

    lower = words.lower()
    for hyph in sorted({m.group(0).lower() for m in re.finditer(r"\b[A-Za-z]{2,}-[A-Za-z]{2,}\b", words)}):
        closed = hyph.replace("-", "")
        n_closed = len(re.findall(rf"\b{closed}\b", lower))
        if n_closed:
            first = re.search(rf"\b{closed}\b", lower).start()
            n_hyph = len(re.findall(rf"\b{re.escape(hyph)}\b", lower))
            add(first, f'"{hyph}" ({n_hyph}×) and "{closed}" ({n_closed}×) are both used.')
    if deck:
        found += deck_checks(text)
    spaces = double_spaces(text)
    if spaces:
        lines = sorted({line(a) for a, _ in spaces})
        found.append((spaces[0][0], f"Two or more spaces where one belongs ({len(spaces)}×, line"
                                    f"{'s' if len(lines) > 1 else ''} {', '.join(map(str, lines[:12]))}"
                                    f"{', …' if len(lines) > 12 else ''}).", "spaces"))
    found.sort(key=lambda x: x[0])
    return [{"id": f"M{i}", "line": line(x[0]), "pos": x[0], "what": x[1], "fix": x[2] if len(x) > 2 else None}
            for i, x in enumerate(found, 1)]


# ---------------------------------------------------------------- carry-over
# Findings the last review showed and the author has not yet accepted or
# declined go back to the panel, so a point that still applies keeps its wording
# instead of returning reworded as a new one. Each finding keeps a key across
# reviews, and one the new review does not repeat is reported as resolved.

def previous_open(path):
    """Open findings from the newest earlier review of this file:
    [{key, title, quote, seen}]. Accepted, declined, and held findings are left out."""
    runs = runs_for(Path(path).resolve())
    if not runs:
        return []
    r = json.loads((runs[0] / "results.json").read_text())
    decided = {d["title"] for d in load_decisions().get(str(Path(path).resolve()), []) if d.get("run") == runs[0].name}
    return [{"key": g.get("key") or "K" + hashlib.sha256((g["rep"]["title"] + g["rep"]["quote"]).encode()).hexdigest()[:6],
             "title": g["rep"]["title"], "quote": g["rep"]["quote"], "seen": g.get("seen", 1)}
            for _, _, _, g in ordered_findings(r) if g["rep"]["title"] not in decided]


def open_block(prev):
    """Prompt text listing the last review's open findings."""
    if not prev:
        return ""
    return ("\nThese findings from the last review of this draft are still open. If one still applies to "
            "the text as it is now, raise it again with the same title and, where they still fit, the same "
            "wording and diff. Do not reword it as a new point. If the text has changed so that it no longer "
            "applies, leave it out.\n" + "\n".join(
                f"- {p['title']}" + (f" (quote: {p['quote'][:120]})" if p["quote"] else "") for p in prev) + "\n")


def carry_over(groups, prev, dnorm):
    """Give each group the key of the earlier finding it repeats, or a new key,
    and count the reviews it has appeared in. Returns the earlier findings not
    repeated: {"resolved": passage changed, "dropped": passage unchanged}."""
    left = list(prev)
    for g in groups:
        t, q = norm(g["rep"]["title"]), g["rep"]["quote"]
        hit = next((p for p in left if norm(p["title"]) == t), None) or next(
            (p for p in left if q and p["quote"] and quote_overlap(q, p["quote"])), None)
        if hit:
            left.remove(hit)
            g["key"], g["seen"] = hit["key"], hit["seen"] + 1
            if g["rejected"]:
                left.append(hit)  # raised again but voted down: not repeated
        else:
            g["key"] = "K" + hashlib.sha256((g["rep"]["title"] + q).encode()).hexdigest()[:6]
            g["seen"] = 1
    gone = lambda p: p["quote"] and norm(p["quote"])[:60] not in dnorm
    return {"resolved": [p["title"] for p in left if gone(p)],
            "dropped": [p["title"] for p in left if not gone(p)]}


# ---------------------------------------------------------------- churn
# A passage that each round rewrites again, or a change that undoes an earlier
# one, is held back. The history is the reviewed copy each earlier run kept.

def reviewed_history(path, current):
    """Earlier reviewed texts of a file, oldest first, one per version, not
    counting the current text."""
    seen, out = {fingerprint(current)}, []
    for run in reversed(runs_for(Path(path).resolve())):
        copy = run / "reviewed" / Path(path).name
        if copy.exists():
            t = copy.read_text()
            if fingerprint(t) not in seen:
                seen.add(fingerprint(t))
                out.append(t)
    return out


def paragraphs(text):
    return [p for p in re.split(r"\n\s*\n", text) if p.strip()]


def times_changed(para, history):
    """For each step back through the history, newest first, whether this
    paragraph changed in that step. Stops where the paragraph did not exist."""
    out, cur = [], norm(para)
    for older in reversed(history):
        olds = [norm(p) for p in paragraphs(older)]
        if cur in olds:
            out.append(False)
            continue
        best = max(olds, key=lambda p: difflib.SequenceMatcher(None, p, cur, autojunk=False).ratio(), default=None)
        if best is None or difflib.SequenceMatcher(None, best, cur, autojunk=False).ratio() < 0.5:
            break
        out.append(True)
        cur = best
    return out


def sentence_bounds(text, a, b):
    """Start and end of the sentences that text[a:b] touches."""
    starts = [m.end() for m in re.finditer(r"[.!?]\s+|\n", text[:a])]
    m = re.compile(r"[.!?](?=\s|$)|\n").search(text, b)
    return (starts[-1] if starts else 0), (m.end() if m else len(text))


def restores_earlier(text, edits, history):
    """True when applying the edits would bring back a sentence an earlier
    version had, replacing one that version did not have: an undo."""
    s, e = sentence_bounds(text, edits[0][0], edits[-1][1])
    new = text
    for a, b, n in sorted(edits, reverse=True):
        new = new[:a] + n + new[b:]
    before, after = norm(text[s:e]), norm(new[s:e + len(new) - len(text)])
    if len(after) < 20 or before == after:
        return False
    return any(after in norm(t) and before not in norm(t) for t in history)


def churn(g, text, history):
    """Why a finding should be held back to stop churn, or None. A change that
    restores earlier wording is held. On a passage that changed in the last
    step, only Critical and Substantive findings show. On one that changed in
    two of the last three steps, only Critical findings show. Typos always show."""
    if g["where"] != "draft" or not history or is_typo(g):
        return None
    old, new, edits = placed_diff(text, g["rep"]["body"], g["rep"]["quote"])
    if edits and restores_earlier(text, edits, history):
        return "it would restore wording from an earlier version"
    anchor = find_span(text, g["rep"]["quote"]) if g["rep"]["quote"] else None
    anchor = anchor or (edits[0][:2] if edits else None)
    if not anchor:
        return None
    para = next((p for p in paragraphs(text) if norm(text[anchor[0]:anchor[1]])[:60] in norm(p)), None)
    steps = times_changed(para, history)[:3] if para else []
    if sum(steps) >= 2 and g["severity"] != "Critical":
        return f"the passage changed in {sum(steps)} of the last {len(steps)} versions"
    if steps[:1] == [True] and canon_sev(g["severity"]) == "Nitpick":
        return "the passage changed since the last review"
    return None



# ---------------------------------------------------------------- review page
# A local page for one reviewed file: the draft with each finding in place, and
# Accept, Edit, Decline, and Re-review. It runs from `unified-review --serve FILE`.

PAGE_DIR = Path(__file__).resolve().parent.parent / "page"
FONT_DIR = Path(__file__).resolve().parent.parent / "slides" / "theme" / "fonts"
PAGE_IDLE = 8 * 3600  # the server exits after this many seconds without a request
DEL = re.compile(r"\*\*~~(.+?)~~\*\*|~~(.+?)~~", re.S)
ADD = re.compile(r"\*\*🟢\s*(.+?)\*\*|🟢\s*\*\*(.+?)\*\*", re.S)


SLOT = "the new text has a placeholder to fill in"


def diff_parts(body, slots=False):
    """(old, new) text of a finding's diff, or (None, reason) when it has none
    that can be applied as written. With slots, new text may keep {{…}} slots."""
    body = strip_end(body)
    fence = re.search(r"```[a-z]*\n(.*?)\n```", body, re.S)
    if fence and ("~~" in fence.group(1) or "🟢" in fence.group(1)):
        # A strike or 🟢 diff wrapped in a code block: read it as plain text.
        body, fence = body.replace(fence.group(0), fence.group(1)), None
    paras = body.split("\n\n")[1:]
    if fence:
        lines = [l for l in fence.group(1).splitlines() if l.strip()]
        if len(lines) == 2:
            return lines[0], lines[1]
        return None, "the diff is a code block that is not one old and one new line"
    text = "\n\n".join(x for x in paras if "~~" in x or "🟢" in x).strip()
    if not text:
        return None, "the finding has no diff"
    # Removing a marked span takes the space before it too, so "a ~~b~~ 🟢 **c**."
    # gives old "a b." and new "a c.", not "a b ." and "a  c.". A struck span that
    # held the only space, as in "source, ~~much ~~like", leaves a space behind.
    old = re.sub(r"[ \t]*(?:" + ADD.pattern + ")", "", DEL.sub(lambda m: m.group(1) or m.group(2), text))
    new = re.sub(r"[ \t]*(?:" + DEL.pattern + ")", lambda m: " " if m[0][0] in " \t" else "",
                 ADD.sub(lambda m: m.group(1) or m.group(2), text))
    # Removing a marked span leaves doubled spaces. In the new text it can also
    # leave a space before punctuation. The old text keeps its punctuation as is.
    spaces = lambda t: re.sub(r"\n{3,}", "\n\n", re.sub(r"[ \t]{2,}", " ", t)).strip()
    old, new = spaces(old), spaces(re.sub(r"[ \t]+\n", "\n", re.sub(r" +([.,;:])", r"\1", new)))
    if not slots and has_slot(new):
        return None, SLOT
    if old == new:
        return None, "the change only removes spaces at the end of a line, which Markdown does not show"
    return old, new


def has_slot(new):
    return "{{" in new or bool(re.search(r"\[[^\]@]*(name|key|insert|N\b|M\b)[^\]]*\]", new, re.I))


def lenient_diff(body, slots=False):
    """The diff as diff_parts reads it after fixing two slips reviewers make in
    a diff paragraph: an addition bolded without 🟢, and 🟢 without bold (taken
    to the end of its line)."""
    def fix(para):
        if "~~" not in para and "🟢" not in para:
            return para
        keep = []
        stash = lambda m: keep.append(m[0]) or f"\0{len(keep) - 1}\0"
        para = DEL.sub(stash, ADD.sub(stash, para))
        para = re.sub(r"\*\*([^*\n\0]+?)\*\*", lambda m: stash([f"🟢 **{m[1]}**"]), para)
        para = re.sub(r"🟢[ \t]*([^\n\0]+)", lambda m: f"🟢 **{m[1].rstrip()}**", para)
        return re.sub(r"\0(\d+)\0", lambda m: keep[int(m[1])], para)
    head, *rest = strip_end(body).split("\n\n")
    return diff_parts("\n\n".join([head] + [fix(x) for x in rest]), slots)


def placed_diff(text, body, quote, slots=False):
    """(old, new, edits) for a finding's diff in text. When the diff as written
    cannot be placed, tries it with lenient_diff's fixes."""
    old, new = diff_parts(body, slots)
    head = strip_end(body).split("\n\n")[0]
    if old is None and ("~~" in head or "🟢" in head):
        # The diff sits in the first paragraph, after the point ("Add the article.
        # The method is ~~a~~ **🟢 the**..."). Drop leading sentences until it places.
        first = min(i for i in (head.find("~~"), head.find("🟢")) if i >= 0)
        cuts = [0] + [m.end() for m in re.finditer(r"[.!?:]\s+", head[:first])]
        for c in cuts:
            o, n = diff_parts("point\n\n" + head[c:], slots)
            e = locate_edits(text, o, n, quote) if o else None
            if e:
                return o, n, e
    edits = locate_edits(text, old, new, quote) if old else None
    if old is not None and not edits:
        o, n = lenient_diff(body, slots)
        e = locate_edits(text, o, n, quote) if o else None
        if e:
            return o, n, e
    return old, new, edits


def find_span(text, needle, near=None):
    """(start, end) of needle in text, matching through differences in spacing
    and quote marks. With several matches, the one nearest `near`. None if absent."""
    if not needle.strip():
        return None
    parts = [re.escape(w.translate(QUOTES)) for w in needle.split()]
    pat = r"\s+".join(parts)
    pat = pat.replace("'", "['‘’]").replace('"', '["“”]')
    hits = [(m.start(), m.end()) for m in re.finditer(pat, text)]
    if not hits:
        return None
    return min(hits, key=lambda h: abs(h[0] - near)) if near is not None else hits[0]


def fuzzy_span(text, old, quote_span):
    """Where `old` sits in text when a reviewer misquoted it slightly: the
    passage near the finding's quote that matches it at least 90%."""
    if not quote_span or not old.strip():
        return None
    lo, hi = max(0, quote_span[0] - len(old)), min(len(text), quote_span[1] + len(old))
    region = text[lo:hi]
    blocks = [b for b in difflib.SequenceMatcher(None, region, old, autojunk=False).get_matching_blocks() if b.size]
    if not blocks:
        return None
    s, e = blocks[0].a, blocks[-1].a + blocks[-1].size
    if difflib.SequenceMatcher(None, region[s:e], old, autojunk=False).ratio() < 0.9:
        return None
    return lo + s, lo + e


def change_mark(text, span, old, new):
    """The smallest part of text[span] that a change touches: the words it
    replaces or deletes, or for a pure insertion the word just before it."""
    ow, nw = old.split(), new.split()
    i = 0
    while i < min(len(ow), len(nw)) and ow[i] == nw[i]:
        i += 1
    j = 0
    while j < min(len(ow), len(nw)) - i and ow[-1 - j] == nw[-1 - j]:
        j += 1
    region = ow[i:len(ow) - j]
    if not region:  # insertion: mark the neighboring word
        region = ow[i - 1:i] if i > 0 else ow[:1]
        i = max(i - 1, 0)
    if not region:
        return span
    seg = text[span[0]:span[1]]
    near = len(" ".join(ow[:i])) + (1 if i else 0)  # where the region starts in old
    m = find_span(seg, " ".join(region), near)
    if not m:
        return list(span)
    a, b = span[0] + m[0], span[0] + m[1]
    if b - a < 2:  # one character is too small to click: take in the word before it
        k = text.rfind(" ", span[0], max(a - 1, span[0]))
        a = max(span[0], k + 1 if k >= 0 else span[0])
    return [a, b]


def runs_for(path):
    """Run folders that reviewed exactly this file, newest first."""
    out = []
    for rj in RUNS_DIR.glob("*/results.json"):
        try:
            if json.loads(rj.read_text()).get("files") == [str(path)]:
                out.append(rj.parent)
        except ValueError:
            continue
    return sorted(out, key=lambda d: (d / "results.json").stat().st_mtime, reverse=True)


def vote_tag(g):
    vs = [v["vote"] for m, v in g["votes"].items() if m != g.get("self_voter")]
    agree = sum(v == "agree" for v in vs)
    if vs and agree == len(vs):
        return "Unanimous"
    if g.get("contested"):
        return "Contested"
    return "Majority" if agree * 2 > len(vs) else "No majority"


def reviewed_text(run, path):
    """The text this run reviewed (its copy in reviewed/), or None."""
    f = run / "reviewed" / Path(path).name
    return f.read_text() if f.exists() and not is_pdf(f) else None


def unplaced_reason(text, reviewed, old, new, quote):
    """Why a finding's diff cannot be placed in the current text: its new text is
    already there, the reviewer misquoted the draft, or the passage changed."""
    new = clean_markup(new)
    if new.strip() and (find_span(text, new) or locate_edits(text, new, new, quote)):
        return "this change is already in the file. Mark it done to record it"
    if not re.sub(r"\(.*\)", "", old).strip():  # empty, or a stand-in such as "(no row)"
        return "the change adds text without quoting where it goes, so it cannot be placed. Add it by hand, then mark it done"
    if reviewed is not None and not locate_edits(reviewed, old, new, quote):
        return "the reviewer quoted text that is not in the draft as reviewed, so the change cannot be placed. Apply it by hand, then mark it done"
    now = closest_sentence(text, old)
    if now:
        return f"its passage changed after this review, and now reads: \"{now}\" If that already fixes it, mark it done"
    return "its passage changed after this review. If you already fixed it, mark it done"


def closest_sentence(text, old):
    """The current sentence most like old, if one is close (ratio 0.6 or more)."""
    import difflib
    old = ELLIPSIS.sub(" ", old).strip()
    best, score = None, 0.6
    for s in re.split(r"(?<=[.!?])\s+|\n+", text):
        r = difflib.SequenceMatcher(None, old, s.strip()).ratio()
        if r >= score:
            best, score = s.strip(), r
    return best


def page_state(path, run):
    """Everything the page shows: the current text and each finding in place."""
    r = json.loads((run / "results.json").read_text())
    text = doc_text(path)
    labels = r["labels"]
    decided, earlier = {}, {}
    for d in load_decisions().get(str(path), []):
        if d.get("run") == run.name:
            decided[d["title"]] = d
        elif d.get("quote") and d.get("decision") in ("applied", "ignore"):
            earlier[" ".join(d["quote"].split())] = d  # newest decision on a sentence wins
    out, fills = [], load_fills(run)
    for n, sev, where_label, g in ordered_findings(r):
        rep = g["rep"]
        # A {{…}} slot is placed like any change, so Edit can fill it in, but it cannot be accepted as is.
        old, new, edits = placed_diff(text, rep["body"], rep["quote"], slots=True)
        reason = None if old is not None else new
        quote_span = find_span(text, rep["quote"]) if rep["quote"] else None
        span = (edits[0][0], edits[-1][1]) if edits else None
        if old is not None and span is None:
            reason = unplaced_reason(text, reviewed_text(run, path), old, new, rep["quote"])
        elif span and has_slot(new):
            fill = fills.get(str(n)) or {}
            if fill.get("status") == "done":  # filled from the web: propose the filled text
                new = fill["text"]
            else:
                reason = SLOT
        d = decided.get(rep["title"])
        if d is None and span is None and rep["quote"]:
            # The same sentence was accepted or declined from an earlier review: that settles it.
            e = earlier.get(" ".join(rep["quote"].split()))
            if e:
                when = re.match(r"(\d{4}-\d\d-\d\d)-(\d\d)(\d\d)", e.get("run", ""))
                at = f"the {when.group(2)}:{when.group(3)} review" if when else "an earlier review"
                if when and when.group(1) != run.name[:10]:
                    at += f" of {when.group(1)}"
                verb = "accepted" if e["decision"] == "applied" else "declined"
                d = {"decision": e["decision"], "note": f"Done: {verb} in {at} as \u201c{e['title']}\u201d"}
        if d is None and reason and reason.startswith("this change is already in the file"):
            d = {"decision": "applied", "note": "Done: the change is already in the file"}
        out.append({
            "n": n, "severity": sev, "kind": g.get("kind", ""), "form": g.get("form", "edit"), "section": where_label, "title": rep["title"], "where": g["where"],
            "point": strip_end(rep["body"]).split("\n\n")[0], "body": strip_end(rep["body"]), "quote": rep["quote"],
            "old": old, "new": new if old is not None else None, "reason": reason,
            "span": list(span or quote_span or []) or None, "editable": span is not None,
            "applicable": span is not None, "slot": bool(span) and has_slot(new or ""),
            "changed": old is not None and span is None,
            "mark": (change_mark(text, span, old, new) if len(edits) == 1
                     else [edits[0][0], edits[0][1]]) if span else None,
            "tag": vote_tag(g), "seen": g.get("seen", 1),
            "votes": [{"model": labels.get(m, m).split()[0], "label": labels.get(m, m), "icon": lab_icon(m),
                       "vote": v["vote"], "raised": m in g["raised_by"]}
                      for m, v in g["votes"].items()],
            "status": {"applied": "accepted", "ignore": "declined"}.get(d["decision"]) if d else None,
            "note": d.get("note", "") if d else "", "fill": fills.get(str(n)), "added": g.get("added")})
    qs = load_questions(run)
    for f in out:
        f["questions"] = qs.get(str(f["n"]), [])
        for q in f["questions"]:
            for m, a in q["answers"].items():
                if m not in labels:
                    labels[m] = label(panelist(m))
                if a.get("old"):  # re-check against the text as it is now
                    a["applicable"] = (find_span(text, a["old"]) is not None or fuzzy_span(
                        text, a["old"], find_span(text, a["old"][:40])) is not None)
                    a["applied"] = not a["applicable"] and find_span(text, a["new"]) is not None
                a["model"] = labels[m] if ":" in m else labels.get(m, m).split()[0]
                a["icon"], a["label"] = lab_icon(m), labels.get(m, m)
                a["raised"] = m in next(g for n, _, _, g in ordered_findings(r) if n == f["n"])["raised_by"]
    vers = (r.get("versions") or [{}])[0]
    return {"file": str(path), "name": Path(path).name, "run": run.name, "version": vers.get("number"),
            "edited": bool(vers.get("version")) and fingerprint(text) != vers.get("version"),
            "readonly": read_only(path), "pdf": is_pdf(path),
            "draft_formats": ["md", "docx"] + (["pdf"] if is_pdf(original_of(path) or "") else []),
            "chosen": [{"spec": m, "label": label(panelist(m)), "icon": lab_icon(m)} for m in page_panel(path)],
            "panel_icons": [{"icon": lab_icon(m), "label": labels.get(m, m)} for m in r["reviewers_ok"]],
            "comments": comment_state(run, text), "summary": summary_state(run), "checks": checks(text, path, r.get("deck", False)), "deck": r.get("deck", False),
            "started": r.get("started", ""), "panel": [labels.get(m, m) for m in r["reviewers_ok"]],
            "failures": r.get("failures", []), "text": text, "findings": out, "refs": cited_refs(text, path),
            "edit_review": json.loads((run / "edit-review.json").read_text()) if (run / "edit-review.json").exists() else None}


ELLIPSIS = re.compile(r"\s*(?:\.\.\.|…)\s*")


def locate_edits(text, old, new, quote=""):
    """Where a change applies: [(start, end, new text)], or None if any part is
    missing. A diff that skips text with an ellipsis becomes one edit per part,
    found in order, and applies only when every part is found."""
    quote_span = find_span(text, quote) if quote else None
    near = quote_span[0] if quote_span else None
    span = find_span(text, old, near) or (fuzzy_span(text, old, quote_span) if not ELLIPSIS.search(old) else None)
    if span:
        return [(span[0], span[1], new)]
    olds, news = ELLIPSIS.split(old), ELLIPSIS.split(new)
    if len(olds) < 2 or len(olds) != len(news):
        return separate_edits(text, old, new, near)
    edits, pos = [], None
    for o, n in zip(olds, news):
        if not o.strip():
            continue
        if pos is None:  # the first part: anywhere, nearest the finding's quote
            sp = find_span(text, o, near)
        else:  # later parts: after the one before
            sp = find_span(text[pos:], o, 0)
            sp = (pos + sp[0], pos + sp[1]) if sp else None
        if sp is None:
            return None
        if o != n:
            edits.append((sp[0], sp[1], n))
        pos = sp[1]
    return edits or None


def separate_edits(text, old, new, near):
    """A diff of several paragraphs that are separate passages in the draft (the
    same fix in several places, or in several table cells): one edit per
    paragraph, each found on its own. None unless every one is found, without overlap."""
    olds, news = old.split("\n\n"), new.split("\n\n")
    if len(olds) < 2 or len(olds) != len(news):
        return None
    edits = []
    for o, n in zip(olds, news):
        sp = find_span(text, o, near)
        if sp is None:
            return None
        if o != n:
            edits.append((sp[0], sp[1], n))
    edits.sort()
    if any(a[1] > b[0] for a, b in zip(edits, edits[1:])):
        return None
    return edits or None


FINDING_MARK = re.compile(r"\s*=+[ \t]*(?:END[ \t]*(?:OF[ \t]*)?)?FINDING[ \t]*=*[ \t]*", re.I)


def clean_markup(text):
    """Review markup out of text bound for the draft: '=== FINDING' and '=== END
    FINDING' markers, struck ~~deletions~~, and 🟢 addition marks, keeping the
    added words. A marker between words becomes one space."""
    out = FINDING_MARK.sub(lambda m: " " if m.start() and m.end() < len(m.string)
                           and not m.string[m.end()].isspace() else "", text)
    out = DEL.sub("", ADD.sub(lambda m: m.group(1) or m.group(2), out)).replace("🟢", "")
    if out == text:
        return text
    out = re.sub(r"(?<=\S)[ \t]{2,}(?=\S)", " ", out)
    # A removed mark at either end must not leave a space at the seam.
    out = out if text[:1].isspace() else out.lstrip(" \t")
    return out if text[-1:].isspace() else out.rstrip(" \t")


def apply_change(path, old, new, quote=""):
    """Replace old with new in the file. Re-reads the file first, so edits made
    since the page loaded are kept. Returns an error message or None."""
    text = doc_text(path)
    edits = locate_edits(text, old, new, quote)
    if not edits:
        return "the text this change targets is no longer in the file"
    for a, b, n in sorted(edits, reverse=True):  # from the end, so earlier offsets hold
        text = text[:a] + clean_markup(n) + text[b:]
    Path(path).write_text(text)
    return None


ASK = """The author of the draft below is asking about one finding from a review
of it. You are one of several reviewers answering in parallel. Answer the
question directly, in at most six sentences, against the draft as it stands
now. You have no web access. Follow the house rules for any wording you propose.

End with one line that starts with "REVISED:". If your answer changes the
proposed edit, follow it with the revised passage as an inline diff of the
current text: strike deletions with ~~tildes~~ and mark additions as
🟢 **added text**, leaving unchanged words plain. Otherwise write "REVISED: none".

<finding>
{finding}
</finding>
{thread}
<question>
{question}
</question>

<draft>
{draft}
</draft>

---- HOUSE RULES ----
{rules}"""
ASK_LOCK = threading.Lock()


def failure_reason(run, stem):
    """The last line of a failed call's error log, which usually names the cause."""
    err = run / f"{stem}.err"
    lines = [l.strip() for l in err.read_text().splitlines() if l.strip()] if err.exists() else []
    return lines[-1][:200] if lines else "no reply"


def load_questions(run):
    f = run / "questions.json"
    return json.loads(f.read_text()) if f.exists() else {}


def save_question(run, n, k, model, answer):
    """Store one model's answer to question k on finding n."""
    with ASK_LOCK:
        qs = load_questions(run)
        qs[str(n)][k]["answers"][model] = answer
        write_atomic(run / "questions.json", json.dumps(qs, indent=1, ensure_ascii=False) + "\n")


def parse_answer(text, current):
    """(answer, revised old, revised new, applicable) from a model's reply."""
    text = (text or "").strip()
    head, _, rev = text.rpartition("REVISED:") if "REVISED:" in text else (text, "", "")
    rev = rev.strip()
    if not rev or rev.lower().startswith("none"):
        return head.strip(), None, None, False
    old, new = diff_parts("point\n\n" + rev)
    ok = old is not None and (find_span(current, old) is not None
                              or fuzzy_span(current, old, find_span(current, old[:40])) is not None)
    return head.strip(), old, new, ok


def ask_panel(path, run, f, question):
    """Ask every panelist from the run about finding f, in parallel, in the
    background. Answers land in questions.json as each model finishes."""
    r = json.loads((run / "results.json").read_text())
    panel = [panelist(m) for m in page_panel(path)]
    with ASK_LOCK:
        qs = load_questions(run)
        thread = qs.setdefault(str(f["n"]), [])
        k = len(thread)
        thread.append({"question": question, "asked": time.strftime("%Y-%m-%d %H:%M"),
                       "answers": {m: {"status": "pending"} for m in panel}})
        write_atomic(run / "questions.json", json.dumps(qs, indent=1, ensure_ascii=False) + "\n")
    earlier = "".join(f"\n<earlier_question>{q['question']}</earlier_question>\n" + "".join(
        f"<answer model=\"{short(m)}\">{a.get('text', '')}</answer>\n" for m, a in q["answers"].items()
        if a.get("status") == "done") for q in thread[:k])
    votes = ", ".join(f"{v['model']} {v['vote']}" for v in f["votes"])
    finding = f"{f['severity']}: {f['title']}\n{f['body']}\nVotes: {votes}"
    rules, _ = load_rules(None)
    prompt = ASK.format(finding=finding, thread=earlier, question=question,
                        draft=doc_text(path), rules=rules)

    def one(m):
        t = time.time()
        text = call(m, prompt, run / f"ask-{f['n']}-{k}-{m}.txt", Path(path).parent, stage="ask")
        if text is None:
            save_question(run, f["n"], k, m, {"status": "failed", "seconds": round(time.time() - t),
                                              "reason": failure_reason(run, f"ask-{f['n']}-{k}-{m}")})
            return
        answer, old, new, ok = parse_answer(text, doc_text(path))
        save_question(run, f["n"], k, m, {"status": "done", "text": answer, "old": old, "new": new,
                                          "applicable": ok, "seconds": round(time.time() - t)})
    threading.Thread(target=lambda: parallel(one, panel), daemon=True).start()


EDIT_FOCUS = """The author just rewrote the passage below. Review only this passage, as it
now reads in the draft: report findings whose quote is inside it, and nothing
about the rest of the draft except where the rewrite contradicts it.

<passage>
{passage}
</passage>"""
EDIT_REVIEW_LOCK = threading.Lock()


def review_passage(path, run, passage):
    """Review one passage the author just edited, in the background: the panel
    reviews and votes as in a full review, with the draft as context. The new
    findings are appended to the run's results, after the existing ones, and the
    page jumps to the first. Status lands in edit-review.json."""
    status = run / "edit-review.json"
    write_atomic(status, json.dumps({"status": "pending", "passage": passage[:200]}))

    def work():
        try:
            draft = doc_text(path)
            panel = [panelist(m) for m in page_panel(path)]
            declines, applied = active_decisions([Path(path)], norm(draft))
            decided = decisions_block(declines, applied)
            rules, _ = load_rules(None)
            focus = EDIT_FOCUS.format(passage=passage)
            prompt = review_prompt(draft, focus, rules, decided)
            stamp = time.strftime("%H%M%S")
            found = {}
            for m, r in parallel(lambda m: call(m, prompt, run / f"edit-{stamp}-review-{m}.md",
                                                Path(path).parent, stage="edit review"), panel).items():
                fs = parse_findings(r) if r else None
                if fs is not None:
                    found[m] = fs
            if not found:
                return write_atomic(status, json.dumps({"status": "failed", "reason": "no reviewer answered"}))
            ok = list(found)
            letters = dict(zip(random.sample(ok, len(ok)), "ABCDEFGH"))
            owner = {v: k for k, v in letters.items()}
            dnorm = norm(draft)
            flat = sorted(({**f, "id": f"{letters[m]}{i}", "pos": position(dnorm, f["quote"])}
                           for m, fs in found.items() for i, f in enumerate(fs, 1)), key=lambda f: (f["pos"], f["id"]))
            new = []
            if flat:
                listed = "\n\n".join(f"[{f['id']}] ({f['severity']}{', question' if f.get('form') == 'question' else ''}) {f['title']}\nquote: {f['quote'] or '(none)'}\n{f['body']}" for f in flat)
                prompt_v = VOTE.format(draft=draft, findings=listed, decided=decided, context="",
                                       focus=f"\n<author_focus>\n{focus}\n</author_focus>\n")
                votes = {m: v for m, r in parallel(lambda m: call(m, prompt_v, run / f"edit-{stamp}-votes-{m}.txt",
                                                                   Path(path).parent, stage="edit vote"), ok).items()
                         for v in [parse_votes(r) if r else None] if v}
                voters = [m for m in ok if m in votes]
                if not voters:
                    return write_atomic(status, json.dumps({"status": "failed", "reason": "every voter failed"}))
                ids = {d["id"]: d for d in declines}
                for g in (score_group(g, votes, voters, owner) for g in group_findings(flat, votes)):
                    g["where"] = where(g, dnorm, "")
                    g["fpos"] = 0
                    g["added"] = time.strftime("%Y-%m-%d %H:%M:%S")
                    hit = next((v["same"] for m in voters for fid in g["members"]
                                for v in [votes[m].get(fid, {})] if v.get("same") in ids), None)
                    if hit:
                        g["declined"] = {"id": hit, "title": ids[hit]["title"]}
                    new.append(g)
            with EDIT_REVIEW_LOCK:
                r = json.loads((run / "results.json").read_text())
                r["groups"] += new
                r["labels"].update({m: label(m) for m in ok})
                write_atomic(run / "results.json", json.dumps(r, indent=1, ensure_ascii=False) + "\n")
            shown = [g for g in new if not g["rejected"] and not g.get("declined")]
            write_atomic(status, json.dumps({"status": "done", "passage": passage[:200], "added": len(shown),
                                             "rejected": len(new) - len(shown),
                                             "first": shown[0]["added"] if shown else None}))
        except Exception as e:  # a background thread: record the failure instead of losing it
            write_atomic(status, json.dumps({"status": "failed", "reason": str(e)}))
    threading.Thread(target=work, daemon=True).start()


FILL = """A reviewer proposed the change below to a draft, with blanks in double braces
for content the reviewer could not supply, such as a citation or a value.

<finding>
{finding}
</finding>

<proposed>
{new}
</proposed>

Fill every blank in the proposed text using web search. Find the actual source
or value, and check that it supports what the sentence says. {cite_rule} Keep
every other character of the proposed text unchanged.

Reply with only this JSON:
{{"text": "<the proposed text with every blank filled>", "sources": ["<URL you relied on>"]}}

If you cannot find trustworthy content for a blank, reply instead with only:
{{"missing": "<one sentence: what you could not find>"}}

<draft>
{draft}
</draft>"""
FILL_MODEL = "claude:opus"  # web search, and the strongest Claude: a wrong citation costs more than time
FILL_LOCK = threading.Lock()
CITE_SLOT = re.compile(r"@(doi|url):([^\s;\]]+)")


def load_fills(run):
    f = run / "fills.json"
    return json.loads(f.read_text()) if f.exists() else {}


def save_fill(run, n, fill):
    with FILL_LOCK:
        fs = load_fills(run)
        fs[str(n)] = fill
        write_atomic(run / "fills.json", json.dumps(fs, indent=1, ensure_ascii=False) + "\n")


def bib_key(ref):
    """The bibliography key for a DOI or URL: addref finds it in Zotero or adds the
    paper there. Without Zotero, a DOI already in references.bib still resolves."""
    addref = BIB.parent / "bin" / "addref"
    if addref.exists():
        r = subprocess.run([str(addref), ref], capture_output=True, text=True, timeout=120)
        if r.returncode == 0 and r.stdout.strip():
            return r.stdout.split("\t")[0].strip(), None
        err = r.stderr.strip().removeprefix("addref: ")
    else:
        err = "addref is not installed"
    if BIB.exists() and ref.startswith("10."):
        for m in re.finditer(r"^@\w+\{([^,\s]+),(.*?)^\}", BIB.read_text(), re.M | re.S):
            if bib_field(m.group(2), "doi").lower() == ref.lower():
                return m.group(1), None
    return None, err or "addref found no key"


def fill_slots(path, run, f):
    """Fill finding f's {{…}} slots with web search, in the background. The filled
    text lands in fills.json, where page_state takes it as the finding's new text."""
    save_fill(run, f["n"], {"status": "pending"})
    draft = doc_text(path)
    keys = bool(cited_keys(draft))
    cite_rule = ("The draft cites with pandoc keys. Write each citation you add as "
                 "[@doi:DOI], such as [@doi:10.1126/science.7414331], or as [@url:URL] for a "
                 "paper with no DOI. These are turned into bibliography keys." if keys else
                 "Write each citation in the format the draft already uses.")

    def work():
        try:
            prompt = FILL.format(finding=f"{f['title']}\n{f['body']}", new=f["new"], cite_rule=cite_rule, draft=draft)
            text = call(panelist(FILL_MODEL), prompt, run / f"fill-{f['n']}.txt", Path(path).parent, web=True, stage="fill")
            if text is None:
                return save_fill(run, f["n"], {"status": "failed", "reason": failure_reason(run, f"fill-{f['n']}")})
            m = re.search(r"\{.*\}", text, re.S)
            try:
                d = json.loads(m[0]) if m else {}
            except json.JSONDecodeError:
                d = {}
            if d.get("missing") or not d.get("text"):
                return save_fill(run, f["n"], {"status": "failed", "reason": d.get("missing") or "the reply was not the fill JSON"})
            filled = d["text"]
            for kind, ref in set(CITE_SLOT.findall(filled)):
                key, err = bib_key(ref)
                if not key:
                    return save_fill(run, f["n"], {"status": "failed", "reason": f"found {ref}, but could not add it to the bibliography: {err}"})
                filled = filled.replace(f"@{kind}:{ref}", "@" + key)
            if has_slot(filled):
                return save_fill(run, f["n"], {"status": "failed", "reason": "a blank is still unfilled"})
            save_fill(run, f["n"], {"status": "done", "text": filled, "sources": d.get("sources", [])})
        except Exception as e:  # a background thread: record the failure instead of losing it
            save_fill(run, f["n"], {"status": "failed", "reason": str(e)})
    threading.Thread(target=work, daemon=True).start()


SUMMARY = """Below is a unified review of a draft: findings from a panel of reviewers,
grouped by severity and numbered. Under each finding, the votes of every
panelist (✓ agree, ~ partial, ✗ disagree), with the reviewer who raised it in
bold. Rejected findings and the panel's agreement statistic come last.

Summarize the reviews, not the draft, for the draft's author. Group the
findings into two to six themes, and put every numbered finding in exactly one
theme. Reply with only this JSON:

{{"themes": [{{"theme": "<two to six words naming a weakness of the draft>", "gist": "<one sentence: what the reviewers found under this theme>", "findings": [<finding numbers>]}}]}}

Order themes by importance. In the gists, write no finding
numbers, counts, or vote tallies, and say nothing about where reviewers agreed
or split. Do not restate the draft's content.
Follow the house rules for prose.

<review>
{review}
</review>

---- HOUSE RULES ----
{rules}"""
SUMMARY_LOCK = threading.Lock()
SUMMARIZING = set()


def summary_state(run):
    """The summary of the run's reviews for the review page: {"status": "done",
    "themes"}, "pending", or "failed" with a reason. The first
    request starts writing it in the background, kept in summary.json."""
    done, failed = run / "summary.json", run / "summary.failed"
    if done.exists():
        return {"status": "done", **json.loads(done.read_text())}
    if failed.exists():
        return {"status": "failed", "reason": failed.read_text().strip()}
    if not (run / "unified.md").exists():
        return None
    with SUMMARY_LOCK:
        if run in SUMMARIZING:
            return {"status": "pending"}
        SUMMARIZING.add(run)

    def write():
        try:
            rules, _ = load_rules(None)
            prompt = SUMMARY.format(review=(run / "unified.md").read_text(), rules=rules)
            text = call("claude", prompt, run / "summary-raw.txt", run, stage="summary")
            if text is None:
                failed.write_text(failure_reason(run, "summary-raw"))
                return
            m = re.search(r"\{.*\}", text, re.S)
            try:
                d = json.loads(m[0]) if m else None
            except json.JSONDecodeError:
                d = None
            if not isinstance(d, dict) or not isinstance(d.get("themes"), list):
                failed.write_text("the reply was not the summary JSON")
                return
            write_atomic(done, json.dumps({"themes": [
                {"theme": str(t.get("theme", "")), "gist": str(t.get("gist", "")),
                 "findings": [int(n) for n in t.get("findings", []) if str(n).isdigit()]}
                for t in d["themes"] if isinstance(t, dict)]}, indent=1, ensure_ascii=False) + "\n")
        except Exception as e:  # a background thread: record the failure instead of losing it
            failed.write_text(str(e))
        finally:
            with SUMMARY_LOCK:
                SUMMARIZING.discard(run)
    threading.Thread(target=write, daemon=True).start()
    return {"status": "pending"}


COMMENT = """The author of the draft below has a general comment, question, or request
about it. You are one of several reviewers answering in parallel. Answer
directly, in at most eight sentences, against the draft as it stands now. You
have no web access. Follow the house rules for any wording you propose.

End with a line that is exactly "CHANGES:". If you propose edits, follow it
with each edit as its own paragraph: the passage from the current draft as an
inline diff, with deletions struck as ~~tildes~~ and additions marked as
🟢 **added text**, leaving unchanged words plain. Copy unchanged words exactly.
Otherwise write "CHANGES: none".
{thread}{passage}
<comment>
{comment}
</comment>

<draft>
{draft}
</draft>

---- HOUSE RULES ----
{rules}"""


def load_comments(run):
    f = run / "comments.json"
    return json.loads(f.read_text()) if f.exists() else []


def parse_changes(text, current):
    """(answer, [{old, new, applicable}]) from a reply to a general comment."""
    text = (text or "").strip()
    head, _, tail = text.rpartition("CHANGES:") if "CHANGES:" in text else (text, "", "")
    changes = []
    if tail.strip() and not tail.strip().lower().startswith("none"):
        for para in re.split(r"\n\s*\n", tail.strip()):
            old, new = diff_parts("point\n\n" + para)
            if old is None:
                continue
            ok = find_span(current, old) is not None or fuzzy_span(current, old, find_span(current, old[:40])) is not None
            changes.append({"old": old, "new": new, "applicable": ok})
    return head.strip(), changes


def comment_state(run, text):
    """Comments with their answers, each proposed change re-checked against the text now."""
    r = json.loads((run / "results.json").read_text())
    labels = r["labels"]
    out = load_comments(run)
    for c in out:
        for m, a in c["answers"].items():
            a["model"] = labels[m].split()[0] if m in labels else label(panelist(m))
            a["icon"], a["label"] = lab_icon(m), labels.get(m) or label(panelist(m))
            for ch in a.get("changes", []):
                ch["applicable"] = (find_span(text, ch["old"]) is not None or fuzzy_span(
                    text, ch["old"], find_span(text, ch["old"][:40])) is not None)
                ch["applied"] = not ch["applicable"] and find_span(text, ch["new"]) is not None
    return out


def comment_panel(path, run, comment, focus, passage=""):
    """Send a general comment to every panelist in parallel, in the background.
    A passage is text the author selected in the draft: the comment is about it."""
    panel = [panelist(m) for m in page_panel(path)]
    with ASK_LOCK:
        cs = load_comments(run)
        k = len(cs)
        cs.append({"comment": comment, "passage": passage, "focus": bool(focus), "asked": time.strftime("%Y-%m-%d %H:%M"),
                   "answers": {m: {"status": "pending"} for m in panel}})
        write_atomic(run / "comments.json", json.dumps(cs, indent=1, ensure_ascii=False) + "\n")
    thread = "".join(f"\n<earlier_comment>{c['comment']}</earlier_comment>\n" + "".join(
        f"<answer model=\"{short(m)}\">{a.get('text', '')}</answer>\n" for m, a in c["answers"].items()
        if a.get("status") == "done") for c in cs[:k])
    rules, _ = load_rules(None)
    about = (f"\nThe comment is about this passage, which the author selected in the rendered draft:\n"
             f"<passage>\n{passage}\n</passage>\n") if passage else ""
    prompt = COMMENT.format(thread=thread, passage=about, comment=comment, draft=doc_text(path), rules=rules)

    def one(m):
        t = time.time()
        text = call(m, prompt, run / f"comment-{k}-{m}.txt", Path(path).parent, stage="comment")
        if text is None:
            ans = {"status": "failed", "seconds": round(time.time() - t), "reason": failure_reason(run, f"comment-{k}-{m}")}
        else:
            answer, changes = parse_changes(text, doc_text(path))
            ans = {"status": "done", "text": answer, "changes": changes, "seconds": round(time.time() - t)}
        with ASK_LOCK:
            cs2 = load_comments(run)
            cs2[k]["answers"][m] = ans
            write_atomic(run / "comments.json", json.dumps(cs2, indent=1, ensure_ascii=False) + "\n")
    threading.Thread(target=lambda: parallel(one, panel), daemon=True).start()


DEFAULT_PANEL = ["claude", "gpt", "gemini"]
LABS = [("Anthropic", r"claude"), ("OpenAI", r"gpt|o\d|codex"), ("Google", r"gemini|gemma"),
        ("xAI", r"grok|cursor-grok"), ("Moonshot", r"kimi"), ("Z.ai", r"glm"), ("DeepSeek", r"deepseek"),
        ("Alibaba", r"qwen"), ("Meta", r"muse|llama"), ("Cursor", r"composer|auto")]
EFFORTS = ["none", "minimal", "low", "medium", "high", "xhigh", "extra-high", "max"]
EFFORT_LABEL = {"xhigh": "Extra high", "extra-high": "Extra high"}
MODEL_ORDER = ["Opus", "Fable", "Sonnet", "Haiku", "Luna", "Sol", "Terra", "GPT", "Codex", "Pro", "Flash"]


def parse_model_id(mid):
    """(model, version, setting) for a cursor-agent model id, e.g.
    claude-opus-5-5-thinking-high-fast -> ("Opus", "5.5", "High, thinking, fast")."""
    t = mid.split("-")
    if t[0] == "cursor":
        t = t[1:]
    fast, thinking = "fast" in t, "thinking" in t
    t = [x for x in t if x not in ("fast", "thinking")]
    effort = ""
    if len(t) > 2 and "-".join(t[-2:]) == "extra-high":
        effort, t = "extra-high", t[:-2]
    elif len(t) > 1 and t[-1] in EFFORTS:
        effort, t = t[-1], t[:-1]
    head = t[0]
    if head == "claude" and len(t) > 1:  # claude-opus-5-5 or the older claude-4.6-opus
        words = [x for x in t[1:] if not re.fullmatch(r"\d+(\.\d+)?", x)]
        nums = [x for x in t[1:] if re.fullmatch(r"\d+(\.\d+)?", x)]
        model, version = (words[0].capitalize() if words else "Claude"), ".".join(nums)
    elif head == "gpt" and len(t) > 1:
        model, version = (t[2].capitalize() if len(t) > 2 else "GPT"), t[1]
    elif head == "gemini" and len(t) > 1:
        model, version = " ".join(x.capitalize() for x in t[2:]) or "Gemini", t[1]
    elif head == "grok":
        model, version = "Grok", ".".join(t[1:])
    elif head == "kimi":
        model, version = "Kimi", " ".join(x.upper() if x[0] == "k" else x for x in t[1:])
    elif head == "glm":
        model, version = "GLM", ".".join(t[1:])
    else:
        model, version = head.capitalize(), " ".join(t[1:])
    setting = EFFORT_LABEL.get(effort, effort.capitalize()) if effort else "Default"
    setting += ", thinking" if thinking else ""
    setting += ", fast" if fast else ""
    key = (EFFORTS.index(effort) if effort else -1, thinking, fast)
    return model, version or "Default", setting, key


def version_key(v):
    nums = [float(x) for x in re.findall(r"\d+(?:\.\d+)?", v)]
    return [-n for n in nums] or [0]


def model_menu():
    """The Add menu: lab > model > version > setting. [{lab, models: [{model,
    versions: [{version, items: [{spec, label}]}]}]}]. The models Claude Code and
    Codex run directly come first, as the top version of their model."""
    tree = {name: {} for name, _ in LABS + [("Other", "")]}
    for m, n in CLAUDE_MODELS.items():
        tree["Anthropic"].setdefault(n, {})["Latest, via Claude Code"] = [((-2, 0, 0), {"spec": "claude:" + m, "label": "Default"})]
    for m, n in CODEX_MODELS.items():
        model = n.split()[-1]
        tree["OpenAI"].setdefault(model, {})[m.split("-")[1] + ", via Codex"] = [
            ((EFFORTS.index(e), 0, 0), {"spec": f"codex:{m}@{e}", "label": e.capitalize()}) for e in ("low", "medium", "high")]
    for mid in cursor_models():
        lab = next((n for n, pat in LABS if re.match(pat, mid)), "Other")
        model, version, setting, key = parse_model_id(mid)
        tree[lab].setdefault(model, {}).setdefault(version, []).append((key, {"spec": "cursor:" + mid, "label": setting}))
    order = lambda m: (MODEL_ORDER.index(m) if m in MODEL_ORDER else len(MODEL_ORDER), m)
    vorder = lambda v: (0 if "via" in v else 1, version_key(v))
    return [{"lab": lab, "models": [
                {"model": m, "versions": [{"version": v, "items": [i for _, i in sorted(items, key=lambda x: x[0])]}
                                          for v, items in sorted(tree[lab][m].items(), key=lambda kv: vorder(kv[0]))]}
                for m in sorted(tree[lab], key=order)]}
            for lab in tree if tree[lab]]


LAB_ICON = {"Anthropic": "claude", "OpenAI": "openai", "Google": "googlegemini", "xAI": "x", "Meta": "meta",
            "Moonshot": "K", "Z.ai": "Z", "Cursor": "C"}  # an SVG in page/icons, or a letter badge


def lab_icon(m):
    """The icon for a panelist: claude, openai, googlegemini, x, meta, or a letter."""
    try:
        harness, model, _ = PANELISTS[panelist(m)]
    except ValueError:
        return "?"
    if harness == "claude":
        return "claude"
    if harness == "codex":
        return "openai"
    lab = next((n for n, pat in LABS if re.match(pat, model or "")), "Other")
    return LAB_ICON.get(lab, (model or "?")[0].upper())


def page_panel(path):
    """The panel chosen on the page for this file, else the default."""
    f = RUNS_DIR / "page-panels.json"
    chosen = json.loads(f.read_text()).get(str(path)) if f.exists() else None
    return chosen or list(DEFAULT_PANEL)


def edit_block(path, old, new, start=None):
    """Replace one paragraph the user edited on the page. The paragraph must
    still read as it did when the page loaded. Returns an error or None."""
    text = doc_text(path)
    if not old.strip():
        return "nothing to replace"
    if start is not None and text[start:start + len(old)] == old:
        at = start
    elif text.count(old) == 1:
        at = text.index(old)
    else:
        return "this paragraph changed in the file since the page loaded. Reload the page and edit again"
    Path(path).write_text(text[:at] + clean_markup(new.rstrip("\n")) + text[at + len(old):])
    return None


WRITE_ROUTES = ("/api/accept", "/api/fix", "/api/fill", "/api/change", "/api/edit")


def read_only(path):
    """A PDF, or an uploaded copy, cannot be edited from the page: there is no
    source to write to, or the author's file is elsewhere."""
    p = Path(path)
    return is_pdf(p) or (RUNS_DIR / "uploads") in p.resolve().parents


class PageServer:
    def __init__(self, path):
        self.path = Path(path).resolve()
        self.job = None  # the running Re-review, if any
        self.last = time.time()

    def open_file(self, target):
        """Reply for a file chosen to open: its review page if it was reviewed
        before (Re-review there runs a new review), else a background review of it, in place."""
        if target.suffix.lower() not in UPLOAD_TYPES:
            return 400, "application/json", json.dumps({"error": f"choose a {', '.join(UPLOAD_TYPES)} file"})
        reviewed = converted_path(target) if is_pdf(target) or is_docx(target) else target
        if runs_for(reviewed):
            url = page_url(reviewed)
            return 200, "application/json", json.dumps({"page": public_url(url) if url else None, "name": target.name})
        return 200, "application/json", json.dumps({"id": start_review(target), "name": target.name})

    def stamp(self):
        """Changes when the file is saved, by any app, or a new review lands."""
        runs = runs_for(self.path)
        return f"{self.path.stat().st_mtime}|{runs[0].name if runs else ''}"

    def run_folder(self):
        runs = runs_for(self.path)
        if not runs:
            raise LookupError(f"no review of {self.path} yet")
        return runs[0]

    def handle(self, method, route, body):
        self.last = time.time()
        if method == "POST" and route in WRITE_ROUTES and read_only(self.path) and not (
                route == "/api/accept" and body.get("record_only")):
            return 409, "application/json", json.dumps(
                {"error": "this review is read-only: apply changes in the source document"})
        if method == "GET" and route == "/api/state":
            st = page_state(self.path, self.run_folder())
            st["job"] = self.job_state()
            return 200, "application/json", json.dumps(st)
        if method == "GET" and route == "/api/ping":
            return 200, "application/json", json.dumps({"file": str(self.path)})
        if method == "GET" and (m := re.fullmatch(r"/api/export/(review|draft)\.(md|docx|pdf)", route)):
            # Download the review or the edited draft, as Markdown or Word (or a PDF draft as PDF).
            missed = []
            if m[1] == "draft":
                name, mime, data, missed = export_draft(self.path, m[2])
            elif m[2] in ("md", "docx"):
                md, name = review_markdown(self.run_folder()), f"{self.path.stem}-review.{m[2]}"
                mime, data = (MD_MIME, md) if m[2] == "md" else (DOCX_MIME, to_docx(md, "gfm", self.run_folder()))
            else:
                return 400, "application/json", json.dumps({"error": "the review downloads as .md or .docx"})
            return 200, mime, data, {"Content-Disposition": f'attachment; filename="{name}"',
                                     "X-Not-Placed": urllib.parse.quote(json.dumps(missed))}
        if method == "GET" and route == "/api/markdown":
            return 200, "application/json", json.dumps(
                {"name": f"{self.path.stem}-review.md", "markdown": review_markdown(self.run_folder())})
        # Open: pick another file in Finder and review it in place. Its review page opens in a new tab.
        if method == "GET" and route == "/open":
            return 200, "text/html; charset=utf-8", (PAGE_DIR / "open.html").read_text()
        if method == "POST" and route == "/api/open":
            if sys.platform != "darwin":
                return 400, "application/json", json.dumps({"error": "Open needs macOS. Run unified-review FILE in a terminal."})
            # Start in this file's folder, unless it is a copy kept under RUNS_DIR (a converted PDF).
            start = Path.home() if RUNS_DIR in self.path.parents else self.path.parent
            chosen, error = choose_file(start)
            if error:
                return 500, "application/json", json.dumps({"error": f"The Finder dialog failed: {error}"})
            if not chosen:
                return 200, "application/json", json.dumps({"cancelled": True})
            return self.open_file(Path(chosen).resolve())
        if method == "POST" and route.startswith("/api/locate/"):
            name = Path(urllib.parse.unquote(route[len("/api/locate/"):])).name
            found = find_original(name, body)
            if len(found) == 1:
                return self.open_file(found[0])
            msg = (f"Could not find {name} on this Mac (Spotlight searches indexed folders only)." if not found else
                   f"Found {len(found)} identical copies of {name}: " + ", ".join(map(str, found)) + ".")
            return 404, "application/json", json.dumps({"error": msg + " Use Choose in Finder instead."})
        if method == "GET" and route.startswith("/api/job/"):
            st = upload_job(Path(route).name, "opens")
            if st is None:
                return 404, "application/json", json.dumps({"error": "no such review"})
            if st.get("unified") and not st.get("file"):
                st["error"] = "the review finished, but its results are missing"
            elif st.get("file"):
                url = page_url(st["file"])
                st["page"] = public_url(url) if url else None
                if not url:
                    st["error"] = "the review finished, but its page did not start"
            return 200, "application/json", json.dumps(st)
        if method == "POST" and route.startswith("/api/transcribe/"):
            try:
                return 200, "application/json", json.dumps({"text": transcribe(body, Path(route).name)})
            except (ValueError, OSError) as e:
                return 502, "application/json", json.dumps({"error": f"Transcription failed: {e}"})
        if method == "POST" and route in ("/api/accept", "/api/decline", "/api/done"):
            run = self.run_folder()
            st = page_state(self.path, run)
            f = next((f for f in st["findings"] if f["n"] == body.get("n")), None)
            if not f:
                return 404, "application/json", json.dumps({"error": "no such finding"})
            if route == "/api/accept":
                old = body.get("old", f["old"])
                new = body.get("text", f["new"])
                if old is None:
                    return 409, "application/json", json.dumps({"error": f["reason"]})
                err = apply_change(self.path, old, new, f["quote"])
                if err:
                    return 409, "application/json", json.dumps({"error": err})
                with contextlib.redirect_stdout(io.StringIO()):
                    record_decisions(str(f["n"]), "applied", body.get("note", ""), run)
            elif route == "/api/done":  # fixed by hand: record it as applied, write nothing
                with contextlib.redirect_stdout(io.StringIO()):
                    record_decisions(str(f["n"]), "applied", "fixed by hand", run)
            else:
                with contextlib.redirect_stdout(io.StringIO()):
                    record_decisions(str(f["n"]), "ignore", body.get("note", ""), run)
            return 200, "application/json", json.dumps({"ok": True})
        if method == "POST" and route == "/api/fix":  # a mechanical fix from Checks
            if body.get("fix") != "spaces":
                return 400, "application/json", json.dumps({"error": "no such fix"})
            text = doc_text(self.path)
            self.path.write_text(fix_double_spaces(text))
            return 200, "application/json", json.dumps({"ok": True})
        if method == "POST" and route == "/api/fill":
            run = self.run_folder()
            f = next((f for f in page_state(self.path, run)["findings"] if f["n"] == body.get("n")), None)
            if not f or f["reason"] != SLOT:
                return 400, "application/json", json.dumps({"error": "this finding has no blank to fill"})
            fill_slots(self.path, run, f)
            return 200, "application/json", json.dumps({"ok": True})
        if method == "POST" and route == "/api/ask":
            run = self.run_folder()
            f = next((f for f in page_state(self.path, run)["findings"] if f["n"] == body.get("n")), None)
            if not f or not body.get("question", "").strip():
                return 400, "application/json", json.dumps({"error": "no finding or no question"})
            ask_panel(self.path, run, f, body["question"].strip())
            return 200, "application/json", json.dumps({"ok": True})
        if method == "GET" and route == "/api/models":
            return 200, "application/json", json.dumps(model_menu())
        if method == "POST" and route == "/api/panel":
            try:
                chosen = [panelist(m) for m in body.get("panel", [])] or list(DEFAULT_PANEL)
            except ValueError as e:
                return 400, "application/json", json.dumps({"error": str(e)})
            f = RUNS_DIR / "page-panels.json"
            pages = json.loads(f.read_text()) if f.exists() else {}
            pages[str(self.path)] = chosen
            write_atomic(f, json.dumps(pages, indent=1) + "\n")
            return 200, "application/json", json.dumps({"ok": True})
        if method == "POST" and route == "/api/comment":
            if not body.get("text", "").strip():
                return 400, "application/json", json.dumps({"error": "empty comment"})
            comment_panel(self.path, self.run_folder(), body["text"].strip(), body.get("focus"), body.get("passage") or "")
            return 200, "application/json", json.dumps({"ok": True})
        if method == "POST" and route == "/api/change":
            err = apply_change(self.path, body.get("old", ""), body.get("new", ""))
            if err:
                return 409, "application/json", json.dumps({"error": err})
            return 200, "application/json", json.dumps({"ok": True})
        if method == "POST" and route == "/api/edit":
            err = edit_block(self.path, body.get("old", ""), body.get("new", ""), body.get("start"))
            if err:
                return 409, "application/json", json.dumps({"error": err})
            if body.get("review") == "passage" and body.get("new", "").strip():
                review_passage(self.path, self.run_folder(), body["new"].strip())
            elif body.get("review") == "draft":
                return self.handle("POST", "/api/update", {})
            return 200, "application/json", json.dumps({"ok": True})
        if method == "POST" and route == "/api/update":
            if not self.job or self.job.poll() is not None:
                env = {**os.environ, "UNIFIED_REVIEW_NO_PAGE": "1"}
                log_file = open(RUNS_DIR / "page-update.log", "w")
                focus = "\n".join((f'About "{c["passage"]}": ' if c.get("passage") else "") + c["comment"]
                                  for c in load_comments(self.run_folder()) if c.get("focus"))
                self.job = subprocess.Popen([sys.executable, os.path.abspath(__file__), str(self.path),
                                             "-p", ",".join(page_panel(self.path))]
                                            + (["-n", focus] if focus else []),
                                            cwd=str(self.path.parent), env=env, stdin=subprocess.DEVNULL,
                                            stdout=log_file, stderr=log_file)
            return 200, "application/json", json.dumps({"job": self.job_state()})
        if method == "GET" and route in ("/", "/index.html"):
            return 200, "text/html; charset=utf-8", (PAGE_DIR / "review.html").read_text()
        return static(method, route)

    def job_state(self):
        if not self.job:
            return None
        code = self.job.poll()
        return {"running": code is None, "ok": code == 0 if code is not None else None}


def transcribe(audio, ext):
    """Speech to text for the page's mic buttons: ElevenLabs Scribe v2, with the
    key from ELEVENLABS_API_KEY. Returns the transcript."""
    import urllib.error
    import urllib.request
    key = os.environ.get("ELEVENLABS_API_KEY")
    if not key:
        raise ValueError("set ELEVENLABS_API_KEY and restart unified-review to use the mic")
    if not audio:
        raise ValueError("no audio was recorded")
    boundary = "unified-review-" + hashlib.sha1(audio).hexdigest()
    ext = re.sub(r"[^a-z0-9]", "", ext.lower()) or "webm"
    form = (f"--{boundary}\r\nContent-Disposition: form-data; name=\"model_id\"\r\n\r\nscribe_v2\r\n"
            f"--{boundary}\r\nContent-Disposition: form-data; name=\"tag_audio_events\"\r\n\r\nfalse\r\n"
            f"--{boundary}\r\nContent-Disposition: form-data; name=\"file\"; filename=\"speech.{ext}\"\r\n"
            f"Content-Type: application/octet-stream\r\n\r\n").encode() + audio + f"\r\n--{boundary}--\r\n".encode()
    req = urllib.request.Request("https://api.elevenlabs.io/v1/speech-to-text", data=form, method="POST", headers={
        "xi-api-key": key, "Content-Type": f"multipart/form-data; boundary={boundary}"})
    try:
        with urllib.request.urlopen(req, timeout=120) as r:
            return json.loads(r.read()).get("text", "").strip()
    except urllib.error.HTTPError as e:
        detail = e.read().decode(errors="replace")[:300]
        raise ValueError(f"ElevenLabs returned {e.code}: {detail}") from None


def static(method, route):
    """The page fonts and lab icons, else not found."""
    if method == "GET" and route.startswith("/icons/"):
        f = PAGE_DIR / "icons" / Path(route).name
        if f.suffix == ".svg" and f.exists():
            return 200, "image/svg+xml", f.read_text()
    if method == "GET" and route.startswith("/fonts/"):
        f = FONT_DIR / Path(route).name
        if f.suffix == ".woff2" and f.exists():
            return 200, "font/woff2", f.read_bytes()
    return 404, "text/plain", "not found"


UPLOAD = "upload"  # the upload page's key in pages.json, and its --serve argument
UPLOAD_TYPES = (".pdf", ".docx", ".md", ".txt", ".tex")


JOBS = {}  # upload id -> the process reviewing it, for the uploads this server started


def start_upload(name, body):
    """Save an uploaded file under RUNS_DIR/uploads and start reviewing the copy
    in the background. Returns the upload id. Raises ValueError for a file
    that cannot be reviewed."""
    name = Path(name).name
    if Path(name).suffix.lower() not in UPLOAD_TYPES:
        raise ValueError(f"choose a {', '.join(UPLOAD_TYPES)} file")
    if not body:
        raise ValueError("the file is empty")
    uid = time.strftime("%Y-%m-%d-%H%M%S-") + secrets.token_hex(12)
    folder = RUNS_DIR / "uploads" / uid
    doc = folder / "upload" / name  # so the run is named <date>-upload-<file>-v1
    doc.parent.mkdir(parents=True)
    doc.write_bytes(body)
    env = {**os.environ, "UNIFIED_REVIEW_NO_PAGE": "1"}
    with open(folder / "stdout.log", "w") as out, open(folder / "stderr.log", "w") as log_file:
        JOBS[uid] = subprocess.Popen([sys.executable, os.path.abspath(__file__), str(doc)],
                                     cwd=str(folder), env=env, stdin=subprocess.DEVNULL,
                                     stdout=out, stderr=log_file)
    return uid


SEEN = {}  # (job id, stage) -> when the server first saw that stage in the job's log


def job_progress(uid, lines, running):
    """The stages of a background review, read from its log: [{"label", "state"
    (running, done, failed), "secs", "models": [{"name", "state", "note"}]}].
    A stage's start is when the server first saw it, so polls set its clock."""
    stages = []

    def stage(key, label, models=()):
        if stages and stages[-1]["state"] == "running":
            stages[-1]["state"] = "done"
        stages.append({"key": key, "label": label, "state": "running",
                       "models": [{"name": m, "state": "running", "note": ""} for m in models]})
    for line in lines:
        if line.endswith(": converting to Markdown"):
            stage("convert", "Convert to Markdown")
        elif m := re.match(r"([123])/3 (review|vote|render)\b(.*)", line):
            names = [n.strip() for n in m[3].rsplit(":", 1)[-1].split(",")] if m[2] != "render" else []
            stage(m[2], {"review": "Review", "vote": "Vote on each other's findings", "render": "Merge"}[m[2]], names)
        elif stages and (m := re.match(r"\s+(\S+) stands in (?:to vote )?for", line)):
            stages[-1]["models"].append({"name": m[1], "state": "running", "note": "standing in"})
        elif stages and (m := re.match(r"\s+(\S+): (\w+) (done|failed|attempt 1 failed)(.*)", line)):
            for x in stages[-1]["models"]:
                if x["name"] == m[1]:
                    x["state"] = {"done": "done", "failed": "failed"}.get(m[3], "running")
                    note = m[4].strip(" ,")
                    if note.startswith("(") and note.endswith(")"):  # "failed (no reply)"
                        note = note[1:-1]
                    x["note"] = "retrying" if m[3].startswith("attempt") else note
        elif stages and stages[-1]["key"] == "convert" and ("Markdown copy" in line or "conversion failed" in line):
            stages[-1]["state"] = "done"
    if stages and not running:
        stages[-1]["state"] = "done"
    now = time.time()
    for st in stages:
        st["secs"] = round(now - SEEN.setdefault((uid, st["key"]), now))
        if st["state"] == "running":
            continue
        for x in st["models"]:  # a failure is always logged, so a model still open finished
            if x["state"] == "running":
                x["state"] = "done"
    for a, b in zip(stages, stages[1:]):  # a finished stage lasted until the next began
        a["secs"] = max(0, a["secs"] - b["secs"])
    for st in stages:  # or as long as its slowest model, which the log times exactly
        took = [int(t) for x in st["models"] for t in re.findall(r"\((\d+) s\)", x["note"])]
        if st["state"] != "running" and took:
            st["secs"] = max(took)
    return [{k: st[k] for k in ("label", "state", "secs", "models")} for st in stages]


def reviewed_copy(name, body):
    """The Markdown copy an uploaded PDF or Word file was reviewed as before, and
    its runs: (path, runs). (None, []) for a file not seen before. Each upload of
    another kind is a new copy, so it has no history."""
    name = Path(name).name
    if not (is_pdf(name) or is_docx(name)) or not body:
        return None, []
    with tempfile.TemporaryDirectory() as tmp:
        f = Path(tmp) / name
        f.write_bytes(body)
        md = converted_path(f).resolve()  # reviews record resolved paths
    return (md, runs_for(md)) if md.exists() else (None, [])


def upload_job(uid, kind="uploads"):
    """Where a background review stands, for an upload or (kind "opens") a file
    chosen with Open: {"running", "name", "log"}, and when it is done,
    "unified" (path of unified.md) and "file" (the file reviewed), or "error".
    None for an unknown id."""
    folder = RUNS_DIR / kind / Path(uid).name
    if not uid or not folder.is_dir():
        return None
    job = JOBS.get(uid)
    read = lambda f: (folder / f).read_text(errors="replace") if (folder / f).exists() else ""
    names = ([Path(read("file.txt").strip()).name] if kind == "opens"
             else [p.name for p in (folder / "upload").glob("*")])
    lines = read("stderr.log").splitlines()
    running = job is not None and job.poll() is None
    try:  # the id starts with the time the review started
        began = time.mktime(time.strptime(Path(uid).name[:17], "%Y-%m-%d-%H%M%S"))
    except ValueError:
        began = time.time()
    st = {"running": running, "name": names[0] if names else uid, "log": lines[-12:],
          "elapsed": round(time.time() - began), "stages": job_progress(uid, lines, running)}
    if st["running"]:
        return st
    # The review prints the path of unified.md as its last line.
    lines = [l.strip() for l in read("stdout.log").splitlines() if l.strip()]
    unified = Path(lines[-1]) if lines and lines[-1].endswith("unified.md") else None
    if not unified or not unified.exists():
        st["error"] = "the review did not finish" + (" (see the log below)" if st["log"] else "")
        return st
    st["unified"] = str(unified)
    results = unified.parent / "results.json"
    if results.exists():
        st["file"] = json.loads(results.read_text())["files"][0]
    return st


def review_markdown(run):
    """unified.md, with the theme summary after its title when the page has written one.
    It is rebuilt from results.json first, so a review made before a format
    change reads in the current format."""
    if (run / "results.json").exists():
        render(run)
    md = (run / "unified.md").read_text()
    sf = run / "summary.json"
    if not sf.exists():
        return md
    sm = json.loads(sf.read_text())
    # Titles and kinds come from the results, not from the headings. A finding sits
    # under its first theme, and findings in no theme go under "Other". Every
    # finding counts, typos and nitpicks too, as on the review page.
    r = json.loads((run / "results.json").read_text())
    found = {n: g for n, sev, _, g in ordered_findings(r)}
    ns = list(found)
    logic = [n for n in ns if found[n].get("kind") == "logic"]
    typed = not ns or any(found[n].get("kind") for n in ns)
    used, themes = set(logic), []
    for t in sm["themes"]:
        fs = sorted(n for n in t["findings"] if n in found and n not in used)
        used.update(fs)
        if fs:
            themes.append((t["theme"], fs))
    rest = [n for n in ns if n not in used]
    if rest:
        themes.append(("Other", sorted(rest)))
    titles = lambda fs: "".join(f"  - {found[n]['rep']['title']} ({n})\n" for n in fs)
    # The first bullet is always the logic flaws, or that there are none.
    count = lambda fs: f"{len(fs)} finding{'' if len(fs) == 1 else 's'}"
    first = ((f"- **Logical flaws ({count(logic)}):**\n" + titles(logic)) if logic else "- **Logical flaws:** none found.\n"
             ) if typed else "- **Logical flaws:** this review has no type labels.\n"
    block = f"## Summary ({count(ns)})\n\n" + first + "".join(f"- **{name} ({count(fs)}):**\n{titles(fs)}" for name, fs in themes)
    title, _, rest = md.partition("\n")
    return f"{title}\n\n{block}\n{rest.lstrip(chr(10))}"


def find_original(name, body):
    """The files on this Mac named `name` whose bytes are `body`, found with
    Spotlight. A browser gives a dropped file's contents but not its path, so
    this is how a drop reaches the original. Unindexed folders are not searched."""
    if not body or sys.platform != "darwin":
        return []
    quoted = name.replace("\\", "\\\\").replace("'", "\\'")
    r = subprocess.run(["mdfind", f"kMDItemFSName == '{quoted}'"], capture_output=True, text=True, timeout=20)
    digest, out = hashlib.sha256(body).digest(), []
    for line in r.stdout.splitlines():
        p = Path(line)
        try:
            if p.name == name and p.is_file() and p.stat().st_size == len(body) \
                    and hashlib.sha256(p.read_bytes()).digest() == digest:
                out.append(p.resolve())
        except OSError:
            continue
    return sorted(set(out))


def choose_file(start):
    """(path, error) for a file picked in a Finder dialog: (None, None) if
    cancelled. macOS only. The dialog belongs to the frontmost app (the browser
    that asked), since macOS keeps a background process's window behind it."""
    quoted = str(start).replace("\\", "\\\\").replace('"', '\\"')
    choose = f'choose file with prompt "Choose a draft to review" default location (POSIX file "{quoted}")'
    front = ["-e", "set frontApp to path to frontmost application as text",
             "-e", "tell application frontApp", "-e", "activate", "-e", f"set f to {choose}", "-e", "end tell",
             "-e", "POSIX path of f"]
    own = ["-e", "tell me to activate", "-e", f"POSIX path of ({choose})"]
    for script in (front, own):  # the second if macOS denies control of the browser
        r = subprocess.run(["osascript", *script], capture_output=True, text=True)
        if r.returncode == 0:
            return r.stdout.strip() or None, None
        if "-128" in r.stderr:  # the user cancelled
            return None, None
        if "-1743" not in r.stderr and "-10004" not in r.stderr:  # anything but "not allowed to control that app"
            return None, r.stderr.strip()[:200] or "the Finder dialog failed"
    return None, r.stderr.strip()[:200] or "the Finder dialog failed"


def start_review(path):
    """Review a file in place in the background, as `unified-review FILE` does.
    Returns the job id, read with upload_job(id, "opens")."""
    jid = time.strftime("%Y-%m-%d-%H%M%S-") + secrets.token_hex(12)
    folder = RUNS_DIR / "opens" / jid
    folder.mkdir(parents=True)
    (folder / "file.txt").write_text(str(path))
    env = {**os.environ, "UNIFIED_REVIEW_NO_PAGE": "1"}
    with open(folder / "stdout.log", "w") as out, open(folder / "stderr.log", "w") as log_file:
        JOBS[jid] = subprocess.Popen([sys.executable, os.path.abspath(__file__), str(path)],
                                     cwd=str(path.parent), env=env, stdin=subprocess.DEVNULL,
                                     stdout=out, stderr=log_file)
    return jid


class UploadServer:
    """The upload page: send a file, the server reviews a copy of it, and the
    page shows unified.md. Nothing is written back to the original."""
    path = UPLOAD

    def __init__(self):
        self.last = time.time()

    def handle(self, method, route, body):
        self.last = time.time()
        ok = lambda d: (200, "application/json", json.dumps(d))
        err = lambda code, msg: (code, "application/json", json.dumps({"error": msg}))
        if method == "GET" and route == "/api/ping":
            return ok({"file": UPLOAD})
        if method == "POST" and (m := re.fullmatch(r"/api/upload/(?:(check|open|fresh)/)?([^/]+)", route)):
            # check: was this file reviewed before? open: its last review page. fresh: forget
            # its history, then review it. No action: review it, keeping its history.
            name = urllib.parse.unquote(m[2])
            if m[1] in ("check", "open", "fresh"):
                md, runs = reviewed_copy(name, body)
                if m[1] == "check":
                    return ok({"seen": bool(runs), "reviews": len(runs),
                               "last": runs[0].name[:10] if runs else None})
                if m[1] == "open":
                    url = page_url(md) if runs else None
                    return ok({"page": public_url(url)}) if url else err(404, "no earlier review of this file")
                if runs:
                    forget(md)
            try:
                return ok({"id": start_upload(name, body)})
            except ValueError as e:
                return err(400, str(e))
        if method == "GET" and route.startswith("/api/job/"):
            st = upload_job(Path(route).name)
            if st is None:
                return err(404, "no such upload")
            unified = st.pop("unified", None)
            reviewed = st.pop("file", None)
            if unified is None:
                return ok(st)
            st["page"] = page_url(reviewed) if reviewed else None
            st["markdown"] = Path(unified).read_text()
            st["html"] = None
            if shutil.which("pandoc"):
                r = subprocess.run(["pandoc", "-f", "gfm", "-t", "html"], input=st["markdown"],
                                   capture_output=True, text=True)
                st["html"] = r.stdout if r.returncode == 0 else None
            return ok(st)
        if method == "GET" and route in ("/", "/index.html"):
            return 200, "text/html; charset=utf-8", (PAGE_DIR / "upload.html").read_text()
        return static(method, route)


def serve(path):
    """Serve the review page for one file, or the upload page, on a free local
    port, and record the port so later calls reuse this server."""
    import http.server
    page = UploadServer() if path == UPLOAD else PageServer(path)

    class Handler(http.server.BaseHTTPRequestHandler):
        def log_message(self, *a):
            pass

        def reply(self, method):
            n = int(self.headers.get("Content-Length") or 0)
            try:
                raw = self.rfile.read(n) if method == "POST" else b""
                body = raw if self.path.startswith(("/api/upload/", "/api/locate/", "/api/transcribe/")) else json.loads(raw or b"{}")
                code, ctype, data, *extra = page.handle(method, self.path.split("?")[0], body)
            except Exception as e:  # report to the page, keep serving
                code, ctype, data, extra = 500, "application/json", json.dumps({"error": str(e)}), []
            data = data.encode() if isinstance(data, str) else data
            self.send_response(code)
            for k, v in (extra[0] if extra else {}).items():
                self.send_header(k, v)
            self.send_header("Content-Type", ctype)
            self.send_header("Content-Length", str(len(data)))
            self.send_header("Cache-Control", "no-store")
            self.end_headers()
            self.wfile.write(data)

        def events(self):
            """Server-Sent Events: tell the page when the file or its latest review
            changes, so it reloads without polling. The page keeps the server alive."""
            self.send_response(200)
            self.send_header("Content-Type", "text/event-stream")
            self.send_header("Cache-Control", "no-store")
            self.end_headers()
            last, beat = None, 0.0
            try:
                while True:
                    page.last = time.time()
                    try:
                        now = page.stamp()
                    except OSError:  # an editor mid-save can briefly remove the file
                        now = last
                    if now != last:
                        self.wfile.write(f"data: {now}\n\n".encode())
                        self.wfile.flush()
                        last, beat = now, time.time()
                    elif time.time() - beat > 15:  # a comment keeps the connection open
                        self.wfile.write(b": beat\n\n")
                        self.wfile.flush()
                        beat = time.time()
                    time.sleep(0.5)
            except (BrokenPipeError, ConnectionResetError):
                pass

        def do_GET(self):
            if self.path == "/api/events" and hasattr(page, "stamp"):
                return self.events()
            self.reply("GET")

        def do_POST(self):
            self.reply("POST")

    pages = json.loads((RUNS_DIR / "pages.json").read_text()) if (RUNS_DIR / "pages.json").exists() else {}
    # A fixed port keeps one forwarded URL in a codespace. Otherwise reuse this file's
    # last port, so a tab left open works again after a restart. Fall back if it is taken.
    port = int(os.environ.get("UNIFIED_REVIEW_PORT") or (pages.get(str(page.path)) or {}).get("port") or 0)
    try:
        httpd = http.server.ThreadingHTTPServer(("127.0.0.1", port), Handler)
    except OSError:
        httpd = http.server.ThreadingHTTPServer(("127.0.0.1", 0), Handler)
    pages[str(page.path)] = {"port": httpd.server_address[1], "pid": os.getpid()}
    write_atomic(RUNS_DIR / "pages.json", json.dumps(pages, indent=1) + "\n")
    httpd.timeout = 60
    while time.time() - page.last < PAGE_IDLE:
        httpd.handle_request()


def page_url(path):
    """URL of a live page server for this file (or UPLOAD, the upload page),
    starting one if needed. None if it does not come up."""
    import urllib.request
    path = path if path == UPLOAD else Path(path).resolve()
    pf = RUNS_DIR / "pages.json"
    for attempt in range(2):
        pages = json.loads(pf.read_text()) if pf.exists() else {}
        entry = pages.get(str(path))
        if entry:
            url = f"http://127.0.0.1:{entry['port']}/"
            try:
                with urllib.request.urlopen(url + "api/ping", timeout=2) as resp:
                    if json.load(resp).get("file") == str(path):
                        return url
            except (OSError, ValueError):
                pass
        if attempt == 0:
            subprocess.Popen([sys.executable, os.path.abspath(__file__), "--serve", str(path)],
                             stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                             start_new_session=True)
            for _ in range(50):  # up to 5 s for the server to record its port
                time.sleep(0.1)
                if pf.exists() and json.loads(pf.read_text()).get(str(path), {}) != (entry or {}):
                    break
    return None


def public_url(url):
    """The address a browser should use for a local page URL: in a codespace, the
    port's forwarded https address (private to the codespace's owner)."""
    name, domain = os.environ.get("CODESPACE_NAME"), os.environ.get("GITHUB_CODESPACES_PORT_FORWARDING_DOMAIN")
    if not (name and domain):
        return url
    port = url.rstrip("/").rsplit(":", 1)[1]
    return f"https://{name}-{port}.{domain}/"


def open_page(path):
    """Open the review page in the browser. Returns False if it could not start."""
    url = page_url(path)
    if not url:
        return False
    url = public_url(url)
    if sys.platform == "darwin":
        cmd = ["open", url]
    else:  # Codespaces sets $BROWSER to open URLs in the user's own browser
        opener = shlex.split(os.environ.get("BROWSER", "")) or ([shutil.which("xdg-open")] if shutil.which("xdg-open") else [])
        cmd = opener + [url] if opener else None
    if cmd:
        subprocess.run(cmd, stderr=subprocess.DEVNULL, env=CHILD_ENV)
    print(f"Review page: {url}", flush=True)
    return True


# ---------------------------------------------------------------- main

RULES_SECTION = "# Writing and review guidelines"


REVIEW_SKILLS = ["logic", "statistics", "figures", "documents"]  # their rules apply to drafts under review


def with_figure_rules(rules):
    """Reviews also check figures, captions, equations, citations, and tables,
    whose rules live in skills rather than in CLAUDE.md."""
    for name in REVIEW_SKILLS:
        skill = Path(__file__).resolve().parent.parent / "skills" / name / "SKILL.md"
        if skill.exists():
            rules += "\n\n" + re.sub(r"\A---\n.*?\n---\n", "", skill.read_text(), flags=re.S)
    return rules


def reviewer_rules():
    """The '## Reviewer rules' section of this tool's skill: what to flag and the output format."""
    skill = Path(__file__).resolve().parent.parent / "skills" / "unified-review" / "SKILL.md"
    text = skill.read_text() if skill.exists() else ""
    k = text.find("\n## Reviewer rules")
    return text[k:].strip() if k >= 0 else ""


def load_rules(path):
    """Review rules, first found: --rules FILE, $UNIFIED_REVIEW_RULES, the
    '# Writing and review guidelines' section of ~/.claude/CLAUDE.md (or
    $CLAUDE_MD), else that section of the CLAUDE.md shipped with this tool.
    The CLAUDE.md section is followed by the skill's reviewer rules."""
    for p in [path, os.environ.get("UNIFIED_REVIEW_RULES")]:
        if p:
            return Path(p).read_text(), p
    for md in [Path(os.environ.get("CLAUDE_MD", Path.home() / ".claude/CLAUDE.md")),
               Path(__file__).resolve().parent.parent / "CLAUDE.md"]:
        if md.exists():
            text = md.read_text()
            k = text.find(RULES_SECTION)
            if k >= 0:
                return text[k:].rstrip() + "\n\n" + reviewer_rules(), f"{md} ({RULES_SECTION})"
    sys.exit(f"error: no review rules found. Pass --rules FILE, or add a '{RULES_SECTION}' section to CLAUDE.md")


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("files", nargs="*")
    ap.add_argument("-o", dest="outdir")
    ap.add_argument("-n", dest="focus", default="")
    ap.add_argument("--context", action="append", default=[], metavar="FILE",
                    help="supporting material the panel reads but does not review (text or PDF, repeatable)")
    ap.add_argument("-p", dest="panel", default="claude,gpt,gemini")
    ap.add_argument("--verify", action="store_true")
    ap.add_argument("--no-md", action="store_true",
                    help="review a PDF as is, instead of converting it to Markdown first")
    ap.add_argument("--rules", metavar="FILE", help="review rules to give the panel (see README)")
    ap.add_argument("--item", metavar="N[,N,K..]",
                    help="print findings or fact-check claims from a run, to act on them")
    ap.add_argument("--ignore", metavar="N[,N..]", help="record that you declined these findings")
    ap.add_argument("--applied", metavar="N[,N..]", help="record that you applied these findings")
    ap.add_argument("--unignore", metavar="D[,D..]", help="lift past declines (D ids)")
    ap.add_argument("--forget", metavar="FILE",
                    help="set aside a file's earlier reviews, decisions, and versions, so its next review is its first")
    ap.add_argument("--decisions", action="store_true",
                    help="list recorded decisions for files under the current folder")
    ap.add_argument("--note", default="", help="your reason, stored with --ignore or --applied")
    ap.add_argument("--run", metavar="DIR",
                    help="run folder for --item (default: newest run for files in this folder)")
    ap.add_argument("--snapshot", action="store_true",
                    help="save a copy of FILE beside it named by its version (memo-v8.md)")
    ap.add_argument("--changes", metavar="N",
                    help="write and open what changed in FILE since saved version N")
    ap.add_argument("--slides", action="store_true",
                    help="review FILE as a Marp slide deck (automatic when its front matter says marp: true)")
    ap.add_argument("--page", action="store_true",
                    help="open the review page for FILE's newest review (or the newest review here)")
    ap.add_argument("--upload", action="store_true",
                    help="open a page to upload a file (PDF, Markdown, text, TeX) and read its review")
    ap.add_argument("--serve", metavar="FILE", help=argparse.SUPPRESS)
    ap.add_argument("--factcheck-only", action="store_true", help=argparse.SUPPRESS)
    a = ap.parse_args()
    if a.decisions:
        show_decisions(str(Path.cwd().resolve()))
        return
    if a.forget:
        if not Path(a.forget).is_file():
            sys.exit(f"error: no such file: {a.forget}")
        forget(a.forget)
        return
    for flag, kind in (("ignore", "ignore"), ("applied", "applied"), ("unignore", "lifted")):
        if getattr(a, flag):
            record_decisions(getattr(a, flag), kind, a.note,
                             None if kind == "lifted" else (Path(a.run) if a.run else latest_run()))
            return
    if a.item:
        show_items(a.item, Path(a.run) if a.run else latest_run())
        return
    if a.serve:
        serve(a.serve)
        return
    if a.upload:
        if not open_page(UPLOAD):
            sys.exit("error: the upload page did not start")
        return
    if a.page:
        target = Path(a.files[0]).resolve() if a.files else Path(json.loads(
            (latest_run() / "results.json").read_text())["files"][0])
        if not open_page(target):
            sys.exit("error: the review page did not start")
        return
    if a.snapshot or a.changes:
        if len(a.files) != 1:
            ap.error("--snapshot and --changes take one FILE")
        out = snapshot(a.files[0]) if a.snapshot else write_changes(a.files[0], a.changes)
        print(out)
        if a.changes:
            open_file(out)
        return
    if not a.files:
        ap.error("give at least one FILE to review")

    panel = [m.strip() for m in a.panel.split(",") if m.strip()]
    try:
        panel = [panelist(m) for m in panel]
    except ValueError as e:
        sys.exit(f"error: {e}")
    bad = [m for m in panel if m not in PANELISTS]
    if bad:
        sys.exit(f"error: unknown panelist(s) {bad}; known: {', '.join(PANELISTS)}")
    for m in [m for m in panel if not available(m)]:
        fail("preflight", m, f"{PANELISTS[m][0]} command not found. Set {PANELISTS[m][0].upper()}_BIN to its path")
    panel = [m for m in panel if available(m)]
    if not panel:
        sys.exit("error: no panelist CLIs found")
    if not a.factcheck_only:
        wanted = len(panel)
        panel = preflight(panel)
        if len(panel) < wanted and STANDIN not in panel and available(STANDIN) and preflight([STANDIN]):
            log(f"{STANDIN} stands in for the panelist that is not available")
            panel.append(STANDIN)
        if not panel:
            sys.exit("error: no panelist is logged in")

    files = []
    for f in a.files:
        p = Path(f).resolve()
        if not p.is_file():
            sys.exit(f"error: no such file: {f}")
        files.append(p)
    workdir = files[0].parent
    # A PDF is converted to Markdown and the Markdown is reviewed, so findings
    # cite lines and the review page can apply them. A Word file always is.
    files = [to_markdown(p) if is_docx(p) else p for p in files]
    if not a.no_md and not a.factcheck_only:
        files = [(to_markdown(p) or p) if is_pdf(p) else p for p in files]
    texts = [doc_text(p) for p in files]  # read once: this is the version reviewed
    draft = "\n\n".join(f"===== {p.name} =====\n{t}" for p, t in zip(files, texts))
    # A PDF goes to the panel as its text, unless the text would miss images or
    # equations. Then the panel opens the PDF itself.
    direct = {p for p in files if is_pdf(p) and pdf_extras(p)}
    shown = "\n\n".join(f"===== {p.name} =====\n" + (PDF_NOTE.format(path=p) if p in direct else t)
                        for p, t in zip(files, texts))
    global READ_FILES
    READ_FILES = bool(direct)
    for p in direct:
        log(f"{p.name}: has {' and '.join(pdf_extras(p))}, so the panel reads the PDF itself")
    numbers = [None] * len(files)
    if a.outdir:
        outdir = Path(a.outdir).resolve()
    else:
        # Name runs <date>-<time>-<project>-<file>-v<N>, with -run2, -run3 within the same minute.
        numbers = [version_number(p, fingerprint(t)) for p, t in zip(files, texts)]
        # A date-time prefix sorts runs by when they were made.
        base = RUNS_DIR / f"{time.strftime('%Y-%m-%d-%H%M')}-{project_name(workdir)}-{files[0].stem}-v{numbers[0]}"
        outdir, k = base, 1
        while outdir.exists():
            k += 1
            outdir = base.with_name(f"{base.name}-run{k}")
    outdir.mkdir(parents=True, exist_ok=True)

    if a.factcheck_only:
        PANELISTS.update(FACTCHECK_PANELISTS)
        background(files, draft, panel, outdir, workdir, shown)
        return

    rules, source = load_rules(a.rules)
    rules = with_figure_rules(rules)
    global DECK
    DECK = a.slides or (len(files) == 1 and is_deck(files[0], texts[0]))
    if DECK:
        log("reviewing as a slide deck, with the slides skill's rules")
        rules += "\n\n" + re.sub(r"\A---\n.*?\n---\n", "", (Path(__file__).resolve().parent.parent / "skills" / "slides" / "SKILL.md").read_text(), flags=re.S)
    log(f"review rules: {source}")
    log(f"output -> {outdir}")

    if a.verify:
        # Start the fact-check first, detached, so it outlives this process.
        with open(outdir / "factcheck.log", "w") as fl:
            subprocess.Popen([sys.executable, os.path.abspath(__file__), "--factcheck-only",
                              "-p", ",".join(panel), "-o", str(outdir)] + [str(p) for p in files],
                             stdin=subprocess.DEVNULL, stdout=fl, stderr=fl, start_new_session=True)
        log("fact-check started in the background")

    t = time.time()
    versions = [file_version(p, t, outdir, n) for p, t, n in zip(files, texts, numbers)]
    context = load_context(a.context) if a.context else None
    unified = foreground(files, draft, panel, a.focus, rules, outdir, workdir, a.verify, versions, context, shown)
    log(f"review done in {round(time.time() - t)} s." + (
        " Fact-check still running; factcheck.md opens when it finishes." if a.verify else ""))
    # One Markdown file opens its review page; a PDF, several files, or an
    # Re-review from the page itself keep to unified.md.
    page = (len(files) == 1 and not os.environ.get("UNIFIED_REVIEW_NO_PAGE")
            and open_page(files[0]))
    if not page and not os.environ.get("UNIFIED_REVIEW_NO_PAGE"):
        open_file(unified)
    print(unified)


if __name__ == "__main__":
    main()
